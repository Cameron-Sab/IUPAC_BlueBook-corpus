  "units": [
    {
      "id": "acyclic_heterone_definition",
      "k": "definition",
      "f": "definition",
      "c": [1],
      "term": "acyclic heterone",
      "entity": "AcyclicHeterone",
      "value": ["lit", {"structure": "oxygen atom doubly bonded to a heteroatom", "cyclic": false}]
    },
    {
      "id": "acyclic_heterone_naming_methods",
      "k": "mapping",
      "f": "required",
      "c": [2, 3, 4, 5],
      "table": "acyclic_heterone_methods"
    },
    {
      "id": "heterone_carbonyl_distinction",
      "k": "constraint",
      "f": "required",
      "c": [6],
      "in": [["compound", "Heterone"]],
      "assert": ["cmp", "eq", ["get", ["var", "compound"], "use_ketone_aldehyde_distinction"], false],
      "violation": [["reject", "name", "heterone.ketone_aldehyde_distinction_not_retained"]]
    },
    {
      "id": "chalcogen_compound_naming_redirect",
      "k": "rule",
      "f": "required",
      "c": [7],
      "in": [["compound", "Heterone"]],
      "out": [["governing_rule", "RuleReference"]],
      "if": ["any",
        ["cmp", "eq", ["get", ["var", "compound"], "class"], "sulfone"],
        ["cmp", "eq", ["get", ["var", "compound"], "class"], "sulfoxide"],
        ["cmp", "eq", ["get", ["var", "compound"], "class"], "related chalcogen compound"]
      ],
      "then": [["set", "governing_rule", "P-63.6"]],
      "else": []
    },
    {
      "id": "thioketone_oxide_naming_methods",
      "k": "mapping",
      "f": "required",
      "c": [16, 17, 18, 19, 20],
      "table": "thioketone_oxide_methods"
    },
    {
      "id": "cyclic_sulfur_oxide_naming",
      "k": "procedure",
      "f": "required",
      "c": [23, 24],
      "in": [["ring_system", "SulfurContainingRingSystem"]],
      "out": [["name", "name"]],
      "steps": [
        ["set", "name", ["lit", {"basis": "heterocycle", "oxygen_expression": "suffix -one", "sulfur_lambda_states": [4, 6], "preferred_over": ["functional class oxide", "nonstandard-bonding chalcogen parent"]}]]
      ]
    },
    {
      "id": "carbonyl_prefix_selection",
      "k": "mapping",
      "f": "required",
      "c": [31, 34, 35, 36, 37, 38, 39, 40],
      "table": "carbonyl_prefix_forms"
    },
    {
      "id": "acetonyl_general_retention",
      "k": "rule",
      "f": "permitted",
      "c": [32, 33],
      "scope": {"r": ["general_nomenclature"], "if": ["lit", true]},
      "out": [["retained_name_policy", "NamePolicy"]],
      "if": ["lit", true],
      "then": [["set", "retained_name_policy", ["lit", {"acetonyl": "retained", "acetonylidene": "not recommended", "acetonylidyne": "not recommended"}]]],
      "else": []
    },
    {
      "id": "ketone_nonsuffix_carbonyl_expression",
      "k": "rule",
      "f": "required",
      "c": [42, 43, 44, 45],
      "in": [["compound", "Ketone"]],
      "out": [["prefix_method", "CarbonylPrefixMethod"]],
      "if": ["any",
        ["cmp", "eq", ["get", ["var", "compound"], "all_carbonyl_groups_expressible_as_suffixes"], false],
        ["cmp", "eq", ["get", ["var", "compound"], "has_higher_priority_suffix_group"], true]
      ],
      "then": [["set", "prefix_method", ["lit", ["oxo", "appropriate acyl prefix"]]]],
      "else": []
    },
    {
      "id": "cyclic_pseudoketone_nonsuffix_carbonyl_expression",
      "k": "rule",
      "f": "required",
      "c": [60, 61, 62, 63],
      "in": [["compound", "CyclicPseudoketone"]],
      "out": [["prefix_method", "CarbonylPrefixMethod"]],
      "if": ["any",
        ["cmp", "eq", ["get", ["var", "compound"], "all_carbonyl_groups_expressible_as_suffixes"], false],
        ["cmp", "eq", ["get", ["var", "compound"], "has_higher_priority_suffix_group"], true]
      ],
      "then": [["set", "prefix_method", ["lit", ["oxo", "appropriate acyl prefix"]]]],
      "else": []
    },
    {
      "id": "hidden_amide_naming",
      "k": "rule",
      "f": "preference",
      "c": [64, 65, 66],
      "in": [["compound", "CyclicPseudoketone"]],
      "out": [["preferred_method", "NamingMethod"], ["general_method", "NamingMethod"]],
      "if": ["all",
        ["cmp", "eq", ["get", ["var", "compound"], "structure"], "R-CO-N<"],
        ["cmp", "eq", ["get", ["var", "compound"], "nitrogen_part_of_ring_system"], true]
      ],
      "then": [
        ["set", "general_method", "acyl prefix hidden-amide naming"],
        ["set", "preferred_method", "systematic P-64.2.2 naming"]
      ],
      "else": []
    },
    {
      "id": "acyclic_pseudoketone_naming",
      "k": "rule",
      "f": "required",
      "c": [78, 79],
      "in": [["compound", "AcyclicPseudoketone"]],
      "out": [["methods", "NamingMethodSet"]],
      "if": ["lit", true],
      "then": [["set", "methods", ["lit", {"systematic": "same rules as cyclic pseudoketones", "traditional": "acyl-group naming"}]]],
      "else": []
    },
    {
      "id": "chalcogen_analogue_affixes",
      "k": "mapping",
      "f": "required",
      "c": [85, 86, 87, 88],
      "table": "chalcogen_analogue_affixes"
    },
    {
      "id": "chalcogen_acyl_prefix_construction",
      "k": "procedure",
      "f": "required",
      "c": [89, 90, 91],
      "in": [["acyl_group", "AcylGroup"], ["replacement_chalcogen", "Chalcogen"]],
      "out": [["prefix", "prefix"]],
      "steps": [
        ["set", "prefix", ["lit", {"method": "functional replacement of O by S, Se, or Te using infixes", "retained_name_thio_seleno_prefixes": "not recommended", "preferred_names": "systematically constructed"}]]
      ]
    },
    {
      "id": "chalcogen_oxo_prefix_policy",
      "k": "mapping",
      "f": "required",
      "c": [92, 93],
      "table": "chalcogen_oxo_prefix_policy"
    },
    {
      "id": "ketonic_suffix_seniority",
      "k": "decision",
      "f": "required",
      "c": [120, 121],
      "in": [["suffix_candidates", "KetonicSuffixCandidateSet"]],
      "out": [["senior_suffix", "KetonicSuffix"]],
      "candidates": ["var", "suffix_candidates"],
      "stages": [
        {"id": "chalcogen_order", "c": [120], "key": ["get", ["var", "suffix_candidates"], "chalcogen_seniority_key"], "cmp": ["lexicographic", "maximum", null, null]},
        {"id": "lowest_locant", "c": [121], "key": ["get", ["var", "suffix_candidates"], "locant"], "cmp": ["numeric", "minimum", null, null]}
      ],
      "tie": ["reject_ambiguous", null]
    },
    {
      "id": "carbonyl_class_seniority",
      "k": "definition",
      "f": "definition",
      "c": [130],
      "term": "seniority of ketones, pseudoketones, heterones, and chalcogen analogues",
      "entity": "CharacteristicGroupClassSeniority",
      "value": ["lit", {"senior_classes": ["ketone", "pseudoketone", "heterone", "chalcogen analogue"], "internal_order": ["=O", "=S", "=Se", "=Te"], "junior_classes": ["hydroxy compound", "chalcogen analogue of hydroxy compound", "amine", "imine"]}]
    },
    {
      "id": "junior_carbonyl_group_prefix_expression",
      "k": "rule",
      "f": "required",
      "c": [131],
      "in": [["compound", "Compound"]],
      "out": [["expression_mode", "CharacteristicGroupExpressionMode"]],
      "if": ["cmp", "eq", ["get", ["var", "compound"], "has_higher_priority_suffix_group"], true],
      "then": [["set", "expression_mode", "prefix"]],
      "else": []
    },
    {
      "id": "ketone_pseudoketone_parent_selection",
      "k": "decision",
      "f": "required",
      "c": [153, 154],
      "in": [["parent_candidates", "ParentCandidateSet"]],
      "out": [["selected_parent", "ParentStructure"]],
      "candidates": ["var", "parent_candidates"],
      "stages": [
        {"id": "maximum_carbonyl_count", "c": [154], "key": ["get", ["var", "parent_candidates"], "carbonyl_or_doubly_bonded_oxygen_count"], "cmp": ["numeric", "maximum", null, null]},
        {"id": "chain_ring_seniority", "c": [154], "key": ["get", ["var", "parent_candidates"], "chain_ring_seniority_key"], "cmp": ["lexicographic", "maximum", null, null]},
        {"id": "ring_system_seniority", "c": [154], "key": ["get", ["var", "parent_candidates"], "ring_system_seniority_key"], "cmp": ["lexicographic", "maximum", null, null]}
      ],
      "tie": ["reject_ambiguous", null]
    },
    {
      "id": "chalcogen_replacement_suffix_seniority",
      "k": "definition",
      "f": "definition",
      "c": [161],
      "term": "suffix seniority after chalcogen replacement of ketone, pseudoketone, or heterone oxygen",
      "entity": "ChalcogenSuffixSeniorityOrder",
      "value": ["lit", {"order": ["O", "S", "Se", "Te"], "notation": "O > S > Se > Te"}]
    },
    {
      "id": "acyloin_naming",
      "k": "definition",
      "f": "definition",
      "c": [166],
      "term": "acyloin",
      "entity": "AlphaHydroxyKetoneClass",
      "value": ["lit", {"structure": "RCH(OH)-CO-R", "R": ["alkyl", "aryl", "heterocyclic group"], "naming": "substitutive nomenclature as substituted ketones", "seniority": ["ketone", "hydroxy compound"]}]
    },
    {
      "id": "oin_name_recommendation",
      "k": "constraint",
      "f": "required",
      "c": [167],
      "in": [["name", "name"]],
      "assert": ["cmp", "eq", ["get", ["var", "name"], "ends_with_oin"], false],
      "violation": [["reject", "name", "acyloin.oin_ending_not_recommended"]]
    }
  ],
  "exceptions": [
    {
      "id": "sulfone_sulfoxide_chalcogen_exception",
      "c": [7],
      "if": ["lit", {"class_in": ["sulfone", "sulfoxide", "related chalcogen compound"]}],
      "target": ["semantic_unit", "acyclic_heterone_naming_methods"],
      "mode": "replace",
      "replacement": ["semantic_unit", "chalcogen_compound_naming_redirect"],
      "order": 7,
      "specificity": 1
    }
  ],
