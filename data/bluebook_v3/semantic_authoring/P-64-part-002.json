    {"id": "acyclic_heterone_examples", "c": [9, 10, 11, 12, 13], "input": {"classes": ["phosphorus heterone", "silicon heterone", "disulfane tetrone"]}, "ok": ["phosphanone", "phosphane oxide", "phosphine oxide", "dimethylsilanone", "triphenyl-lambda5-phosphanone", "triphenylphosphane oxide", "triphenylphosphine oxide", "1-methyl-2-phenyl-1lambda6,2lambda6-disulfane-1,1,2,2-tetrone", "methyl phenyl disulfone"], "shows": [["semantic_unit", "acyclic_heterone_naming_methods"]]},
    {"id": "thioketone_oxide_examples", "c": [22, 26, 28], "input": {"classes": ["acyclic thioketone oxide", "cyclic sulfur oxide"]}, "ok": ["propylidene-lambda4-sulfanone", "propanethial oxide", "1-(oxosulfanylidene)propane", "1H-1lambda4-thiophen-1-one", "thiophene oxide", "1-oxo-1H-1lambda4-thiophene", "5H-lambda6-thianthrene-5,5-dione", "thianthrene 5,5-dioxide", "5,5-dioxo-5H-5lambda6-thianthrene"], "shows": [["semantic_unit", "thioketone_oxide_naming_methods"], ["semantic_unit", "cyclic_sulfur_oxide_naming"]]},
