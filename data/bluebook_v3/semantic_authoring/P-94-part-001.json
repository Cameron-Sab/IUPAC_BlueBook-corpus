  "symbols": [
    {
      "id": "system.is_conjugated_double_bond_pair",
      "k": "predicate",
      "d": "Whether a molecular system consists of two conjugated double bonds about the intervening single bond.",
      "a": [["system", "MolecularSystem"]],
      "ret": "Boolean"
    }
  ],
  "units": [
    {
      "id": "conformation_terminology_source",
      "k": "definition",
      "f": "definition",
      "c": [2],
      "term": "source basis for conformation terminology",
      "entity": "PublicationBasis",
      "value": ["lit", {"publication": "Basic Terminology of Stereochemistry", "bibliographic_reference": 37, "scope": "P-94"}]
    },
    {
      "id": "conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [4],
      "in": [["arrangement", "SpatialAtomicArrangement"]],
      "out": [["is_conformation", "Boolean"]],
      "term": "conformation",
      "entity": "SpatialAtomicArrangement",
      "value": ["lit", {"distinguishes": "stereoisomers", "interconversion": "rotation about formally single bonds"}]
    },
    {
      "id": "torsion_angle_definition",
      "k": "definition",
      "f": "definition",
      "c": [24, 25],
      "in": [["assembly", "AttachedAtomAssembly"]],
      "out": [["torsion_angle", "SignedAngle"]],
      "term": "torsion angle",
      "entity": "SignedAngle",
      "value": ["lit", {"basic_assembly": "X-A-B-Y", "view_axis": "A-B", "angle": "smaller projected angle between X-A and Y-B", "symbol": "theta", "positive_rotation": "right or clockwise", "negative_rotation": "left or anticlockwise", "bond_multiplicity_relevant": false, "extended_axis": "a collinear set of more than two directly attached atoms is permitted"}]
    },
    {
      "id": "torsion_descriptor_assignment",
      "k": "mapping",
      "f": "required",
      "c": [26, 27, 28, 29, 30, 31, 32],
      "in": [["torsion_angle", "SignedAngle"]],
      "out": [["descriptor", "ConformationDescriptor"]],
      "table": "torsion_angle_descriptor_ranges"
    },
    {
      "id": "torsion_descriptor_reference_atom_selection",
      "k": "decision",
      "f": "preference",
      "c": [34, 35, 36, 37],
      "in": [["attached_sets", "SubstituentSetPair"]],
      "out": [["selected_pair", "ReferenceAtomOrGroupPair"]],
      "candidates": ["var", "attached_sets"],
      "stages": [
        {"id": "all_different_sequence_priority", "c": [35], "if": ["lit", {"all_members_different": true}], "key": ["lit", "highest CIP sequence-rule priority in each set"], "cmp": ["lexicographic", "maximum", null, null]},
        {"id": "unique_member", "c": [36], "if": ["lit", {"one_member_unique": true}], "key": ["lit", "the unique member"], "cmp": ["lexicographic", "maximum", null, null]},
        {"id": "identical_members_smallest_angle", "c": [37], "if": ["lit", {"all_members_identical": true}], "key": ["lit", "smallest torsion angle"], "cmp": ["numeric", "minimum", null, null]}
      ],
      "tie": ["retain_coequal", null]
    },
    {
      "id": "trigonal_center_torsion_analysis",
      "k": "procedure",
      "f": "required",
      "c": [67, 68, 69],
      "in": [["assembly", "TrigonalCenterAssembly"], ["attached_sets", "SubstituentSetPair"]],
      "out": [["descriptor", "ConformationDescriptor"]],
      "steps": [
        ["emit", ["lit", {"lone_pair_treatment": "phantom atom represented by two dots", "double_bond_treatment": "duplicate atoms determine precedence", "sequence_rule_dependency": "P-91"}]],
        ["invoke", "P-94.2.1", {"attached_sets": ["var", "attached_sets"]}]
      ]
    },
    {
      "id": "specific_conformer_descriptor_scope",
      "k": "definition",
      "f": "definition",
      "c": [90],
      "term": "scope of specific conformer stereodescriptors",
      "entity": "ConformerDescriptorScope",
      "value": ["lit", {"applies_to": ["aliphatic conformers", "alicyclic conformers"]}]
    },
    {
      "id": "eclipsed_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [92],
      "term": "eclipsed",
      "entity": "AdjacentAttachedAtomPairConformation",
      "value": ["lit", {"torsion_angle_degrees": 0}]
    },
    {
      "id": "staggered_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [93],
      "term": "staggered",
      "entity": "AdjacentAttachedAtomPairConformation",
      "value": ["lit", {"relation": "as far apart as possible from an eclipsed conformation"}]
    },
    {
      "id": "preferred_general_conformation_terms",
      "k": "procedure",
      "f": "preference",
      "c": [94, 95],
      "in": [["conformation", "Conformation"]],
      "out": [["descriptor", "PreferredConformationDescriptor"]],
      "steps": [["emit", ["lit", {"preferred": {"gauche_or_skew": "synclinal", "trans_or_anti": "anticlinal", "cis_or_syn": "synclinal"}, "not_recommended": ["trans for anticlinal", "anti for anticlinal", "cis for synclinal", "syn for synclinal"]}]]]
    },
    {
      "id": "eclipsed_staggered_identical_ligand_scope",
      "k": "definition",
      "f": "definition",
      "c": [96],
      "term": "scope of eclipsed and staggered stereodescriptors",
      "entity": "ConformationDescriptorScope",
      "value": ["lit", {"condition": "all ligands are identical", "descriptors": ["eclipsed", "staggered"]}]
    },
    {
      "id": "bisecting_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [104],
      "term": "bisecting conformation",
      "entity": "R3CCYXConformation",
      "value": ["lit", {"grouping": "R3C-C(Y)=X", "torsion_relation": "X antiperiplanar to one R group", "newman_projection": "double bond bisects one R-C-R angle", "r_groups": "identical or different"}]
    },
    {
      "id": "eclipsing_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [105],
      "term": "eclipsing conformation",
      "entity": "R3CCYXConformation",
      "value": ["lit", {"grouping": "R3C-C(Y)=X", "torsion_relation": "X synperiplanar to one R group"}]
    },
    {
      "id": "s_cis_s_trans_assignment",
      "k": "definition",
      "f": "definition",
      "c": [112],
      "term": "s-cis and s-trans descriptors",
      "entity": "ConjugatedDoubleBondConformationDescriptor",
      "value": ["lit", {"system": "two conjugated double bonds about the intervening single bond", "synperiplanar": "s-cis", "antiperiplanar": "s-trans"}]
    },
    {
      "id": "s_descriptor_scope_constraint",
      "k": "constraint",
      "f": "required",
      "c": [113],
      "in": [["system", "MolecularSystem"]],
      "out": [["valid", "Boolean"]],
      "assert": ["pred", "system.is_conjugated_double_bond_pair", ["var", "system"]],
      "violation": [["reject", "system", "reason.s_descriptor_outside_conjugated_double_bonds"]]
    },
    {
      "id": "envelope_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [123],
      "term": "envelope conformation",
      "entity": "FiveMemberedRingConformation",
      "value": ["lit", {"coplanar_atoms": 4, "out_of_plane_atoms": 1}]
    },
    {
      "id": "chair_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [127],
      "term": "chair form",
      "entity": "SixMemberedRingConformation",
      "value": ["lit", {"coplanar_atoms": [1, 2, 4, 5], "atoms_3_and_6": "opposite sides of the plane"}]
    },
    {
      "id": "boat_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [128],
      "term": "boat form",
      "entity": "SixMemberedRingConformation",
      "value": ["lit", {"coplanar_atoms": [1, 2, 4, 5], "atoms_3_and_6": "same side of the plane"}]
    },
    {
      "id": "twist_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [129],
      "term": "twist form",
      "entity": "SixMemberedRingConformation",
      "value": ["lit", {"role": "conformation passed through during interconversion of two boat forms"}]
    },
    {
      "id": "twist_term_preference",
      "k": "procedure",
      "f": "preference",
      "c": [130],
      "in": [["conformation", "SixMemberedRingTwistConformation"]],
      "out": [["term", "PreferredConformationTerm"]],
      "steps": [["emit", ["lit", {"preferred": "twist form", "over": ["skew boat", "skew form", "stretched form"]}]]]
    },
    {
      "id": "carbohydrate_twist_usage",
      "k": "definition",
      "f": "definition",
      "c": [134],
      "term": "twist and skew in carbohydrate stereochemistry",
      "entity": "CarbohydrateRingConformationTerminology",
      "value": ["lit", {"twist": "five-membered ring", "twist_conformation_term": "skew"}]
    },
