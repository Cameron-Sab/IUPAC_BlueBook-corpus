      "k": "definition",
      "f": "definition",
      "c": [136],
      "term": "half-chair conformation",
      "entity": "MonounsaturatedSixMemberedRingConformation",
      "value": ["lit", {"condition": "atoms not directly linked to the double bond lie on opposite sides of the plane"}]
    },
    {
      "id": "crown_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [139],
      "term": "crown conformation",
      "entity": "SaturatedEvenMemberedRingConformation",
      "value": ["lit", {"minimum_ring_atoms": 8, "ring_atom_parity": "even", "planes": "atoms alternate between two parallel planes", "symmetry": {"cyclooctane": "D4d", "cyclodecane": "D5d"}}]
    },
    {
      "id": "tub_conformation_definition",
      "k": "definition",
      "f": "definition",
      "c": [147],
      "term": "tub conformation",
      "entity": "EightMemberedRingConformation",
      "value": ["lit", {"coplanar_feature": "four atoms forming one pair of diametrically opposite ring bonds", "other_ring_atoms": "all on one side of that plane"}]
    },
    {
      "id": "in_out_isomerism_definition",
      "k": "definition",
      "f": "definition",
      "c": [150],
      "term": "in-out isomerism",
      "entity": "BicyclicSystemIsomerism",
      "value": ["lit", {"condition": "bridges are long enough", "variable_orientation": "bridgehead exocyclic bond or lone pair points inside or outside the structure"}]
    }
