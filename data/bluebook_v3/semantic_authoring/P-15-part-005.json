  "symbols": [
    {"id":"skeletal_replacement.order_prefixes","k":"function","d":"Order skeletal replacement prefixes by the seniority specified in P-15.4.1.2.","a":[["heteroatoms","HeteroatomCollection"]],"ret":"ReplacementPrefixSequence"},
    {"id":"heterochain.has_permitted_terminal_atom","k":"predicate","d":"Whether each end of a heteroacyclic chain is carbon or P, As, Sb, Bi, Si, Ge, Sn, Pb, B, Al, Ga, In, or Tl.","a":[["chain","AcyclicChain"]],"ret":"boolean"},
    {"id":"heterochain.locant_set","k":"function","d":"Return the ordered locant set assigned to all skeletal heteroatoms in a chain.","a":[["chain","HeteroacyclicParentHydride"],["direction","NumberingDirection"]],"ret":"LocantSequence"},
    {"id":"locants.lexicographically_lower","k":"predicate","d":"Whether one locant sequence is lower than another at the first point of difference.","a":[["left","LocantSequence"],["right","LocantSequence"]],"ret":"boolean"},
    {"id":"heteroatom.seniority_key","k":"function","d":"Return the P-15.4.1.2 seniority key for a skeletal heteroatom.","a":[["heteroatom","Heteroatom"]],"ret":"SeniorityKey"},
    {"id":"heterochain.assign_fixed_numbering","k":"function","d":"Assign and retain the selected numbering of a heteroacyclic parent hydride for all later suffixes, endings, and prefixes.","a":[["chain","AcyclicChain"]],"ret":"HeteroacyclicParentHydride"},
    {"id":"heterochain.assign_feature_locant","k":"function","d":"Assign a locant to a named feature under the fixed heterochain numbering.","a":[["parent","HeteroacyclicParentHydride"],["feature","StructuralFeature"]],"ret":"Locant"},
    {"id":"heteroatom.bonding_number","k":"function","d":"Return the bonding number of a skeletal heteroatom.","a":[["heteroatom","Heteroatom"]],"ret":"integer"},
    {"id":"lambda_convention.render","k":"function","d":"Render a nonstandard neutral skeletal heteroatom as locant followed by lambda and its bonding number.","a":[["heteroatom","Heteroatom"],["locant","Locant"]],"ret":"NameToken"},
    {"id":"functional_replacement.apply_affix","k":"function","d":"Replace an oxygen atom or hydroxy group by the atom or group selected through a functional-replacement prefix or infix.","a":[["source","NomenclatureObject"],["affix","FunctionalReplacementAffix"]],"ret":"NomenclatureObject"},
    {"id":"functional_replacement.affixes","k":"function","d":"Return all functional-replacement affixes required by a structure.","a":[["structure","MolecularStructure"]],"ret":"FunctionalReplacementAffixCollection"},
    {"id":"affixes.alphabetical_order","k":"function","d":"Order unlike functional-replacement prefixes or infixes alphabetically.","a":[["affixes","FunctionalReplacementAffixCollection"]],"ret":"FunctionalReplacementAffixSequence"},
    {"id":"structure.is_supported_functional_replacement_target","k":"predicate","d":"Whether a structure belongs to a functional-replacement class authorized by P-15.5.3.","a":[["structure","MolecularStructure"]],"ret":"boolean"},
    {"id":"structure.is_class","k":"predicate","d":"Whether a molecular structure belongs to a specified functional class.","a":[["structure","MolecularStructure"],["class","StructureClass"]],"ret":"boolean"},
    {"id":"structure.has_principal_group_on_acyclic_component","k":"predicate","d":"Whether the principal characteristic group is attached to an acyclic component.","a":[["structure","MolecularStructure"]],"ret":"boolean"},
    {"id":"structure.acyclic_component_directly_cc_bonded_to_cyclic_component","k":"predicate","d":"Whether the relevant acyclic component is directly attached to a cyclic component by a carbon-carbon bond.","a":[["structure","MolecularStructure"]],"ret":"boolean"},
    {"id":"conjunctive.operation","k":"function","d":"Join components at sites formed by removing the same number of hydrogen atoms from each component.","a":[["components","ComponentCollection"],["sites","JoinSiteCollection"]],"ret":"MolecularStructure"}
  ],
  "units": [
    {"id":"acyclic_skeletal_replacement_name_formation","k":"procedure","f":"required","c":[2,3,4,5],"in":[["chain","AcyclicChain"],["heteroatoms","HeteroatomCollection"]],"out":[["parent_name","Name"]],"steps":[["assert",["pred","heterochain.has_permitted_terminal_atom",["var","chain"]],"invalid_heterochain_terminal_atom"],["set","ordered_prefixes",["call","skeletal_replacement.order_prefixes",["var","heteroatoms"]]],["render","parent_name","before_parent_hydride",["var","ordered_prefixes"]],["emit",{"identical_heteroatoms":"use_di_tri_tetra_etc","positions":"cite_locants","terminal_atoms":["C","P","As","Sb","Bi","Si","Ge","Sn","Pb","B","Al","Ga","In","Tl"]}]]},
