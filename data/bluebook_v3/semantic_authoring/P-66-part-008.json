    {"id":"polyfunctional_aldehyde_prefix_expression","k":"rule","f":"required","c":[2],"scope":{"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},"in":[["compound","PolyfunctionalAldehyde"]],"out":[["naming_rule","NamePattern"]],"if":["lit",true],"then":[["set","naming_rule",["lit",{"principal_function":"aldehyde","prefix_expressions":["ketones","pseudoketones","heterones","hydroxy compounds","amines","imines"],"operation":"express by prefixes","source_text":"In the presence of an aldehyde group, ketones, pseudoketones, heterones, hydroxy compounds, amines, and imines are expressed by prefixes."}]]],"else":[]},
    {"id":"polyfunctional_aldehyde_seniority","k":"rule","f":"required","c":[3],"scope":{"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},"in":[["compound","PolyfunctionalAldehyde"]],"out":[["numbering_basis","NumberingSeniority"]],"if":["lit",true],"then":[["set","numbering_basis",["lit",{"rule":"seniority for numbering polyfunctional aldehydes follows the seniority described for acids","references":["P-65.1.2.3","P-65.1.2.4"],"source_text":"Seniority for numbering polyfunctional aldehydes follows that described for acids."}]]],"else":[]},
    {"id":"acetal_and_ketal_class_and_naming","k":"rule","f":"required","c":[20,21,22,23,24,25],"scope":{"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},"in":[["compound","AcetalOrKetal"]],"out":[["naming_options","AcetalNamingOptions"]],"if":["lit",true],"then":[["set","naming_options",["lit",{"acetal_structure":"RR'C(O-R'')(O-R''')","hydrogen_allowed_on_R_or_R_prime":true,"class_name":"acetal","ketal_subclass":"neither R nor R' may be hydrogen","methods":[{"method":1,"kind":"substitutive","construction":"alkoxy, alkyloxy, aryloxy, etc. derivatives of an appropriate parent hydride or functional parent compound","status":"preferred IUPAC name"},{"method":2,"kind":"functional class nomenclature","construction":"cite the aldehyde or ketone, the O-substituents in alphanumerical order if required, and finally acetal or ketal","status":"general nomenclature"}],"source_text":"Acetals (ketals) are named in two ways; method (1), the substitutive method, leads to preferred IUPAC names."}]]],"else":[]},
    {"id":"cyclic_acetal_and_ketal_naming","k":"rule","f":"required","c":[36,37,38],"scope":{"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},"in":[["compound","CyclicAcetalOrKetal"]],"out":[["naming_options","CyclicAcetalNamingOptions"]],"if":["lit",true],"then":[["set","naming_options",["lit",{"cyclic_acetal":{"principal_function":true,"method":"name as a heterocyclic compound","status":"preferred IUPAC name"},"cyclic_ketal":{"method":"name as a spiro compound under Section P-24","status":"preferred IUPAC name"},"general_nomenclature":{"allowed_method":"functional class nomenclature using the appropriate divalent substituent groups"},"source_text":"Cyclic acetals as the principal function are named as heterocyclic compounds; cyclic ketals are spiro compounds named in accordance with Section P-24; functional class nomenclature may be used in general nomenclature."}]]],"else":[]},
    {"id":"hemiacetal_and_hemiketal_naming","k":"rule","f":"required","c":[49,50,51,52,53],"scope":{"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},"in":[["compound","HemiacetalOrHemiketal"]],"out":[["naming_options","HemiacetalNamingOptions"]],"if":["lit",true],"then":[["set","naming_options",["lit",{"structure":"RR'C(OH)(O-R'')","class_name":"hemiacetal","preferred_method":"substitutive alkoxy, alkyloxy, aryloxy, etc. derivative of an appropriate hydroxy parent compound such as an alcohol","functional_class_method":{"hemiacetal":"use the class name hemiacetal","hemiketal":"use the class name hemiketal for ketone derivatives"},"source_text":"These substitutive names are the preferred IUPAC names; other names use functional class nomenclature."}]]],"else":[]},
    {"id":"chalcogen_acetal_and_ketal_naming","k":"rule","f":"required","c":[60,61,62,63,64,65],"scope":{"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},"in":[["compound","ChalcogenAcetalOrKetal"]],"out":[["naming_options","ChalcogenAcetalNamingOptions"]],"if":["lit",true],"then":[["set","naming_options",["lit",{"structures":["RR'C(S-R'')(S-R''')","RR'C(S-R'')(O-R''')"],"class_names":{"first":"dithioacetal","second":"monothioacetal"},"preferred_method":"substitutive alkylsulfanyl, arylsulfanyl, alkoxy, or aryloxy derivatives of a parent hydride","functional_class_names":["monothioacetal","dithioketal"],"structural_specificity":"use capital italic letter locants","chalcogens":["sulfur","selenium","tellurium","mixed chalcogens"],"analogue_treatment":"selenium, tellurium, and mixed chalcogen analogues are treated in the same way as sulfur analogues","source_text":"Substitutive names are preferred IUPAC names; other names can be generated by functional class nomenclature."}]]],"else":[]},
    {"id":"chalcogen_hemiacetal_and_hemiketal_naming","k":"rule","f":"required","c":[80,81,82,83,84,85,86],"scope":{"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},"in":[["compound","ChalcogenHemiacetalOrHemiketal"]],"out":[["naming_options","ChalcogenHemiacetalNamingOptions"]],"if":["lit",true],"then":[["set","naming_options",["lit",{"structures":["RR'C(SH)(S-R'')","RR'C(OH)(S-R'')","RR'C(SH)(O-R'')"],"class_names":{"first":"dithiohemiacetal","second":"monothiohemiacetal"},"preferred_method":"substitutive alkylsulfanyl, arylsulfanyl, alkoxy, or aryloxy derivatives of a hydroxy parent compound","functional_class_method":"other names can be generated by functional class nomenclature","structural_specificity":"use capital italic letter locants","analogue_treatment":"selenium, tellurium, and mixed analogues are treated in the same way as sulfur analogues","generic_names":["monoselenohemiacetals","ditellurohemiacetals","selenothiohemiacetals"],"source_text":"The substitutive names are preferred IUPAC names."}]]],"else":[]},
