  "symbols": [],
  "units": [
    {
      "id": "isocyano_recommendation",
      "k": "rule",
      "f": "preference",
      "c": [3, 5, 6],
      "in": [["compound", "Compound"]],
      "out": [["naming_mode", "NomenclatureMode"], ["prefix", "Prefix"], ["preferred", "boolean"]],
      "if": ["cmp", "eq", ["get", ["var", "compound"], "contains_nc_group_attached_to_parent_hydride"], true],
      "then": [
        ["set", "naming_mode", "substitutive"],
        ["set", "prefix", "isocyano"],
        ["set", "preferred", true]
      ],
      "else": []
    },
    {
      "id": "isocyanide_history_and_change",
      "k": "definition",
      "f": "definition",
      "c": [2, 4],
      "out": [["record", "IsocyanideRecommendationHistory"]],
      "term": "isocyanide recommendation history",
      "entity": "IsocyanideRecommendationHistory",
      "value": ["lit", {
        "change": "The current recommendation is a change from earlier recommendations.",
        "current_method": "Preferred names use substitutive nomenclature and the prefix isocyano attached directly to a parent hydride.",
        "previous_method": "Functional class names were previously recommended for this class."
      }]
    },
    {
      "id": "fulminate_structure_history",
      "k": "definition",
      "f": "definition",
      "c": [12, 13, 16],
      "out": [["record", "FulminateRecommendationHistory"]],
      "term": "fulminate structure and recommendation history",
      "entity": "FulminateRecommendationHistory",
      "value": ["lit", {
        "earlier_structure": "HO-N#C",
        "earlier_names": ["fulminate", "fulminato"],
        "literature_structure": "HCNO",
        "current_change": "The potentially ambiguous historical names are replaced by systematic substitutive names."
      }]
    },
    {
      "id": "unacceptable_fulminate_names",
      "k": "constraint",
      "f": "prohibited",
      "c": [14],
      "in": [["name", "Name"]],
      "assert": ["not", ["cmp", "member_of", ["var", "name"], ["lit", ["fulminic acid", "fulminato", "isofulminic acid", "isofulminate"]]]],
      "violation": [["reject", "name", "reason.fulminate_name_not_acceptable"]]
    },
    {
      "id": "preferred_fulminic_structures",
      "k": "rule",
      "f": "preference",
      "c": [15],
      "in": [["structure", "Structure"]],
      "out": [["preferred_name", "Name"]],
      "if": ["lit", true],
      "then": [
        ["if", ["cmp", "eq", ["get", ["var", "structure"], "connectivity"], "HCNO"],
          [["set", "preferred_name", "formonitrile oxide"]],
          [["set", "preferred_name", ["lit", {"basis": "hydroxylamine", "status": "preferred IUPAC name"}]]]
        ]
      ],
      "else": []
    },
    {
      "id": "fulminate_change_table",
      "k": "mapping",
      "c": [16],
      "table": "fulminate_change_callout"
    },
    {
      "id": "detachable_prefix_alphabetization",
      "k": "procedure",
      "f": "required",
      "c": [23, 24, 28, 29],
      "in": [["prefixes", "PrefixSet"]],
      "out": [["ordered_prefixes", "PrefixSequence"]],
      "steps": [
        ["set", "ordered_prefixes", ["lit", {
          "primary_order": "alphanumerical",
          "locant_tie_order": ["prefixes_as_a_set", "first_prefix_cited_in_name"],
          "excluded_from_alphabetization": ["hydro", "dehydro"]
        }]]
      ]
    },
    {
      "id": "hydro_dehydro_placement",
      "k": "procedure",
      "f": "required",
      "c": [25, 26, 27],
      "in": [["prefix_sequence", "PrefixSequence"]],
      "out": [["rendered_prefix_sequence", "NameComponentSequence"]],
      "steps": [
        ["set", "rendered_prefix_sequence", ["lit", {
          "detachable": true,
          "alphabetized_with_other_prefixes": false,
          "position": "after_alphabetized_prefixes_before_parent_hydride_and_nondetachable_prefixes"
        }]]
      ]
    },
    {
      "id": "hydro_dehydro_placement_callout",
      "k": "mapping",
      "c": [25, 26, 27],
      "table": "hydro_dehydro_callout"
    },
    {
      "id": "functional_class_principal_group_selection",
      "k": "decision",
      "f": "required",
      "c": [30],
      "in": [["candidate_characteristic_groups", "CharacteristicGroupSet"]],
      "out": [["principal_group", "CharacteristicGroup"]],
      "candidates": ["var", "candidate_characteristic_groups"],
      "stages": [
        {
          "id": "class_and_pseudohalide_seniority",
          "c": [30],
          "key": ["get", ["var", "candidate_characteristic_groups"], "compound_class_halide_pseudohalide_seniority_key"],
          "cmp": ["lexicographic", "minimum", null, null]
        }
      ],
      "tie": ["reject_ambiguous", null]
    },
    {
      "id": "substitutive_names_preferred",
      "k": "rule",
      "f": "preference",
      "c": [31],
      "in": [["name", "Name"]],
      "out": [["preferred_iupac_name", "boolean"]],
      "if": ["cmp", "eq", ["get", ["var", "name"], "nomenclature_type"], "substitutive"],
      "then": [["set", "preferred_iupac_name", true]],
      "else": []
    },
    {
      "id": "low_locants_as_a_set",
      "k": "decision",
      "f": "preference",
      "c": [32, 34, 36],
      "in": [["locant_assignments", "LocantAssignmentSet"]],
      "out": [["selected_assignment", "LocantAssignment"]],
      "candidates": ["var", "locant_assignments"],
      "stages": [
        {
          "id": "low_locant_set",
          "c": [32, 34, 36],
          "key": ["get", ["var", "locant_assignments"], "low_locant_set"],
          "cmp": ["numeric", "minimum", null, null]
        }
      ],
      "tie": ["retain_coequal", null]
    },
    {
      "id": "low_locants_to_first_prefix",
      "k": "decision",
      "f": "preference",
      "c": [38, 40, 42, 44],
      "in": [["locant_assignments", "LocantAssignmentSet"]],
      "out": [["selected_assignment", "LocantAssignment"]],
      "candidates": ["var", "locant_assignments"],
      "stages": [
        {
          "id": "first_prefix_cited",
          "c": [38, 40, 42, 44],
          "key": ["get", ["var", "locant_assignments"], "locant_for_first_prefix_cited"],
          "cmp": ["numeric", "minimum", null, null]
        }
      ],
      "tie": ["retain_coequal", null]
    }
  ],
