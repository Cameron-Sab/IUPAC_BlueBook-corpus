  "units": [
    {
      "id": "nucleoside_nomenclature_reference",
      "k": "definition",
      "f": "definition",
      "c": [4],
      "in": [["compound", "nucleoside"]],
      "out": [["source", "reference"]],
      "term": "nucleoside nomenclature reference",
      "entity": "nucleoside",
      "value": ["lit", {
        "document": "Abbreviations and Symbols for Nucleic Acids, Polynucleotides and their Constituents",
        "reference": "ref. 47",
        "role": "exemplifies nucleoside nomenclature"
      }]
    },
    {
      "id": "nucleoside_derivative_naming_basis",
      "k": "procedure",
      "f": "required",
      "c": [5],
      "in": [["derivative", "nucleoside_derivative"]],
      "out": [["naming_basis", "procedure_basis"]],
      "steps": [
        ["emit", {"carbohydrate_moiety_modifications": "adapted from P-102", "general_substitution": "adapted from the general rules of substitution of organic compounds"}]
      ]
    },
    {
      "id": "retained_nucleoside_names",
      "k": "definition",
      "f": "definition",
      "c": [7],
      "in": [["name", "nucleoside_name"]],
      "out": [["retained", "boolean"]],
      "term": "retained names of nucleosides",
      "entity": "nucleoside_name",
      "value": ["lit", {
        "status": "retained",
        "names": ["adenosine", "guanosine", "inosine", "xanthosine", "cytidine", "thymidine", "uridine"]
      }]
    },
    {
      "id": "retained_nucleoside_ring_substitution_permission",
      "k": "rule",
      "f": "permitted",
      "c": [23],
      "in": [["nucleoside", "retained_name_nucleoside"]],
      "out": [["substitution_scope", "ring_substitution_scope"]],
      "if": ["lit", true],
      "then": [
        ["set", "substitution_scope", ["lit", {
          "purine_ring": "fully substitutable",
          "pyrimidine_ring": "fully substitutable"
        }]]
      ],
      "else": []
    },
    {
      "id": "nucleoside_oxo_functional_replacement",
      "k": "rule",
      "f": "required",
      "c": [24],
      "in": [["nucleoside", "oxo_bearing_nucleoside"]],
      "out": [["replacement_method", "functional_replacement_method"]],
      "if": ["lit", true],
      "then": [
        ["set", "replacement_method", ["lit", "functional replacement prefixes"]]
      ],
      "else": []
    },
    {
      "id": "ribofuranosyl_component_modification_permission",
      "k": "rule",
      "f": "permitted",
      "c": [25],
      "in": [["nucleoside", "retained_name_nucleoside"]],
      "out": [["modification_method", "carbohydrate_modification_method"]],
      "if": ["lit", true],
      "then": [
        ["set", "modification_method", ["lit", "as prescribed for carbohydrates in P-102.5"]]
      ],
      "else": []
    },
    {
      "id": "higher_priority_group_nucleoside_substitutive_naming",
      "k": "rule",
      "f": "required",
      "c": [39],
      "in": [
        ["compound", "pseudoketone_nucleoside"],
        ["characteristic_group", "characteristic_group_higher_priority_than_pseudoketone"]
      ],
      "out": [["naming_method", "nomenclature_method"]],
      "if": ["lit", true],
      "then": [
        ["set", "naming_method", ["lit", "normal substitutive nomenclature principles"]]
      ],
      "else": []
    },
    {
      "id": "nucleoside_oxo_replacement_permission",
      "k": "definition",
      "f": "definition",
      "c": [29],
      "in": [["nucleoside", "nucleoside"]],
      "out": [["permission", "naming_permission"]],
      "term": "oxo-to-fluoro replacement permission in the example",
      "entity": "nucleoside",
      "value": ["lit", {
        "replacement": "hydroxy group by a fluorine atom at the same position",
        "status": "allowed"
      }]
    }
  ],
