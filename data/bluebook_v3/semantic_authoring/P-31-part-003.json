  "units": [
    {
      "id": "monocyclic_hydrocarbon_ring_assembly_scope",
      "k": "definition",
      "f": "definition",
      "c": [2],
      "in": [["assembly", "RingAssembly"]],
      "out": [["in_scope", "boolean"]],
      "term": "monocyclic hydrocarbon ring assembly",
      "entity": "RingAssembly",
      "value": ["lit", {"components": ["monocyclic mancude hydrocarbons", "monocyclic saturated hydrocarbons"]}]
    },
    {
      "id": "monocyclic_hydrocarbon_hydro_locant_assignment",
      "k": "procedure",
      "f": "required",
      "c": [3],
      "in": [["assembly", "RingAssembly"]],
      "out": [["hydro_prefix_locants", "LocantSet"]],
      "steps": [["set", "hydro_prefix_locants", {"assignment": "low locants", "basis": "fixed numbering of each assembly"}]]
    },
    {
      "id": "biphenyl_polyphenyl_parent_selection",
      "k": "rule",
      "f": "required",
      "c": [4, 5],
      "in": [["assembly", "RingAssembly"]],
      "out": [["parent_hydride", "ParentHydride"], ["unsaturation_expression", "NameComponent"]],
      "if": ["cmp", "eq", ["get", ["var", "assembly"], "class"], "biphenyl_or_polyphenyl"],
      "then": [["set", "parent_hydride", {"requirement": "one benzene ring remains in the assembly"}], ["set", "unsaturation_expression", {"otherwise_parent": "saturated assembly", "ending": "ene", "reference": "P-31.1.7"}]],
      "else": []
    },
    {
      "id": "benzene_cyclohexane_modified_assembly_preference",
      "k": "rule",
      "f": "preference",
      "c": [6],
      "in": [["assembly", "ModifiedRingAssembly"]],
      "out": [["nomenclature_method", "NomenclatureMethod"]],
      "if": ["all", ["cmp", "eq", ["get", ["var", "assembly"], "ring_count"], 2], ["cmp", "eq", ["get", ["var", "assembly"], "ring_types"], ["lit", ["benzene", "cyclohexane"]]]],
      "then": [["set", "nomenclature_method", "substitutive nomenclature"]],
      "else": []
    },
    {
      "id": "phane_name_node_requirement",
      "k": "constraint",
      "f": "required",
      "c": [16],
      "in": [["phane_name", "PhaneName"]],
      "out": [["valid", "boolean"]],
      "assert": ["cmp", "eq", ["get", ["var", "phane_name"], "node_count"], 7],
      "violation": [["reject", "phane_name", "reason.phane_name.requires_seven_nodes"]]
    },
    {
      "id": "heteromonocyclic_ring_assembly_scope",
      "k": "definition",
      "f": "definition",
      "c": [20],
      "in": [["assembly", "RingAssembly"]],
      "out": [["in_scope", "boolean"]],
      "term": "heteromonocyclic ring assembly",
      "entity": "RingAssembly",
      "value": ["lit", {"components": "heteromonocycles"}]
    },
    {
      "id": "heteromonocyclic_locant_assignment",
      "k": "procedure",
      "f": "required",
      "c": [21],
      "in": [["assembly", "RingAssembly"]],
      "out": [["locants", "LocantAssignment"]],
      "steps": [["set", "locants", {"priority_order": ["junctions between rings", "indicated hydrogen", "hydro prefixes"], "direction": "low locants"}]]
    },
    {
      "id": "polycyclic_component_locant_assignment",
      "k": "procedure",
      "f": "required",
      "c": [27],
      "in": [["assembly", "PolycyclicRingAssembly"]],
      "out": [["locants", "LocantAssignment"]],
      "steps": [["set", "locants", {"priority_order": ["junctions between components", "indicated hydrogen atoms", "hydro prefixes"], "direction": "low locants"}]]
    },
    {
      "id": "dehydro_prefix_hydrogen_removal_scope",
      "k": "definition",
      "f": "required",
      "c": [36, 37],
      "term": "dehydro subtractive prefix",
      "entity": "SubtractivePrefixOperation",
      "value": ["lit", {"operation": "remove hydrogen atoms and form multiple bonds", "prefix": "dehydro", "systematic_organic_nomenclature_use": "very limited"}]
    },
    {
      "id": "didehydrobenzene_pin_preference",
      "k": "definition",
      "f": "preference",
      "c": [38],
      "term": "preferred name for dehydrogenated benzene",
      "entity": "PreferredNameSelection",
      "value": ["lit", {"preferred_iupac_name": "1,2-didehydrobenzene", "former_name": "benzyne", "former_name_status": "not preferred"}]
    },
    {
      "id": "didehydroannulene_general_nomenclature_scope",
      "k": "definition",
      "f": "permitted",
      "c": [39],
      "term": "didehydro annulene name scope",
      "entity": "NomenclatureRegimePermission",
      "value": ["lit", {"name_class": "didehydro[n]annulene", "preferred_iupac_name": false, "general_nomenclature": "acceptable"}]
    },
    {
      "id": "dehydro_natural_product_and_carbohydrate_scope",
      "k": "definition",
      "f": "permitted",
      "c": [45, 46],
      "term": "dehydro prefix class-specific scope",
      "entity": "NomenclatureClassScope",
      "value": ["lit", {"uses": [{"class": "natural products", "purpose": "preserve semisystematic stereoparent names"}, {"class": "carbohydrates", "status": "used"}]}]
    },
    {
      "id": "hantzsch_widman_hydro_over_dehydro_preference",
      "k": "rule",
      "f": "preference",
      "c": [47, 48],
      "in": [["heterocycle", "HantzschWidmanHeterocycle"]],
      "out": [["unsaturation_naming_method", "NomenclatureMethod"]],
      "if": ["lit", {"ring_name_system": "Hantzsch-Widman", "purpose": "denote double-bond unsaturation"}],
      "then": [["set", "unsaturation_naming_method", ["lit", {"preferred_prefix": "hydro", "dehydro_prefix": "not recommended"}]]],
      "else": []
    }
