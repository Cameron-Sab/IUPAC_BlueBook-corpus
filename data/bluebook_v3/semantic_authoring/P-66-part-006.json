    {
      "id": "nitrile_and_cyanide_class_definition",
      "k": "definition",
      "f": "definition",
      "c": [98,99],
      "scope": {"r":["all"],"if":["lit",true]},
      "out": [["class","ChemicalClass"]],
      "term": "nitrile",
      "entity": "ChemicalClass",
      "value": ["lit",{"general_structure":"R-C#N","class_names":["nitrile","cyanide"],"formal_parent":"hydrocyanic acid (H-C#N)","attachment_scope":"R may attach through carbon or a heteroatom","substitutive_class":"nitrile"}]
    },
    {
      "id": "nitrile_introductory_naming_policy",
      "k": "rule",
      "f": "required",
      "c": [100,101,102],
      "scope": {"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},
      "in": [["compound","Nitrile"]],
      "out": [["policy","NitrileNamingPolicy"]],
      "if": ["lit",true],
      "then": [["set","policy",["lit",{"substitutive":"nitrile nomenclature","functional_class_alternative":"cyanide","formonitrile":"preferred IUPAC parent name; substituted names remain preferred when permitted"}]]],
      "else": []
    },
    {
      "id": "preferred_nitrile_naming_methods",
      "k": "procedure",
      "f": "required",
      "c": [105,106,107,108,109,110],
      "scope": {"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},
      "in": [["compound","Nitrile"]],
      "out": [["name","NitrileName"]],
      "steps": [
        ["set","methods",["lit",[
          {"id":1,"kind":"substitutive","suffix_rules":[{"suffix":"nitrile","group":"-(C)N"},{"suffix":"carbonitrile","group":"-CN"}]},
          {"id":2,"kind":"retained acid derivation","operation":"replace ic acid or oic acid with onitrile","property_transfer":"preferred and nonsubstitutable status follows the corresponding acid","references":["P-65.1.1.1","P-65.1.1.2"]},
          {"id":3,"kind":"functional class","class_name":"cyanide"}
        ]]],
        ["emit",["var","methods"]]
      ]
    },
    {
      "id": "acyclic_mono_and_dinitrile_methods",
      "k": "procedure",
      "f": "required",
      "c": [112,113,114,115,116],
      "scope": {"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},
      "in": [["compound","AcyclicMonoOrDinitrile"]],
      "out": [["name","NitrileName"]],
      "steps": [
        ["set","methods",["lit",[
          {"id":1,"kind":"substitutive","suffix":"nitrile","status":"preferred IUPAC name"},
          {"id":2,"kind":"functional class","class_name":"cyanide","status":"general nomenclature"}
        ]]],
        ["emit",["var","methods"]]
      ]
    },
    {
      "id": "polycyano_unbranched_alkane_naming",
      "k": "rule",
      "f": "required",
      "c": [122],
      "scope": {"r":["preferred_iupac_name"],"if":["lit",{"unbranched_alkane":true,"terminal_cyano_group_count":{"greater_than":2}}]},
