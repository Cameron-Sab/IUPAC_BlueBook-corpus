      "out": [["prefix","HydrazineGroupPrefix"]],
      "table": "hydrazide_group_prefixes"
    },
    {
      "id": "hydrazonamide_prefix_formation",
      "k": "procedure",
      "f": "required",
      "c": [14,15,16,17],
      "scope": {"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",{"senior_principal_characteristic_group_present":true}]},
      "in": [["group","HydrazonamideGroup"]],
      "out": [["prefix","PrefixName"]],
      "steps": [
        ["set","methods",["lit",[
          {"id":1,"operation":"replace final e of complete amide name by o","kind":"substitutive","status":"preferred"},
          {"id":2,"operation":"substitute the acyl-group name onto amino","kind":"acylamino prefix","status":"general"}
        ]]],
        ["set","chalcogen_scope",["lit",["sulfur","selenium","tellurium"]]],
        ["emit",["var","methods"]]
      ]
    },
    {
      "id": "imidic_hydrazide_prefix_formation",
      "k": "procedure",
      "f": "required",
      "c": [22,23,24,25,26],
      "scope": {"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",{"senior_principal_characteristic_group_present":true}]},
      "in": [["group","ImidicHydrazideGroup"]],
      "out": [["prefix","PrefixName"]],
      "steps": [
        ["set","methods",["lit",[
          {"id":1,"operation":"replace final e of the corresponding hydrazide name by o","status":"preferred"},
          {"id":2,"operation":"form an acylhydrazinyl prefix","status":"general"}
        ]]],
        ["set","hydrazinyl_numbering",["lit",{"locants":[1,2]}]],
        ["set","analogue_scope",["lit",["sulfur","selenium","tellurium"]]],
        ["emit",["var","methods"]]
      ]
    },
    {
      "id": "hydrazidine_class_and_suffix_naming",
      "k": "rule",
      "f": "required",
      "c": [34,35,36,37,39,40,41,42,43],
      "scope": {"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},
      "in": [["compound","Hydrazidine"]],
      "out": [["naming_policy","HydrazidineNamingPolicy"]],
      "if": ["lit",true],
      "then": [["set","naming_policy",["lit",{
        "general_structure":"R-C(=N-NH2)-NH-NH2",
        "class_name":"hydrazidine",
        "systematic_suffixes":["hydrazonohydrazide","carbohydrazonohydrazide"],
        "suffix_basis":"corresponding hydrazide",
        "former_hydrazone_method":"no longer recommended",
        "nitrogen_locants":"assigned by the source locant scheme; when needed, the parent-attachment locant is a superscript arabic number on the appropriate N locant",
        "retained_acid_derivatives":{"general_nomenclature":"replace ohydrazide by hydrazonohydrazide","preferred_iupac_name":"form systematically"},
        "property_transfer":"preferred and nonsubstitutable status transfers from the corresponding hydrazide"
      }]]],
      "else": []
    },
    {
      "id": "chalcogen_acid_hydrazidine_analogy",
      "k": "rule",
      "f": "required",
      "c": [61],
      "scope": {"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},
      "in": [["compound","ChalcogenAcidDerivedHydrazidine"]],
      "out": [["method","HydrazidineNamingMethod"]],
      "if": ["lit",true],
      "then": [["set","method",["lit",{"apply":"hydrazidine principles","acid_classes":["sulfonic","sulfinic","selenium analogues","tellurium analogues"]}]]],
      "else": []
    },
    {
      "id": "carbonic_acid_hydrazidine_procedure",
      "k": "procedure",
      "f": "required",
      "c": [65],
      "scope": {"r":["preferred_iupac_name","general_nomenclature"],"if":["lit",true]},
      "in": [["compound","CarbonicAcidDerivedHydrazidine"]],
      "out": [["name","HydrazidineName"]],
      "steps": [["invoke","P-66.3.5",{"compound":["var","compound"]}],["emit",["var","name"]]]
    },
    {
      "id": "hydrazidine_prefixes_with_senior_group",
      "k": "rule",
      "f": "required",
      "c": [72,73],
