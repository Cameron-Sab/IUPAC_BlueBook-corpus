      "out": [["name","PreferredIUPACName"]],
      "if": ["lit",true],
      "then": [["set","name",["lit",{"parent":"parent hydride","suffix":"carbonitrile","prefix":"appropriate multiplicative prefix","locants":"required for all cyano groups"}]]],
      "else": []
    },
    {
      "id": "ring_or_heteroatom_carbonitrile_suffix",
      "k": "rule",
      "f": "required",
      "c": [126],
      "scope": {"r":["preferred_iupac_name"],"if":["lit",true]},
      "in": [["compound","RingOrHeteroatomAttachedNitrile"]],
      "out": [["suffix","Suffix"]],
      "if": ["lit",{"cyano_attachment":["ring","ring system","acyclic heteroatom"]}],
      "then": [["set","suffix",["lit","carbonitrile"]]],
      "else": []
    },
    {
      "id": "cyano_prefix_requirement",
      "k": "rule",
      "f": "required",
      "c": [137,138],
      "scope": {"r":["preferred_iupac_name"],"if":["lit",true]},
      "in": [["compound","CompoundWithCyanoGroup"]],
