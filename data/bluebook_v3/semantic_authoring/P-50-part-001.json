      "k": "definition",
      "f": "definition",
      "c": [13, 14, 15, 16, 17, 18],
      "out": [["specialized_selection_scope", "ParentStructureSelectionScope"]],
      "term": "specialized preferred-parent selection scope",
      "entity": "ParentStructureSelectionScope",
      "value": ["lit", {
        "chapter_P2": "Most rules generate preferred names of cyclic and acyclic compounds directly.",
        "phane_nomenclature": "Recommended when rings, ring systems, and chains are composed of entities that are themselves rings or ring systems, whether or not interconnected by chains.",
