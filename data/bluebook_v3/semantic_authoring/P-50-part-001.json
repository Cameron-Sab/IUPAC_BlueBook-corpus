      "term": "preferred IUPAC name selection scope",
      "entity": "PreferredNameSelectionScope",
      "value": ["lit", {
        "multiple_names": true,
        "preferred_name": "one name is selected as the preferred IUPAC name (PIN)",
        "chapters": {"selection_rules": ["P-1", "P-2", "P-3", "P-4"], "application": ["P-1", "P-2", "P-3", "P-4", "P-6", "P-7", "P-8", "P-9", "P-10"]}
      }]
    },
    {
      "id": "principal_nomenclature_type",
      "k": "definition",
      "f": "definition",
      "c": [4, 5, 6, 7],
      "out": [["nomenclature_policy", "NomenclaturePolicy"]],
      "term": "principal and alternative nomenclature types",
      "entity": "NomenclaturePolicy",
      "value": ["lit", {
        "principal_type": "substitutive nomenclature",
        "alternative_types": "Other types are recommended where substitutive nomenclature was never recommended for a class or where another method simplifies a long cumbersome name.",
        "chapter_P1": "Several nomenclature types are discussed and all are used to generate preferred IUPAC names and names for general nomenclature."
      }]
    },
    {
      "id": "functional_class_nomenclature_scope",
      "k": "definition",
      "f": "permitted",
      "c": [8],
      "out": [["scope", "NomenclatureScope"]],
      "term": "functional class nomenclature scope",
      "entity": "NomenclatureScope",
      "value": ["lit", {"method": "functional class nomenclature", "uses": ["acid halides", "esters"], "purpose": "well defined classes"}]
    },
    {
      "id": "multiplicative_nomenclature_condition",
      "k": "rule",
      "f": "permitted",
      "c": [9, 10],
      "in": [["molecule", "Molecule"]],
      "out": [["recommended_method", "NomenclatureMethod"]],
      "if": ["lit", true],
      "then": [
        ["if", ["cmp", "eq", ["get", ["var", "molecule"], "multiplicative_conditions_fulfilled"], true],
          [["set", "recommended_method", "multiplicative"]],
          [["set", "recommended_method", "substitutive"]]
        ]
      ],
      "else": []
    },
    {
      "id": "skeletal_replacement_scope",
      "k": "rule",
      "f": "required",
      "c": [11, 12],
      "in": [["molecule", "Molecule"]],
      "out": [["skeletal_replacement_status", "NomenclatureStatus"]],
      "if": ["lit", true],
      "then": [
        ["if", ["cmp", "eq", ["get", ["var", "molecule"], "saturated_heterocycle_over_ten_or_heteropolycyclic_bridged_or_spiro"], true],
          [["set", "skeletal_replacement_status", "mandatory"]],
          [["set", "skeletal_replacement_status", "simplifying_method"]]
        ]
      ],
      "else": []
    },
    {
