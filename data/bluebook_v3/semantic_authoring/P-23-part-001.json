  "symbols": [],
  "units": [
    {
      "id": "section_basis_and_supersession",
      "k": "definition",
      "f": "definition",
      "c": [4, 5, 6],
      "out": [["provenance", "SectionProvenance"]],
      "term": "P-23 publication basis and supersession",
      "entity": "SectionProvenance",
      "value": ["lit", {
        "basis_publication": "Extension and Revision of the von Baeyer system for naming polycyclic compounds (including bicyclic compounds) (IUPAC Recommendations 1999)",
        "basis_reference": "ref. 7",
        "supersedes": [
          "Rules A-31, A-32, and B-14 in the 1979 Recommendations (ref. 1)",
          "Rule R-2.4.2 in the 1993 Recommendations (ref. 2)"
        ],
        "modifications_to_1999_publication": false
      }]
    },
    {
      "id": "saturated_von_baeyer_scope",
      "k": "definition",
      "f": "required",
      "c": [7, 8, 9],
      "out": [["scope", "VonBaeyerScope"]],
      "term": "scope of the saturated von Baeyer system",
      "entity": "VonBaeyerScope",
      "value": ["lit", {
        "ring_systems": "saturated polyalicyclic ring systems",
        "naming_system": "von Baeyer system",
        "unsaturated_systems": "see Section P-31.1.4",
        "derived_substituent_groups": "see Section P-29"
      }]
    },
    {
      "id": "bridgehead_definition",
      "k": "definition",
      "f": "definition",
      "c": [11],
      "out": [["bridgehead", "Bridgehead"]],
      "term": "bridgehead",
      "entity": "Bridgehead",
      "value": ["lit", {
        "definition": "a skeletal atom of the ring system bonded to three or more skeletal atoms",
        "excluded_neighbors": ["hydrogen"]
      }]
    },
    {
      "id": "bridge_definition",
      "k": "definition",
      "f": "definition",
      "c": [12],
      "out": [["bridge", "Bridge"]],
      "term": "bridge",
      "entity": "Bridge",
      "value": ["lit", {
        "connects": "two bridgeheads",
        "allowed_forms": ["unbranched chain of atoms", "atom", "valence bond"]
      }]
    },
    {
      "id": "main_ring_definition",
      "k": "definition",
      "f": "definition",
      "c": [13],
      "out": [["main_ring", "MainRing"]],
      "term": "main ring",
      "entity": "MainRing",
      "value": ["lit", {
        "selection": "the ring system including as many skeletal atoms of the polycyclic system as possible"
      }]
    },
    {
      "id": "main_bridge_definition",
      "k": "definition",
      "f": "definition",
      "c": [14],
      "out": [["main_bridge", "MainBridge"]],
      "term": "main bridge",
      "entity": "MainBridge",
      "value": ["lit", {
        "bicyclic_system": "the bridge included in the bicyclic system",
        "polycyclic_system": "the first selected bridge"
      }]
    },
    {
      "id": "main_bridgeheads_definition",
      "k": "definition",
      "f": "definition",
      "c": [15, 16],
      "out": [["main_bridgeheads", "BridgeheadPair"]],
      "term": "main bridgeheads",
      "entity": "BridgeheadPair",
      "value": ["lit", {
        "count": 2,
        "membership": "both are included in the main ring",
        "connection": "connected by the main bridge"
      }]
    },
    {
      "id": "secondary_bridge_general_definition",
      "k": "definition",
      "f": "definition",
      "c": [17],
      "out": [["secondary_bridge", "SecondaryBridge"]],
      "term": "secondary bridge",
      "entity": "SecondaryBridge",
      "value": ["lit", {
        "definition": "a bridge not included in the main ring or the main bridge"
      }]
    },
    {
      "id": "independent_secondary_bridge_definition",
      "k": "definition",
      "f": "definition",
      "c": [18],
      "out": [["bridge", "IndependentSecondaryBridge"]],
      "term": "independent secondary bridge",
      "entity": "IndependentSecondaryBridge",
      "value": ["lit", {
        "links": "bridgeheads that are part of the main ring or main bridge"
      }]
    },
    {
      "id": "dependent_secondary_bridge_definition",
      "k": "definition",
      "f": "definition",
      "c": [19],
      "out": [["bridge", "DependentSecondaryBridge"]],
      "term": "dependent secondary bridge",
      "entity": "DependentSecondaryBridge",
      "value": ["lit", {
        "links": "bridgeheads where at least one is part of a secondary bridge"
      }]
    },
    {
      "id": "polycyclic_system_definition",
      "k": "definition",
      "f": "definition",
      "c": [20],
      "out": [["polycyclic_system", "PolycyclicSystem"]],
      "term": "polycyclic system",
      "entity": "PolycyclicSystem",
      "value": ["lit", {
        "ring_count": "the minimum number of scissions required to convert the system into an acyclic skeleton"
      }]
    },
    {
      "id": "ring_count_prefix_rule",
      "k": "procedure",
      "f": "required",
      "c": [21],
      "in": [["ring_count", "integer"]],
      "out": [["prefix", "NameComponent"]],
      "steps": [
        ["set", "prefix", ["lit", {
          "attachment": "nondetachable",
          "mapping": {"2": "bicyclo", "3": "tricyclo", "4": "tetracyclo", "higher": "corresponding numerical polycyclo prefix"},
          "prohibited_for_two_rings": "dicyclo"
        }]]
      ]
    },
    {
      "id": "von_baeyer_rules_applied_in_order",
      "k": "procedure",
      "f": "required",
      "c": [23],
      "in": [["hydrocarbon", "VonBaeyerHydrocarbon"]],
      "out": [["naming_decision", "NamingDecision"]],
      "steps": [
        ["set", "naming_decision", ["lit", {
          "procedure": "apply the following rules in order until a decision is reached",
          "ordered_sections": [
            "P-23.2.1",
            "P-23.2.2",
            "P-23.2.3",
            "P-23.2.4",
            "P-23.2.5",
            "P-23.2.6"
          ]
        }]]
      ]
    },
    {
      "id": "main_ring_selection",
      "k": "decision",
      "f": "required",
      "c": [26],
      "in": [["candidate_main_rings", "MainRingSet"]],
      "out": [["selected_main_ring", "MainRing"]],
      "candidates": ["var", "candidate_main_rings"],
      "stages": [
        {
          "id": "maximum_skeletal_atom_count",
          "c": [26],
          "key": ["get", ["var", "candidate_main_ring"], "skeletal_atom_count"],
          "cmp": ["numeric", "maximum", null, null]
        }
      ],
      "tie": ["retain_coequal", null]
    },
    {
      "id": "main_ring_bold_line_rendering",
      "k": "definition",
      "f": "definition",
      "c": [27],
      "out": [["rendering", "RingRenderingConvention"]],
      "term": "main-ring rendering convention",
      "entity": "RingRenderingConvention",
      "value": ["lit", {
        "component": "main ring",
        "line_style": "bold",
        "applies_in": "subsections P-23.2.1 through P-23.2.6"
      }]
    },
    {
      "id": "bicyclic_naming_prefix_rule",
      "k": "rule",
      "f": "required",
      "c": [34],
      "in": [["hydrocarbon", "SaturatedHomogeneousBicyclicHydrocarbon"]],
      "out": [["name_pattern", "BicyclicNamePattern"]],
      "if": ["all",
        ["cmp", "eq", ["get", ["var", "hydrocarbon"], "saturation"], "saturated"],
        ["cmp", "eq", ["get", ["var", "hydrocarbon"], "homogeneity"], "homogeneous"],
        ["cmp", "eq", ["get", ["var", "hydrocarbon"], "topology"], "bicyclic"],
        ["cmp", "ge", ["get", ["var", "hydrocarbon"], "shared_atom_count"], 2]
      ],
      "then": [
        ["set", "name_pattern", ["lit", {
          "prefix": "bicyclo",
          "base_name": "the acyclic hydrocarbon having the same total number of skeletal atoms"
        }]]
      ],
      "else": []
    },
    {
      "id": "bicyclic_descriptor_format",
      "k": "procedure",
      "f": "required",
      "c": [35],
      "in": [["bicyclic_system", "BicyclicSystem"]],
      "out": [["bridge_descriptor", "VonBaeyerDescriptor"]],
      "steps": [
        ["set", "bridge_descriptor", ["lit", {
          "numbers": "skeletal atoms in each of the two segments connecting the main bridgeheads and in the main bridge",
          "order": "descending numerical order",
          "separator": "full stops",
          "enclosure": "square brackets",
          "number_style": "arabic numbers"
        }]]
      ]
    },
    {
      "id": "bicyclic_numbering_procedure",
      "k": "procedure",
      "f": "required",
      "c": [40, 41],
      "in": [["bicyclic_system", "BicyclicSystem"]],
      "out": [["numbering_sequence", "NumberingSequence"]],
      "steps": [
        ["set", "numbering_sequence", ["lit", {
          "start": "one of the bridgeheads",
          "first_path": "the longer segment of the main ring to the second bridgehead",
          "return_path": "the unnumbered segment of the main ring back to the first bridgehead",
          "completion": "number the main bridge beginning with the atom next to the first bridgehead"
        }]]
      ]
    },
    {
      "id": "multiple_bridge_connection_context",
      "k": "definition",
      "f": "required",
      "c": [48],
      "out": [["bridge_context", "PolycyclicBridgeContext"]],
      "term": "multiple-bridge polycyclic context",
      "entity": "PolycyclicBridgeContext",
      "value": ["lit", {
        "condition": "a polycyclic ring system has more than one bridge connecting atoms of the main ring and/or the main bridge"
      }]
    },
    {
      "id": "main_bridge_selection",
      "k": "decision",
      "f": "required",
      "c": [49],
      "in": [["candidate_bridges", "BridgeSet"]],
      "out": [["selected_main_bridge", "MainBridge"]],
      "candidates": ["var", "candidate_bridges"],
      "stages": [
        {
          "id": "maximum_atoms_outside_main_ring",
          "c": [49],
          "key": ["get", ["var", "candidate_bridge"], "atoms_not_in_main_ring"],
          "cmp": ["numeric", "maximum", null, null]
        }
      ],
      "tie": ["retain_coequal", null]
    },
    {
      "id": "main_bridge_rendering_convention",
      "k": "definition",
      "f": "definition",
      "c": [49],
      "out": [["rendering", "BridgeRenderingConvention"]],
      "term": "main-ring and main-bridge rendering",
      "entity": "BridgeRenderingConvention",
      "value": ["lit", {
        "main_ring": "solid bold lines",
        "main_bridge": "dashed lines"
      }]
    },
    {
      "id": "secondary_bridge_definition",
      "k": "definition",
      "f": "definition",
      "c": [50],
      "out": [["secondary_bridge", "SecondaryBridge"]],
      "term": "secondary bridge",
      "entity": "SecondaryBridge",
      "value": ["lit", {
        "definition": "a bridge other than the main bridge",
        "rendering": "normal solid line"
      }]
    },
    {
      "id": "tricyclic_name_construction",
      "k": "procedure",
      "f": "required",
      "c": [54, 55, 56, 57, 58, 59, 60],
      "in": [["tricyclic_system", "TricyclicSystem"]],
      "out": [["tricyclic_name", "Name"]],
      "steps": [
        ["set", "tricyclic_name", ["lit", {
          "basis": "a bicyclic system described in P-23.2.2",
          "independent_secondary_bridge": {
            "length": "number of atoms, expressed as an arabic number",
            "attachment_locants": "a pair of superscript arabic numbers, lower first and separated by a comma"
          },
          "parts": [
            {
              "letter": "a",
              "component": "prefix",
              "value": "tricyclo",
              "replaces": "bicyclo",
              "meaning": "three rings in the polyalicyclic system"
            },
            {
              "letter": "b",
              "component": "bridge_lengths",
              "order": ["two branches of the main ring", "main bridge", "secondary bridge"],
              "secondary_bridge_locants": "superscript locants separated by commas indicating points of attachment to the main ring",
              "punctuation": "all separated by full stops and placed in brackets",
              "example": "[2.2.1.02,6]"
            },
            {
              "letter": "c",
              "component": "base_name",
              "value": "the acyclic hydrocarbon having the same total number of skeletal atoms"
            }
          ]
        }]]
      ]
    },
    {
      "id": "independent_secondary_bridge_numbering",
      "k": "procedure",
      "f": "required",
      "c": [65],
      "in": [["tricyclic_system", "TricyclicSystem"]],
      "out": [["numbering", "NumberingSequence"]],
      "steps": [
        ["set", "numbering", ["lit", {
          "precondition": "the main ring and main bridge have been numbered",
          "bridge": "independent secondary bridge",
          "start": "the higher numbered bridgehead of the main ring",
          "operation": "continue numbering from that bridgehead"
        }]]
      ]
    },
    {
      "id": "polyalicyclic_scope_and_inheritance",
      "k": "definition",
      "f": "required",
      "c": [72, 73, 74, 75],
      "out": [["scope", "PolyalicyclicApplicationScope"]],
      "term": "polyalicyclic von Baeyer application scope",
      "entity": "PolyalicyclicApplicationScope",
      "value": ["lit", {
        "analogues": ["saturated bicyclic ring systems", "saturated tricyclic ring systems"],
        "source_sections": ["P-23.2.3", "P-23.2.5"],
        "secondary_bridges_considered": ["independent", "dependent"],
        "rules_covered": ["numbering all secondary bridges", "naming all polyalicyclic systems"],
        "application_inheritance": "follow the naming and numbering rules for bicyclic systems described in P-23.2.1 through P-23.2.4"
      }]
    },
    {
      "id": "additional_bridge_selection_rule",
      "k": "definition",
      "f": "required",
      "c": [76],
      "out": [["selection_requirement", "BridgeSelectionRequirement"]],
      "term": "additional bridge-selection rule",
      "entity": "BridgeSelectionRequirement",
      "value": ["lit", {
        "necessary_to_select": ["main bridge", "secondary bridges"],
        "reason": "polycyclic systems require an additional selection rule"
      }]
    },
    {
      "id": "secondary_bridge_descriptor_rules",
      "k": "procedure",
      "f": "required",
      "c": [78, 79, 80],
      "in": [["polyalicyclic_system", "PolyalicyclicSystem"]],
      "out": [["descriptor", "VonBaeyerDescriptor"]],
      "steps": [
        ["set", "descriptor", ["lit", {
          "secondary_bridge_lengths": "cite the number of atoms in each secondary bridge as an arabic number",
          "attachment_locants": "cite the two attachment-point locants as a pair of superscript arabic numbers, lower first, separated by a comma",
          "independent_bridge_order": "cite numbers for independent secondary bridges in decreasing order"
        }]]
      ]
    },
    {
      "id": "polyalicyclic_ring_prefix_rule",
      "k": "procedure",
      "f": "required",
      "c": [82, 83],
      "in": [["polyalicyclic_system", "PolyalicyclicSystem"]],
      "out": [["prefix", "NameComponent"]],
      "steps": [
        ["set", "prefix", ["lit", {
          "series": ["tricyclo", "tetracyclo", "corresponding higher prefix"],
          "replaces": "bicyclo",
          "indicates": "number of rings in the polyalicyclic system",
          "ring_count": "number of bond cuts needed to transform the system into an acyclic skeleton, whether unbranched or branched"
        }]]
      ]
    },
    {
      "id": "additional_secondary_bridge_descriptor_format",
      "k": "procedure",
      "f": "required",
      "c": [84, 85, 86, 87],
      "in": [["polyalicyclic_system", "PolyalicyclicSystem"]],
      "out": [["descriptor", "VonBaeyerDescriptor"]],
      "steps": [
        ["set", "descriptor", ["lit", {
          "secondary_bridge_lengths": "arabic numbers separated by full stops",
          "position": "after the numbers describing the bicyclic system",
          "order": "decreasing numerical order",
          "ordering_exception": "as provided by P-23.2.6.1.3",
          "attachment_locants": "locants from the already numbered bicyclic structure, separated by a comma",
          "superscript_binding": "each attachment-locant pair is superscripted to the arabic number denoting that bridge's length",
          "descriptor_name": "von Baeyer descriptor",
          "enclosure": "brackets"
        }]]
      ]
    },
    {
      "id": "polyalicyclic_name_construction_procedure",
      "k": "procedure",
      "f": "required",
      "c": [81],
      "in": [["polyalicyclic_system", "PolyalicyclicSystem"]],
      "out": [["name", "Name"]],
      "steps": [
        ["set", "name", ["lit", {
          "procedure": "construction of names",
          "instructions": "given in the following subsections"
        }]]
      ]
    }
  ],
