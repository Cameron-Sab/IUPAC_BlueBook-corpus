  "symbols": [
    {
      "id": "nuclide_descriptor.has_other_modifying_nuclides",
      "k": "predicate",
      "d": "An isotopic descriptor contains modifying nuclides in addition to the hydrogen nuclide under consideration.",
      "a": [["descriptor", "isotopic_descriptor"]],
      "ret": "boolean",
      "g": ["primitive", [], "other_modifying_nuclides_present"]
    },
    {
      "id": "name.is_boughton_system_name",
      "k": "predicate",
      "d": "A name is formed according to the Boughton system.",
      "a": [["name", "name"]],
      "ret": "boolean",
      "g": ["primitive", [], "boughton_system_name"]
    },
    {
      "id": "name.uses_lowercase_d_or_t_outside_boughton",
      "k": "predicate",
      "d": "A name uses only a lower-case d or t as an atomic symbol outside the Boughton system.",
      "a": [["name", "name"]],
      "ret": "boolean",
      "g": ["primitive", [], "lowercase_d_or_t_outside_boughton"]
    }
  ],
  "units": [
    {
      "id": "nuclide_symbol_definition",
      "k": "definition",
      "f": "definition",
      "c": [3],
      "in": [["compound", "isotopically_modified_compound"]],
      "out": [["nuclide_symbol", "nuclide_symbol"]],
      "term": "nuclide symbol",
      "entity": "nuclide",
      "value": ["lit", {
        "parts": ["atomic symbol for the element", "arabic numeral indicating the mass number"],
        "mass_number_position": "left superscript",
        "contexts": ["formula", "name of an isotopically modified compound"],
        "source_references": ["IR-3.2", "ref. 12"]
      }]
    },
    {
      "id": "authorized_atomic_symbol_source",
      "k": "definition",
      "f": "definition",
      "c": [5],
      "in": [["element", "element"]],
      "out": [["atomic_symbol", "atomic_symbol"]],
      "term": "authorized atomic symbol",
      "entity": "element",
      "value": ["lit", {
        "source": "IUPAC Nomenclature of Inorganic Chemistry",
        "reference": "ref. 12",
        "use": "atomic symbols used in nuclide symbols"
      }]
    },
    {
      "id": "nuclide_atomic_symbol_typography",
      "k": "definition",
      "f": "definition",
      "c": [6],
      "in": [["nuclide_symbol", "nuclide_symbol"]],
      "out": [["typography", "typography_rule"]],
      "term": "nuclide atomic-symbol typography",
      "entity": "nuclide_symbol",
      "value": ["lit", {
        "atomic_symbol_type": "roman",
        "italic_atomic_symbols": "reserved for letter locants",
        "organic_nomenclature_context": "customary practice described in P-14.3"
      }]
    },
    {
      "id": "hydrogen_nuclide_symbols",
      "k": "definition",
      "f": "definition",
      "c": [7],
      "in": [["isotope", "hydrogen_isotope"]],
      "out": [["nuclide_symbol", "nuclide_symbol"]],
      "term": "hydrogen isotope nuclide symbols",
      "entity": "hydrogen_isotope",
      "value": ["lit", {
        "protium": "1H",
        "deuterium": "2H",
        "tritium": "3H"
      }]
    },
    {
      "id": "hydrogen_nuclide_abbreviation_rule",
      "k": "rule",
      "f": "required",
      "c": [8],
      "in": [["descriptor", "isotopic_descriptor"]],
      "out": [["hydrogen_symbols", "nuclide_symbol_set"]],
      "if": ["not", ["pred", "nuclide_descriptor.has_other_modifying_nuclides", ["var", "descriptor"]]],
      "then": [["set", "hydrogen_symbols", ["lit", ["D for 2H", "T for 3H"]]]],
      "else": [["set", "hydrogen_symbols", ["lit", ["2H", "3H"]]]]
    },
    {
      "id": "lowercase_symbol_boughton_policy",
      "k": "rule",
      "f": "required",
      "c": [9],
      "in": [["name", "name"]],
      "out": [["atomic_symbol_policy", "symbol_policy"]],
      "if": ["lit", true],
      "then": [["set", "atomic_symbol_policy", "lower-case d and t are not atomic symbols in other cases"]],
      "else": []
    },
    {
      "id": "boughton_lowercase_symbol_permission",
      "k": "definition",
      "f": "definition",
      "c": [9],
      "in": [["name", "name"]],
      "out": [["permission", "symbol_policy"]],
      "term": "Boughton lower-case hydrogen symbol exception",
      "entity": "name",
      "value": ["lit", {"system": "Boughton", "symbols": ["d", "t"], "replaces": ["2H", "3H"]}]
    },
    {
      "id": "lowercase_symbol_recommendation",
      "k": "rule",
      "f": "preference",
      "c": [10],
      "scope": {"r": ["all"], "if": ["lit", true]},
      "in": [["name", "name"]],
      "out": [["recommendation_status", "recommendation_status"]],
      "if": ["pred", "name.uses_lowercase_d_or_t_outside_boughton", ["var", "name"]],
      "then": [["set", "recommendation_status", "not recommended"]],
      "else": []
    },
    {
      "id": "hydrogen_atom_ion_names_source_context",
      "k": "definition",
      "f": "definition",
      "c": [12],
      "in": [["table", "hydrogen_atom_ion_table"]],
      "out": [["source_context", "text"]],
      "term": "hydrogen atom and ion name table context",
      "entity": "hydrogen_atom_ion_table",
      "value": ["lit", {"source_references": ["refs. 30", "33"]}]
    },
    {
      "id": "isotopically_unmodified_compound",
      "k": "definition",
      "f": "definition",
      "c": [41],
      "in": [["compound", "compound"]],
      "out": [["result", "boolean"]],
      "term": "isotopically unmodified compound",
      "entity": "compound",
      "value": ["lit", {
        "composition": "constituent nuclides present in the proportions occurring in nature",
        "macroscopic": true
      }]
    },
    {
      "id": "customary_unmodified_formula_and_name",
      "k": "rule",
      "f": "required",
      "c": [42],
      "in": [["compound", "isotopically_unmodified_compound"]],
      "out": [["rendering", "formula_and_name"]],
      "if": ["lit", true],
      "then": [["set", "rendering", "formula and name written in the customary manner"]],
      "else": []
    },
    {
      "id": "isotopically_modified_compound",
      "k": "definition",
      "f": "definition",
      "c": [47],
      "in": [["compound", "compound"]],
      "out": [["result", "boolean"]],
      "term": "isotopically modified compound",
      "entity": "compound",
      "value": ["lit", {
        "composition": "isotopic ratio of nuclides for at least one element deviates measurably from that occurring in nature",
        "macroscopic": true
      }]
    },
    {
      "id": "isotopically_modified_compound_classification",
      "k": "definition",
      "f": "definition",
      "c": [48, 49, 50],
      "in": [["compound", "isotopically_modified_compound"]],
      "out": [["classification", "isotopic_modification_class"]],
      "term": "isotopically modified compound classification",
      "entity": "isotopically_modified_compound",
      "value": ["lit", {
        "classes": ["isotopically substituted compound", "isotopically labeled compound"]
      }]
    }
