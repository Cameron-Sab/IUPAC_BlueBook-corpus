      "k": "procedure",
      "f": "required",
      "c": [51],
      "in": [["segment", "TerminalSegmentRequiringFurtherLengthening"]],
      "out": [["name", "AlkylSubstitutedName"]],
      "steps": [["emit", {"condition": "lengthening beyond two methylene groups", "required_method": "use alkyl groups", "exception_to": "seniority of the longest chain"}]]
    },
    {
      "id": "principal_characteristic_group_modifications",
      "k": "procedure",
      "f": "required",
      "c": [59],
      "in": [["modification", "PrincipalCharacteristicGroupModification"]],
      "out": [["name", "CharacteristicGroupModificationName"]],
      "steps": [["emit", {"examples": ["ester", "acetal"], "method": "usual Chapter P-6 methods", "specific_bases": ["P-65.6.3.2", "P-66.6.5"]}]]
    },
    {
      "id": "cyclic_characteristic_group_modification_preference",
      "k": "procedure",
      "f": "preference",
      "c": [60],
      "in": [["modification", "CyclicCharacteristicGroupModification"]],
      "out": [["preferred_name", "CyclicModificationName"]],
      "steps": [["emit", {"examples": ["lactone", "cyclic acetal"], "preferred_method": "name as the cyclic modification", "rather_than": ["fused ring system", "spiro ring system"], "applies_to_functional_class_names": true, "related_rule": "P-101.7.4"}]]
    },
    {
      "id": "parent_derived_substituent_group_name",
      "k": "procedure",
      "f": "required",
      "c": [66],
      "in": [["parent_name", "ParentStructureName"], ["valence", "FreeValenceCount"]],
      "out": [["substituent_name", "ParentDerivedSubstituentName"]],
      "steps": [["emit", {"basis_rule": "P-29", "suffix_by_valence": ["yl", "ylidene", "ylidyne"], "elision": "remove final e before y when present"}]]
    },
    {
      "id": "functional_group_ring_addition_scope",
      "k": "procedure",
      "f": "required",
      "c": [72],
      "in": [["parent", "ParentStructure"]],
      "out": [["operation_scope", "FunctionalGroupRingAdditionScope"]],
      "steps": [["emit", {"operation": "addition of rings denoting functional groups", "scope": "P-101.7.4"}]]
    },
    {
      "id": "functional_group_ring_naming",
      "k": "procedure",
      "f": "preference",
      "c": [73, 74, 75, 76],
      "in": [["ring", "FunctionalGroupRing"], ["candidate_names", "FunctionalGroupRingNames"]],
      "out": [["preferred_name", "FunctionalGroupRingName"]],
      "steps": [
        ["emit", {"general_preference": "usual systematic-name construction methods"}],
        ["emit", {"case": ["cyclic ester", "lactone"], "method": "general ester naming method", "basis_rule": "P-65.6.3.5"}],
        ["emit", {"case": "acetal", "method": "functional class nomenclature", "basis_rule": "P-66.6.5", "rather_than": "fusion nomenclature of P-101.5"}],
        ["emit", {"condition": "a choice remains", "preferred": "fusion name"}]
      ]
    },
    {
