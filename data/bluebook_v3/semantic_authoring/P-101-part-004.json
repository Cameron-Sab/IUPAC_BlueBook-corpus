    {"id": "ethyleudesmane", "c": [4], "input": {"caption": "8 alpha-ethyleudesmane"}, "ok": ["8 alpha-ethyleudesmane"], "bad": [], "shows": [["figure", "figure.asset.p_101.7.1.1.1:clause:0004"], ["semantic_unit", "organyl_group_substitutive_introduction"]], "why": "Ethyl is introduced by substitutive nomenclature on the eudesmane parent."},
    {"id": "methyl_androstane_not_nor_pregnane", "c": [9], "input": {"caption": "17 beta-methyl-5 alpha-androstane (not 21-nor-5 alpha-pregnane)"}, "ok": ["17 beta-methyl-5 alpha-androstane"], "bad": ["21-nor-5 alpha-pregnane"], "shows": [["figure", "figure.asset.p_101.7.1.1.2:clause:0005"], ["semantic_unit", "androstane_17beta_methyl_introduction"], ["semantic_unit", "pregnane_nor_alternative_not_recommended"]], "why": "The methyl substitutive procedure is used instead of methylene subtraction with nor."},
