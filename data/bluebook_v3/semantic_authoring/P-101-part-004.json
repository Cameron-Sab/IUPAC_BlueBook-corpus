    {
      "id": "alkyl_substitution_scope",
      "k": "procedure",
      "f": "required",
      "c": [1],
      "in": [["parent", "FundamentalParentStructure"]],
      "out": [["operation_scope", "AlkylSubstitutionScope"]],
      "steps": [["emit", {"operation": "substitution by alkyl groups", "scope": "P-101.7.1.1"}]]
    },
    {
      "id": "organyl_group_substitutive_introduction",
      "k": "procedure",
      "f": "required",
      "c": [2],
      "in": [["group", "OrganylGroup"], ["parent", "FundamentalParentStructure"]],
      "out": [["name", "SubstitutiveName"]],
      "steps": [["emit", {"groups": ["aryl", "alkyl", "other organyl"], "method": "substitutive nomenclature"}]]
    },
    {
      "id": "androstane_17beta_methyl_introduction",
      "k": "procedure",
      "f": "required",
      "c": [6],
      "in": [["parent", "Androstane"], ["group", "MethylGroup"]],
      "out": [["name", "MethylAndrostaneName"]],
      "steps": [["emit", {"method": "substitutive procedure", "group": "methyl", "position": "17 beta"}]]
    },
    {
      "id": "pregnane_nor_alternative_not_recommended",
      "k": "procedure",
      "f": "prohibited",
      "c": [7],
      "in": [["candidate_name", "PregnaneNorName"]],
      "out": [["status", "RecommendationStatus"]],
      "steps": [["emit", {"not_recommended": "subtracting methylene from pregnane with nondetachable nor", "preferred_alternative": "17 beta methyl substitution on androstane", "basis_rule": "P-101.3.7.1"}]]
    },
    {
      "id": "steroid_c17_alkyl_methodology",
      "k": "procedure",
      "f": "required",
      "c": [11, 12, 13],
      "in": [["parent", "FundamentalParentStructure"], ["c17_groups", "C17AlkylArrangement"]],
      "out": [["name", "SteroidName"]],
      "steps": [
        ["emit", {"case": "side chain belongs to parent carbocycle and one alkyl substituent is at C-17", "method": "Rule 3S-2.7 in reference 16"}],
        ["emit", {"case": "two alkyl substituents at C-17", "method": "Rule 3S-2.7 in reference 16"}],
        ["emit", {"scope": "any fundamental parent structure described in P-101"}]
      ]
    },
    {
      "id": "superscript_locant_identification_only",
      "k": "procedure",
      "f": "prohibited",
      "c": [14],
      "in": [["locant", "SuperscriptLocant"]],
      "out": [["permitted_use", "LocantUse"]],
      "steps": [["emit", {"permitted": "atom identification, including carbon-13 NMR assignments", "not_permitted": "locant for further substitution"}]]
    },
    {
      "id": "suffix_group_on_added_alkyl_substituent",
      "k": "procedure",
      "f": "required",
      "c": [22],
      "in": [["parent", "FundamentalParentStructure"], ["alkyl_substituent", "CharacteristicGroupBearingAlkylGroup"]],
      "out": [["name", "SubstitutiveName"]],
      "steps": [["emit", {"condition": "a suffix-cited characteristic group is on an alkyl substituent added to the parent", "method": "principles, rules, and conventions of substitutive nomenclature"}]]
    },
    {
      "id": "ring_substitution_scope",
      "k": "procedure",
      "f": "required",
      "c": [26],
      "in": [["parent", "CyclicParentHydride"]],
      "out": [["operation_scope", "RingSubstitutionScope"]],
      "steps": [["emit", {"operation": "substitution on rings", "scope": "P-101.7.1.2"}]]
    },
    {
      "id": "ring_substitution_component_order",
      "k": "procedure",
      "f": "required",
      "c": [27, 28, 29, 30],
      "in": [["components", "RingSubstitutionNameComponents"], ["parent", "CyclicParentHydride"]],
      "out": [["name", "OrderedSubstitutiveName"]],
      "steps": [
        ["emit", {"component": "suffixes", "ordering": "suffix seniority", "consideration": "cyclic nature of parent hydride"}],
        ["emit", {"component": "detachable prefixes", "ordering": "alphanumerical"}],
        ["emit", {"component": ["ene", "yne"], "ordering": "normal placement"}],
        ["emit", {"component": "hydro-dehydro prefixes", "classification": "detachable", "ordering": "last among detachable prefixes"}]
      ]
    },
    {
      "id": "terminal_segment_substitution_scope",
      "k": "procedure",
      "f": "required",
      "c": [48],
      "in": [["parent", "ParentStructureWithTerminalSegment"]],
      "out": [["operation_scope", "TerminalSegmentSubstitutionScope"]],
      "steps": [["emit", {"operation": "substitution on terminal segments", "scope": "P-101.7.1.3"}]]
    },
    {
      "id": "terminal_segment_characteristic_group_substitution",
      "k": "procedure",
      "f": "preference",
      "c": [49],
      "in": [["segment", "TerminalSegment"], ["group", "CharacteristicGroup"]],
      "out": [["name", "TerminalSegmentSubstitutionName"]],
      "steps": [["emit", {"recommended": "substitution by characteristic-group prefixes or suffixes", "applies_when": "a carbon atom included in the characteristic group is present"}]]
    },
    {
      "id": "terminal_segment_lengthening",
      "k": "procedure",
      "f": "permitted",
      "c": [50],
      "in": [["segment", "TerminalSegment"]],
      "out": [["lengthened_segment", "DihomoTerminalSegment"]],
      "steps": [["emit", {"added_units": "two methylene groups", "prefix": "dihomo", "status": "allowed"}]]
    },
    {
