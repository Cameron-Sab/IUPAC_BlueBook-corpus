        "second_example": {"retained_name": "3H-1\\u2032\\u03bb^5-spiro[[1,4,2]oxazaphosphole-2,1\\u2032-[2,8,9]trioxa[1]phosphaadamantane]", "systematic_name": "3H-1\\u2032\\u03bb^5-spiro[[1,4,2]oxazaphosphole-2,1\\u2032-[2,8,9]trioxa[1]phosphatricyclo[3.3.1.1^3,7]decane]", "figure": "figure.asset.p_24.8.4.1:clause:0012", "adamantane_policy": "the retained name is preferred to its systematic von Baeyer name"},
