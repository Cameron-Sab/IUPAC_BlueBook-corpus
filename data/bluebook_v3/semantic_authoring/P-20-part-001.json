  "format": "iupac-bluebook-semantic-authoring",
  "format_version": "1.0.0",
  "refs": [
    {"c":[13],"o":"P-20:xref:0002","rel":"invokes"}
  ],
  "symbols": [],
  "tables": [],
  "task_id": "P-20-part-001",
  "units": [
    {
      "id": "parent_hydride_definition",
      "k": "definition",
      "c": [2,3],
      "in": [["parent_hydride","ParentHydride"]],
      "out": [["matches_definition","boolean"]],
      "term": "parent hydride",
      "entity": "ParentHydride",
      "value": ["all",
        ["cmp","eq",["get",["var","parent_hydride"],"named_before_substituent_affix_addition"],true],
        ["cmp","eq",["get",["var","parent_hydride"],"has_definite_hydrogen_population"],true],
        ["cmp","eq",["get",["var","parent_hydride"],"hydrogens_attached_to_skeletal_structure"],true]
      ]
    },
    {
      "id": "acyclic_parent_hydride_requirements",
      "k": "constraint",
      "f": "required",
      "c": [4],
      "in": [["parent_hydride","ParentHydride"]],
      "out": [["valid","boolean"]],
      "assert": ["any",
        ["not",["cmp","eq",["get",["var","parent_hydride"],"topology"],"acyclic"]],
        ["all",
          ["cmp","eq",["get",["var","parent_hydride"],"saturated"],true],
          ["cmp","eq",["get",["var","parent_hydride"],"branched"],false]
        ]
      ],
      "violation": [["reject","parent_hydride","reason.parent_hydride.acyclic_must_be_saturated_unbranched"]]
    },
    {
      "id": "usual_cyclic_parent_hydride_states",
      "k": "definition",
      "c": [5],
      "in": [["parent_hydride","ParentHydride"]],
      "out": [["usual_state","boolean"]],
      "term": "usual cyclic parent hydride saturation state",
      "entity": "ParentHydride",
      "value": ["any",
        ["cmp","eq",["get",["var","parent_hydride"],"saturation_state"],"fully_saturated"],
        ["all",
          ["cmp","eq",["get",["var","parent_hydride"],"saturation_state"],"fully_unsaturated"],
          ["cmp","eq",["get",["var","parent_hydride"],"maximum_noncumulative_double_bonds"],true]
        ]
      ]
    },
    {
      "id": "additional_parent_hydride_classes",
      "k": "definition",
      "c": [6],
      "in": [["parent_hydride","ParentHydride"]],
      "out": [["recognized_class","boolean"]],
      "term": "additional parent hydride class",
      "entity": "ParentHydride",
      "value": ["any",
        ["cmp","eq",["get",["var","parent_hydride"],"saturation_state"],"partially_saturated"],
        ["all",
          ["cmp","eq",["get",["var","parent_hydride"],"topology"],"combined_cyclic_acyclic"],
          ["cmp","eq",["get",["var","parent_hydride"],"name_origin"],"traditional_retained"]
        ]
      ]
    },
    {
      "id": "noncarbon_parent_hydride_name_status",
      "k": "rule",
      "f": "required",
      "c": [7],
      "in": [["parent_hydride","ParentHydride"]],
      "out": [["name_status","NameStatus"],["preferred_iupac_name","boolean"]],
      "if": ["cmp","eq",["get",["var","parent_hydride"],"has_skeletal_carbon"],false],
      "then": [["set","name_status","preselected_name"],["set","preferred_iupac_name",false]],
      "else": []
    },
    {
      "id": "organic_derivative_from_preselected_parent",
      "k": "rule",
      "f": "required",
      "c": [8],
      "in": [["parent_hydride_name_status","NameStatus"],["substituents","SubstituentSet"]],
      "out": [["derivative_name_status","NameStatus"]],
      "if": ["all",
        ["cmp","eq",["var","parent_hydride_name_status"],"preselected_name"],
        ["forall","substituent",["var","substituents"],["cmp","eq",["get",["var","substituent"],"contains_carbon"],true]]
      ],
      "then": [["set","derivative_name_status","preferred_iupac_name"]],
      "else": []
    },
    {
      "id": "inorganic_team_pin_designation",
      "k": "rule",
      "f": "permitted",
      "c": [9],
      "in": [["parent_hydride_name","Name"],["inorganic_pin_team_decision","Decision"]],
      "out": [["name_status","NameStatus"]],
      "if": ["cmp","eq",["var","inorganic_pin_team_decision"],"designated_preferred"],
      "then": [["set","name_status","preferred_iupac_name"]],
      "else": []
    },
    {
      "id": "parent_hydride_name_formation_modes",
      "k": "definition",
      "c": [10],
      "in": [["parent_hydride_name","Name"]],
      "out": [["valid_formation_mode","boolean"]],
      "term": "parent hydride name formation mode",
      "entity": "Name",
      "value": ["any",
        ["cmp","eq",["get",["var","parent_hydride_name"],"formation_mode"],"traditional_retained"],
        ["cmp","eq",["get",["var","parent_hydride_name"],"formation_mode"],"systematic_specific_rules"]
      ]
    },
    {
      "id": "nomenclature_clarity_requirement",
      "k": "constraint",
      "f": "required",
      "c": [11],
      "in": [["rule_or_name","NomenclatureArtifact"]],
      "out": [["valid","boolean"]],
      "assert": ["all",
        ["cmp","eq",["get",["var","rule_or_name"],"unambiguous"],true],
        ["cmp","eq",["get",["var","rule_or_name"],"clear"],true]
      ],
      "violation": [["reject","rule_or_name","reason.nomenclature.must_be_unambiguous_and_clear"]]
    },
    {
      "id": "parent_hydride_selection_rule_location",
      "k": "definition",
      "c": [12,13],
      "out": [["location","RuleLocation"]],
      "term": "location of parent hydride and derived-prefix selection rules",
      "entity": "RuleLocation",
      "value": {
        "chapter": "P-5",
        "provided_in_P-2": false,
        "covers": ["preferred_parent_hydride_names","preselected_parent_hydride_names","derived_substituent_prefixes"],
        "purpose": ["keep_rules_simple","keep_rules_concise"]
      }
    }
  ]
}
