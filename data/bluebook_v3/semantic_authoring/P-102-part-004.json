  "symbols": [
    {
      "id": "compound.is_lactam",
      "k": "predicate",
      "d": "Whether the aldonic cyclic carboxy derivative is a lactam rather than a lactone.",
      "a": [["compound", "AldonicLactoneOrLactam"]],
      "ret": "boolean"
    },
    {
      "id": "compound.is_esterified_glycoside",
      "k": "predicate",
      "d": "Whether the ketoaldonic acid derivative is both glycosidic and esterified.",
      "a": [["compound", "KetoaldonicAcidDerivative"]],
      "ret": "boolean"
    },
    {
      "id": "acid.is_appropriate_for_meso_descriptor",
      "k": "predicate",
      "d": "Whether an aldaric acid has the symmetry for which a meso descriptor adds clarity.",
      "a": [["acid", "AldaricAcid"]],
      "ret": "boolean"
    },
    {
      "id": "replace_name_ending",
      "k": "transformation",
      "d": "Replace a specified ending of a carbohydrate parent name with the prescribed acid-class ending.",
      "a": [["source_name", "name"], ["old_ending", "string"], ["new_ending", "string"]],
      "ret": "name"
    },
    {
      "id": "replace_name_component",
      "k": "transformation",
      "d": "Replace a specified component of a carbohydrate name.",
      "a": [["source_name", "name"], ["old_component", "string"], ["new_component", "string"]],
      "ret": "name"
    },
    {
      "id": "replace_name_component_with_elision",
      "k": "transformation",
      "d": "Replace a carbohydrate name component and elide the specified final letter.",
      "a": [["source_name", "name"], ["old_component", "string"], ["new_component", "string"], ["elided_letter", "string"]],
      "ret": "name"
    }
  ],
  "units": [
    {
      "id": "aldonic_acid_chain_classification",
      "k": "definition",
      "f": "definition",
      "c": [2],
      "in": [["acid", "AldonicAcid"]],
      "out": [["classification", "AldonicAcidClass"]],
      "term": "aldonic acid chain-size class",
      "entity": "acid",
      "value": ["lit", {"basis": "number of carbon atoms in the chain", "classes": ["aldotrionic acid", "aldotetronic acid", "higher homologues"]}]
    },
    {
      "id": "aldonic_acid_name_and_numbering",
      "k": "procedure",
      "f": "required",
      "c": [3, 4],
      "in": [["aldose_name", "AldoseName"]],
      "out": [["acid_name", "AldonicAcidName"]],
      "steps": [
        ["xform", "acid_name", "replace_name_ending", ["var", "aldose_name"], ["lit", "ose"], ["lit", "onic acid"]],
        ["set", "acid_name.carboxy_group_locant", 1],
        ["emit", ["var", "acid_name"]]
      ]
    },
    {
      "id": "aldonic_acid_derivative_treatment",
      "k": "procedure",
      "f": "required",
      "c": [11, 12],
      "in": [["acid", "AldonicAcid"]],
      "out": [["treatment", "CarboxylicAcidDerivativeTreatment"]],
      "steps": [
        ["set", "treatment.parent_name_status", ["lit", "retained"]],
        ["set", "treatment.derivative_classes", ["lit", ["salts", "esters", "anhydrides", "acyl groups", "acid halides", "acid pseudohalides", "amides", "hydrazides", "nitriles", "chalcogen analogues"]]],
        ["set", "treatment.systematic_basis", ["lit", ["P-65", "P-66"]]],
        ["emit", ["var", "treatment"]]
      ]
    },
    {
      "id": "aldonic_lactone_lactam_naming",
      "k": "procedure",
      "f": "required",
      "c": [24, 25, 26, 27, 28, 29],
      "in": [["compound", "AldonicLactoneOrLactam"]],
      "out": [["name", "LactoneOrLactamName"]],
      "steps": [
        ["set", "name.method", ["lit", {"lactone": "adapt P-65.6.3.5.1", "lactam": "adapt P-66.1.5"}]],
        ["set", "name.locants", ["lit", {"first": 1, "first_meaning": "carboxy group position", "second_meaning": "attachment position on the carbon chain"}]],
        ["if", ["pred", "compound.is_lactam", ["var", "compound"]], [["set", "name.required_generated_group", ["lit", {"group": "amino", "formula": "-NH2", "must_be_cited": true}]]], []],
        ["set", "name.greek_ring_size_letters", ["lit", "not recommended"]],
        ["set", "name.alternative", ["lit", {"method": "substitutive nomenclature based on heterocyclic rings", "basis": "P-1 through P-9"}]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "ketoaldonic_acid_name_and_numbering",
      "k": "procedure",
      "f": "required",
      "c": [38, 39],
      "in": [["ketose_name", "KetoseName"], ["ketonic_group_locant", "Locant"]],
      "out": [["acid_name", "KetoaldonicAcidName"]],
      "steps": [
        ["xform", "acid_name", "replace_name_ending", ["var", "ketose_name"], ["lit", "ulose"], ["lit", "ulosonic acid"]],
        ["set", "acid_name.ketonic_group_locant", ["var", "ketonic_group_locant"]],
        ["set", "acid_name.numbering_start", ["lit", "carboxy group"]],
        ["emit", ["var", "acid_name"]]
      ]
    },
    {
      "id": "ketoaldonic_glycoside_and_derivative_naming",
      "k": "procedure",
      "f": "required",
      "c": [45, 46, 47],
      "in": [["compound", "KetoaldonicAcidDerivative"]],
      "out": [["name", "KetoaldonicDerivativeName"]],
      "steps": [
        ["xform", "name", "replace_name_component", ["get", ["var", "compound"], "parent_name"], ["lit", "pyranose"], ["lit", "pyranoside"]],
        ["set", "name.resulting_component", ["lit", "-ulopyranosidonic acid"]],
        ["set", "name.derivative_basis", ["lit", "P-102.5.6.6.2"]],
        ["if", ["pred", "compound.is_esterified_glycoside", ["var", "compound"]], [["set", "name.glycosidic_portion_parenthesized", true]], []],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "uronic_acid_name_and_numbering",
      "k": "procedure",
      "f": "required",
      "c": [52, 53, 54],
      "in": [["aldose_name", "AldoseName"]],
      "out": [["acid_name", "UronicAcidName"]],
      "steps": [
        ["xform", "acid_name", "replace_name_ending", ["var", "aldose_name"], ["lit", "ose"], ["lit", "uronic acid"]],
        ["set", "acid_name.aldose_numbering_retained", true],
        ["set", "acid_name.potential_aldehydic_group_locant", 1],
        ["emit", ["var", "acid_name"]]
      ]
    },
    {
      "id": "uronic_acid_glycoside_naming",
      "k": "procedure",
      "f": "required",
      "c": [62],
      "in": [["acid_name", "UronicAcidName"]],
      "out": [["glycoside_name", "UronicAcidGlycosideName"]],
      "steps": [
        ["xform", "glycoside_name", "replace_name_component_with_elision", ["var", "acid_name"], ["lit", "pyran"], ["lit", "pyranoside"], ["lit", "e"]],
        ["set", "glycoside_name.resulting_component", ["lit", "pyranosiduronic acid"]],
        ["emit", ["var", "glycoside_name"]]
      ]
    },
    {
      "id": "uronic_acid_derivative_naming",
      "k": "procedure",
      "f": "required",
      "c": [66],
      "in": [["derivative", "UronicAcidDerivative"]],
      "out": [["naming_basis", "NamingBasis"]],
      "steps": [
        ["emit", {"applies_to": "derivatives of uronic acid", "basis_rules": ["P-102", "P-65", "P-66"]}]
      ]
    },
    {
      "id": "aldaric_acid_name_and_parent_selection",
      "k": "procedure",
      "f": "required",
      "c": [75, 76],
      "in": [["aldose_name", "AldoseName"], ["candidate_parents", "AldoseParentSet"]],
      "out": [["acid_name", "AldaricAcidName"]],
      "steps": [
        ["xform", "acid_name", "replace_name_ending", ["var", "aldose_name"], ["lit", "ose"], ["lit", "aric acid"]],
        ["set", "acid_name.parent_selection_basis", ["lit", ["P-102.4", "P-102.5.6.5.1"]]],
        ["emit", ["var", "acid_name"]]
      ]
    },
    {
      "id": "aldaric_acid_meso_descriptor",
      "k": "rule",
      "f": "permitted",
      "c": [77, 78, 79],
      "in": [["acid", "AldaricAcid"]],
      "out": [["descriptor", "Stereodescriptor"]],
      "if": ["pred", "acid.is_appropriate_for_meso_descriptor", ["var", "acid"]],
      "then": [["set", "descriptor", ["lit", {"value": "meso", "purpose": "clarity", "status": "may be added"}]]],
      "else": []
    },
    {
      "id": "tartaric_acid_retained_nomenclature",
      "k": "procedure",
      "f": "required",
      "c": [87, 88, 89],
      "in": [["acid", "TartaricAcid"]],
      "out": [["name", "TartaricAcidName"]],
      "steps": [
        ["set", "name.retained_parent", ["lit", {"name": "tartaric acid", "corresponding_parent_aldoses": ["erythrose", "threose"]}]],
        ["set", "name.preferred_configuration_descriptors", ["lit", ["R", "S"]]],
        ["set", "name.salt_and_ester_class_name", ["lit", "tartrates"]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "aldaric_acid_carboxy_derivative_naming",
      "k": "procedure",
      "f": "required",
      "c": [97],
      "in": [["derivative", "AldaricAcidCarboxyDerivative"]],
      "out": [["naming_basis", "NamingBasis"]],
      "steps": [
        ["emit", {"modified_group": "carboxy group", "derivative_classes": ["esters", "amides", "hydrazides", "nitriles", "amic acids", "other carboxy derivatives"], "basis_rules": ["P-102.5.6.6.2.1", "P-65", "P-66"]}]
      ]
    },
    {
      "id": "monosaccharide_anhydride_classification",
      "k": "definition",
      "f": "definition",
      "c": [108],
      "in": [["derivative", "MonosaccharideDerivative"]],
      "out": [["classification", "AnhydrideClass"]],
      "term": "monosaccharide anhydride",
      "entity": "derivative",
      "value": ["lit", {"classes": ["intramolecular", "intermolecular"]}]
    },
    {
      "id": "intramolecular_anhydride_naming",
      "k": "procedure",
      "f": "required",
      "c": [110],
      "in": [["ether", "IntramolecularMonosaccharideEther"]],
      "out": [["name", "IntramolecularAnhydrideName"]],
      "steps": [
        ["set", "name.formal_formation", ["lit", "elimination of water from two hydroxy groups in one monosaccharide or monosaccharide derivative"]],
        ["set", "name.prefix", ["lit", {"value": "anhydro", "detachable": true}]],
        ["set", "name.prefix_locants", ["lit", "pair identifying the two hydroxy groups"]],
        ["set", "name.parent", ["get", ["var", "ether"], "monosaccharide_name"]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "intermolecular_dianhydride_naming",
      "k": "procedure",
      "f": "required",
      "c": [117, 118, 119, 120],
      "in": [["product", "IntermolecularMonosaccharideAnhydride"]],
      "out": [["name", "DianhydrideName"]],
      "steps": [
        ["set", "name.formation", ["lit", "cyclic condensation product of two monosaccharides with elimination of two water molecules"]],
        ["set", "name.parent_order", ["lit", {"different_parents": "senior parent under P-102.4 first", "identical_parents": "source order"}]],
        ["set", "name.link_locants", ["lit", {"per_link": "pair for the two hydroxy positions", "mixed_anhydride": "locants of the second-named monosaccharide are primed"}]],
        ["set", "name.terminal_term", ["lit", "dianhydride"]],
        ["set", "name.locant_position", ["lit", "immediately before dianhydride"]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "glycosyl_group_formation_and_notation",
      "k": "procedure",
      "f": "required",
      "c": [130, 131, 132, 133, 134],
      "in": [["monosaccharide", "CyclicMonosaccharide"]],
      "out": [["substituent", "GlycosylGroup"]],
      "steps": [
        ["set", "substituent.formation", ["lit", "remove the anomeric hydroxy group"]],
        ["xform", "substituent.name", "replace_name_ending", ["get", ["var", "monosaccharide"], "name"], ["lit", "e"], ["lit", "yl"]],
        ["set", "substituent.term", ["lit", "glycosyl residue"]],
        ["set", "substituent.uses", ["lit", ["glycosides when not parent structures", "oligosaccharides"]]],
        ["set", "substituent.free_valence_locant", ["lit", "omitted"]],
        ["set", "substituent.free_valence_depiction", ["lit", "sinuous line"]],
        ["emit", ["var", "substituent"]]
      ]
    },
    {
      "id": "c1_hydrogen_subtraction_glycosyl_naming",
      "k": "procedure",
      "f": "required",
      "c": [138, 139],
      "in": [["monosaccharide", "CyclicMonosaccharide"]],
      "out": [["substituent", "C1HydrogenSubtractionGlycosylGroup"]],
      "steps": [
        ["set", "substituent.free_valence_formation", ["lit", "subtract hydrogen from carbon 1"]],
        ["set", "substituent.name_class", ["lit", "glycosyl group"]],
        ["set", "substituent.carbon_1_hydroxy_group", ["lit", "denoted by substitution at carbon 1"]],
        ["set", "substituent.anomeric_descriptor_reference", ["lit", "free valence, not the hydroxy group"]],
        ["emit", ["var", "substituent"]]
      ]
    },
    {
      "id": "o_glycosyl_compound_naming",
      "k": "procedure",
      "f": "required",
      "c": [144, 145],
      "in": [["compound", "OGlycosylCompound"]],
      "out": [["name", "OGlycosylCompoundName"]],
      "steps": [
        ["set", "name.compound_substituent", ["lit", {"formation": "remove hydrogen from the anomeric hydroxy group", "components": ["glycosyl group", "oxy group"]}]],
        ["set", "name.parent_component", ["lit", "the monosaccharide or aglycone component bearing the senior principal characteristic group"]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "o_glycosyl_amide_seniority_explanation",
      "k": "procedure",
      "f": "required",
      "c": [157, 158],
      "in": [["compound", "OGlycosylAmide"]],
      "out": [["seniority_result", "CharacteristicGroupSeniority"]],
      "steps": [
        ["set", "seniority_result.principal_function", ["lit", "amide"]],
        ["set", "seniority_result.preferred_amide_parent", ["lit", "cyclic amide benzamide"]],
        ["set", "seniority_result.lower_ranked_amide", ["lit", "acyclic amide propanamide"]],
        ["emit", ["var", "seniority_result"]]
      ]
    },
    {
      "id": "n_glycosyl_derivative_naming",
      "k": "procedure",
      "f": "required",
      "c": [160],
      "in": [["derivative", "NGlycosylDerivative"]],
      "out": [["name", "GlycosylamineName"]],
      "steps": [["set", "name.class", ["lit", "glycosylamine"]], ["emit", ["var", "name"]]]
    }
  ],
  "exceptions": [],
  "tables": [],
  "figures": [],
  "examples": [
    {"id": "galactonic_acid", "c": [6], "input": {"caption": "D-galactonic acid"}, "ok": ["D-galactonic acid"], "bad": [], "shows": [["semantic_unit", "aldonic_acid_name_and_numbering"]], "why": "Aldose ending replacement gives the aldonic acid name."},
    {"id": "deoxy_methylamino_gluconic_acid", "c": [8], "input": {"caption": "2-deoxy-2-(methylamino)-D-gluconic acid"}, "ok": ["2-deoxy-2-(methylamino)-D-gluconic acid"], "bad": [], "shows": [["semantic_unit", "aldonic_acid_name_and_numbering"]], "why": "The substituted aldonic acid retains the gluconic acid parent form."},
    {"id": "propan_2_yl_gluconate", "c": [14], "input": {"caption": "propan-2-yl D-gluconate"}, "ok": ["propan-2-yl D-gluconate"], "bad": [], "shows": [["semantic_unit", "aldonic_acid_derivative_treatment"]], "why": "An aldonic acid ester is named by carboxylic-acid derivative methods."},
    {"id": "methyl_dimethyl_galactonate", "c": [16], "input": {"caption": "methyl 3,4-di-O-methyl-D-galactonate"}, "ok": ["methyl 3,4-di-O-methyl-D-galactonate"], "bad": [], "shows": [["semantic_unit", "aldonic_acid_derivative_treatment"]], "why": "The ester class and O-substitution are retained."},
    {"id": "xylonamide", "c": [18], "input": {"caption": "L-xylonamide"}, "ok": ["L-xylonamide"], "bad": [], "shows": [["semantic_unit", "aldonic_acid_derivative_treatment"]], "why": "An amide is an allowed aldonic-acid derivative class."},
    {"id": "methyl_deoxy_pentonate", "c": [20], "input": {"caption": "methyl 3-deoxy-D-threo-pentonate"}, "ok": ["methyl 3-deoxy-D-threo-pentonate"], "bad": [], "shows": [["semantic_unit", "aldonic_acid_derivative_treatment"]], "why": "The ester form follows retained aldonic-acid treatment."},
