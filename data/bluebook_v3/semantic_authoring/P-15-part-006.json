  "units": [
    {"id":"side_chain_selection","k":"procedure","f":"preference","c":[33,34,35,36],"steps":[["emit","Choose the chain containing the principal characteristic group for conjunctive nomenclature; if more than one side chain contains that group, choose the conjunctive name expressing the greater number of principal characteristic groups. When necessary, select side chains by the seniority order for selecting the principal chain (see P-44.3)."]]},
    {"id":"conjunctive_nomenclature_limitations","k":"constraint","f":"required","c":[47,48,49,50,51,52,53],"assert":["lit",true],"violation":[["emit","Do not use conjunctive nomenclature when a double bond links the acyclic component to the ring system; when a double bond or heteroatom is present in the side chain; when two identical characteristic groups are located on the side chain without violating the maximum-number condition; when higher-priority characteristic groups are directly attached to the cyclic component; or when two or more characteristic groups of the principal kind are located on the ring or ring system. Use normal substitutive nomenclature in these cases."]]},
    {"id":"pin_note","k":"procedure","f":"required","c":[66],"steps":[["emit","Note: The PIN is the substitutive name."]]},
    {"id":"analysis_heading","k":"procedure","f":"required","c":[69],"steps":[["emit","Analysis:"]]},
