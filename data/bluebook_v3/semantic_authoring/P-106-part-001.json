  "symbols": [],
  "units": [
    {
      "id": "nucleotide_name_reference_context",
      "k": "definition",
      "f": "definition",
      "c": [4],
      "out": [["reference_context", "NucleotideNamingReference"]],
      "term": "nucleotide naming reference context",
      "entity": "NucleotideNamingReference",
      "value": ["lit", {"document": "Abbreviations and Symbols for Nucleic Acids, Polynucleotides and their Constituents", "role": "source of examples for nucleotide names"}]
    },
    {
      "id": "nucleotide_derivative_adaptation",
      "k": "procedure",
      "f": "required",
      "c": [5],
      "in": [["derivative", "NucleotideDerivative"]],
      "out": [["naming_basis", "NucleotideDerivativeNamingBasis"]],
      "steps": [
        ["set", "naming_basis", ["lit", {"carbohydrate_moiety_modifications": "P-102", "other_substitution": "general rules for substitution of organic compounds"}]]
      ]
    },
    {
      "id": "traditional_nucleotide_ester_names",
      "k": "definition",
      "f": "definition",
      "c": [7],
      "out": [["name_class", "NucleotideEsterNameClass"]],
      "term": "traditional names for nucleoside phosphate esters",
      "entity": "NucleotideEsterNameClass",
      "value": ["lit", {"substance": "esters of nucleosides with phosphoric acid", "status": "traditional names"}]
    },
    {
      "id": "primed_locant_phosphate_position",
      "k": "rule",
      "f": "required",
      "c": [8],
      "in": [["ribosyl_component", "RibosylComponent"]],
      "out": [["phosphate_position", "Locant"]],
      "if": ["lit", true],
      "then": [["set", "phosphate_position", ["get", ["var", "ribosyl_component"], "primed_locant"]]],
      "else": []
    },
    {
      "id": "nucleoside_polyphosphate_name_order",
      "k": "rule",
      "f": "required",
      "c": [24],
      "in": [["nucleoside", "Nucleoside"], ["polyphosphate", "Polyphosphate"]],
      "out": [["name", "Name"]],
      "if": ["lit", true],
      "then": [
        ["render", "polyphosphate_phrase", "after_nucleoside", ["get", ["var", "polyphosphate"], "phrase"]]
      ],
      "else": []
    },
    {
      "id": "polyphosphate_hydrogen_indication",
      "k": "rule",
      "f": "required",
      "c": [25],
      "in": [["polyphosphate", "Polyphosphate"]],
      "out": [["hydrogen_qualifier", "HydrogenQualifier"]],
      "if": ["cmp", "eq", ["get", ["var", "polyphosphate"], "has_hydrogen_atoms"], true],
      "then": [["set", "hydrogen_qualifier", ["get", ["var", "polyphosphate"], "hydrogen_word"]]],
      "else": []
    },
    {
      "id": "polyphosphate_parentheses_requirement",
      "k": "constraint",
      "f": "required",
      "c": [26],
      "in": [["name", "Name"]],
      "assert": ["cmp", "eq", ["get", ["var", "name"], "uses_parentheses_to_avoid_ambiguity"], true],
      "violation": [["reject", "name", "reason.polyphosphate_parentheses_required_for_clarity"]]
    },
    {
      "id": "retained_nucleotide_derivative_modification_rule",
      "k": "rule",
      "f": "permitted",
      "c": [33, 34],
      "in": [["derivative", "RetainedNucleotideDerivative"]],
      "out": [["allowed_modifications", "ModificationPolicy"]],
      "if": ["cmp", "eq", ["get", ["var", "derivative"], "has_retained_nucleotide_name"], true],
      "then": [["set", "allowed_modifications", ["lit", {"naming_basis": "same manner as the corresponding nucleoside", "purine_or_pyrimidine_ring": "fully substituted", "ribofuranosyl_component": "modified as prescribed for carbohydrates", "ribose_modifications": ["2-deoxy", "3-deoxy"]}]]],
      "else": []
    },
    {
      "id": "nucleotide_polyphosphate_functional_replacement",
      "k": "rule",
      "f": "permitted",
      "c": [42, 44, 46, 47],
      "in": [["analogue", "NucleosidePolyphosphateAnalogue"]],
      "out": [["naming_technique", "NamingTechnique"]],
      "if": ["cmp", "eq", ["get", ["var", "analogue"], "is_nucleoside_di_or_polyphosphate_analogue"], true],
      "then": [["set", "naming_technique", "functional_replacement_for_di_and_polyphosphoric_acids"]],
      "else": []
    },
    {
      "id": "nucleotide_characteristic_group_substitution",
      "k": "procedure",
      "f": "required",
      "c": [49, 50, 51, 52],
      "in": [["nucleotide", "Nucleotide"], ["characteristic_group", "CharacteristicGroup"]],
      "out": [["substitutive_prefix", "Prefix"]],
      "steps": [
        ["set", "substitutive_prefix", ["lit", {"higher_priority_group": "apply normal substitutive nomenclature", "general_derivation": "replace the ic acid ending of the traditional monophosphate name with yl", "examples": ["adenylyl", "cytidylyl"], "inosine_exception": "inosinylyl"}]]
      ]
    },
    {
      "id": "oligonucleotide_prefix_naming",
      "k": "procedure",
      "f": "required",
      "c": [58, 60],
      "in": [["oligonucleotide", "Oligonucleotide"]],
      "out": [["name", "Name"]],
      "steps": [
        ["set", "name", ["lit", {"method": "use prefix names derived from traditional nucleotide names", "linkage": "3-prime to 5-prime"}]]
      ]
    },
    {
      "id": "phosphorothioic_acid_prefix",
      "k": "rule",
      "f": "required",
      "c": [62, 64],
      "in": [["nucleotide", "Nucleotide"]],
      "out": [["name", "Name"]],
      "if": ["cmp", "eq", ["get", ["var", "nucleotide"], "uses_phosphorothioic_acid"], true],
      "then": [["render", "nucleotide_prefix", "front", "P-thio"]],
      "else": []
    }
  ],
