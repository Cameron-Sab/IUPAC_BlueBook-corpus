  "examples": [
    {"id": "adenylic_acid", "c": [9], "input": {"nucleotide": "adenosine phosphate ester", "locant": "5'"}, "ok": ["5'-adenylic acid"], "bad": [], "shows": [["semantic_unit", "traditional_nucleotide_ester_names"]], "why": "The caption gives a traditional nucleotide ester name."},
    {"id": "thymidylic_acid", "c": [11], "input": {"nucleotide": "thymidine phosphate ester", "locant": "5'"}, "ok": ["5'-thymidylic acid"], "bad": [], "shows": [["semantic_unit", "traditional_nucleotide_ester_names"]], "why": "The caption gives a traditional nucleotide ester name."},
    {"id": "guanylic_acid", "c": [13], "input": {"nucleotide": "guanosine phosphate ester", "locant": "5'"}, "ok": ["5'-guanylic acid"], "bad": [], "shows": [["semantic_unit", "traditional_nucleotide_ester_names"]], "why": "The caption gives a traditional nucleotide ester name."},
    {"id": "inosinic_acid", "c": [15], "input": {"nucleotide": "inosine phosphate ester", "locant": "5'"}, "ok": ["5'-inosinic acid"], "bad": [], "shows": [["semantic_unit", "traditional_nucleotide_ester_names"]], "why": "The caption gives a traditional nucleotide ester name."},
    {"id": "xanthylic_acid", "c": [17], "input": {"nucleotide": "xanthosine phosphate ester", "locant": "3'"}, "ok": ["3'-xanthylic acid"], "bad": [], "shows": [["semantic_unit", "traditional_nucleotide_ester_names"]], "why": "The caption gives a traditional nucleotide ester name."},
    {"id": "cytidylic_acid", "c": [19], "input": {"nucleotide": "cytidine phosphate ester", "locant": "5'"}, "ok": ["5'-cytidylic acid"], "bad": [], "shows": [["semantic_unit", "traditional_nucleotide_ester_names"]], "why": "The caption gives a traditional nucleotide ester name."},
    {"id": "uridylic_acid", "c": [21], "input": {"nucleotide": "uridine phosphate ester", "locant": "5'"}, "ok": ["5'-uridylic acid"], "bad": [], "shows": [["semantic_unit", "traditional_nucleotide_ester_names"]], "why": "The caption gives a traditional nucleotide ester name."},
    {"id": "uridine_tetrahydrogen_triphosphate", "c": [28], "input": {"nucleoside": "uridine", "locant": "5'", "hydrogen_qualifier": "tetrahydrogen", "component": "triphosphate"}, "ok": ["uridine 5'-(tetrahydrogen triphosphate)"], "bad": [], "shows": [["semantic_unit", "nucleoside_polyphosphate_name_order"]], "why": "Parentheses disambiguate the polyphosphate phrase."},
    {"id": "xanthosine_trihydrogen_diphosphate", "c": [30], "input": {"nucleoside": "xanthosine", "locant": "3'", "hydrogen_qualifier": "trihydrogen", "component": "diphosphate"}, "ok": ["xanthosine 3'-(trihydrogen diphosphate)"], "bad": [], "shows": [["semantic_unit", "nucleoside_polyphosphate_name_order"]], "why": "The example illustrates the hydrogen qualifier and parenthesized component."},
    {"id": "modified_adenylic_acid", "c": [36], "input": {"modification": "2',3'-O-[(1S,2E)-3-phenylprop-2-ene-1,1-diyl]", "nucleotide": "5'-adenylic acid"}, "ok": ["2',3'-O-[(1S,2E)-3-phenylprop-2-ene-1,1-diyl]-5'-adenylic acid"], "bad": [], "shows": [["semantic_unit", "retained_nucleotide_derivative_modification_rule"]], "why": "The retained nucleotide name is modified on the ribofuranosyl component."},
    {"id": "propylcarbamoyl_adenylic_acid", "c": [38], "input": {"modification": "N6-(propylcarbamoyl)", "nucleotide": "5'-adenylic acid"}, "ok": ["N6-(propylcarbamoyl)-5'-adenylic acid"], "bad": [], "shows": [["semantic_unit", "retained_nucleotide_derivative_modification_rule"]], "why": "The purine ring is fully substitutable under the retained-name rule."},
    {"id": "acetyl_deoxyguanosine_diphosphate", "c": [40], "input": {"modifications": ["5'-O-acetyl", "2'-deoxy"], "nucleotide": "guanosine 3'-(trihydrogen diphosphate)"}, "ok": ["5'-O-acetyl-2'-deoxyguanosine 3'-(trihydrogen diphosphate)", "2'-deoxyguanosine 5'-acetate 3'-(trihydrogen diphosphate)"], "bad": [], "shows": [["semantic_unit", "retained_nucleotide_derivative_modification_rule"]], "why": "The example combines a ribose deoxy modification, substitution, and phosphate ester."},
    {"id": "thiodiphosphate", "c": [44], "input": {"analogue": "adenosine polyphosphate", "replacement": "2-thio"}, "ok": ["adenosine 5'-(trihydrogen 2-thiodiphosphate)"], "bad": [], "shows": [["semantic_unit", "nucleotide_polyphosphate_functional_replacement"]], "why": "Functional replacement techniques are applied to a nucleoside polyphosphate analogue."},
    {"id": "carbadiphosphate", "c": [46, 47], "input": {"analogue": "guanosine polyphosphate", "replacement": "methylene or carbon"}, "ok": ["guanosine 5'-[hydrogen (phosphonomethyl)phosphonate]", "guanosine 5'-(trihydrogen methylenediphosphonate)", "guanosine 5'-(trihydrogen 2-carbadiphosphate)"], "bad": [], "shows": [["semantic_unit", "nucleotide_polyphosphate_functional_replacement"]], "why": "The alternative names preserve the integrity of the nucleotide name."},
    {"id": "guanylyloxy_benzoic_acid", "c": [54], "input": {"substituent": "5'-guanylyloxy"}, "ok": ["3-(5'-guanylyloxy)benzoic acid"], "bad": [], "shows": [["semantic_unit", "nucleotide_characteristic_group_substitution"]], "why": "The substitutive prefix is derived from the traditional monophosphate name."},
    {"id": "adenylyl_sulfate", "c": [56], "input": {"substituent": "5'-adenylyl", "characteristic_group": "sulfate"}, "ok": ["3'-O-phosphonato-5'-adenylyl sulfate", "3'-phospho-5'-adenylyl sulfate"], "bad": [], "shows": [["semantic_unit", "nucleotide_characteristic_group_substitution"]], "why": "The example illustrates normal substitutive treatment in the presence of a higher-priority group."},
    {"id": "oligonucleotide", "c": [60], "input": {"sequence": "2'-deoxyguanylyl-(3'->5')-2'-deoxyuridylyl-(3'->5')-2'-deoxyguanosine"}, "ok": ["2'-deoxyguanylyl-(3'->5')-2'-deoxyuridylyl-(3'->5')-2'-deoxyguanosine"], "bad": [], "shows": [["semantic_unit", "oligonucleotide_prefix_naming"]], "why": "The name uses nucleotide-derived prefixes and 3-prime to 5-prime linkages."},
    {"id": "phosphorothioate_oligonucleotide", "c": [64], "input": {"sequence": "deoxyguanylyl and deoxyuridylyl", "phosphate_residue": "phosphorothioic acid"}, "ok": ["2'-deoxy-P-thioguanylyl-(3'->5')-2'-deoxy-P-thiouridylyl-(3'->5')-2'-deoxyguanosine"], "bad": [], "shows": [["semantic_unit", "phosphorothioic_acid_prefix"]], "why": "P-thio is added at the front of the nucleotide name when HS-P replaces HO-P."}
  ],
