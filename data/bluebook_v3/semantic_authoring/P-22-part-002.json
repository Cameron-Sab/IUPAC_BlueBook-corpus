      "out": [["name", "ParentHydrideName"]],
      "steps": [["set", "name", ["lit", {"condition": "more than ten ring members and maximum number of noncumulative double bonds", "operation": "change the ending 'ane' of the corresponding saturated heteromonocycle to 'ine'"}]]]
