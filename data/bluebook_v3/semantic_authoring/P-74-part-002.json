    {"id": "p742216_example", "c": [5], "input": "propan-2-one oxide", "ok": ["2-(propan-2-ylidene)dioxidan-2-ium-1-ide (PIN)", "propan-2-one oxide"], "shows": [["figure", "figure.asset.p_74.2.2.1.6:clause:0006"]], "why": "The displayed compound is named by the method giving the preferred IUPAC name and by the alternative name."},
    {"id": "p742217_example", "c": [11], "input": "propan-2-one oxide analogue", "ok": ["2-[(propan-2-ylidene)oxidaniumyl]propan-2-ide (PIN)", "2-[(propan-2-ylidene)oxoniumyl]propan-2-ide"], "shows": [["figure", "figure.asset.p_74.2.2.1.7:clause:0006"]], "why": "The example gives the preferred IUPAC name and the alternative oxoniumyl name."},
    {"id": "p742218_propylidene_example", "c": [17], "input": "propanethial oxide", "ok": ["propylidene-lambda4-sulfanone (PIN)", "propanethial oxide", "(propylidenesulfaniumyl)oxidanide", "1-(oxo-lambda4-sulfanylidene)propane"], "shows": [["figure", "figure.asset.p_74.2.2.1.8:clause:0006"]], "why": "The displayed sulfur oxide is named by the preferred method and the listed alternatives."},
    {"id": "p742218_thiophene_example", "c": [19], "input": "thiophene oxide", "ok": ["1H-1-lambda4-thiophen-1-one (PIN)", "thiophene oxide", "(thiophen-1-ium-1-yl)oxidanide", "1-oxo-1H-1-lambda4-thiophene"], "shows": [["figure", "figure.asset.p_74.2.2.1.8:clause:0008"]], "why": "The example illustrates the preferred and alternative names for thiophene oxide."},
    {"id": "p742218_thiazole_example", "c": [21], "input": "1,2-thiazole oxide", "ok": ["1H-1-lambda4,2-thiazol-1-one (PIN)", "1,2-thiazole 1-oxide", "1,2-thiazole S-oxide"], "shows": [["figure", "figure.asset.p_74.2.2.1.8:clause:0010"]], "why": "The example illustrates the preferred and alternative names for the thiazole oxide."},
    {"id": "p742219_example", "c": [28], "input": "N-methylpropan-2-imine N-oxide", "ok": ["N-methylpropan-2-imine N-oxide (PIN)", "[methyl(propan-2-ylidene)azaniumyl]oxidanide"], "shows": [["figure", "figure.asset.p_74.2.2.1.9:clause:0007"]], "why": "The example gives the preferred imine N-oxide name and its zwitterionic alternative."},
    {"id": "p7422110_example", "c": [33, 34], "input": "CH3-CH2-NO2", "ok": ["nitroethane (PIN)"], "shows": [["figure", "figure.asset.p_74.2.2.1.10:clause:0003"]], "why": "The table example relates the displayed formula to nitroethane (PIN)."},
    {"id": "p7422211_example", "c": [44], "input": "acetonitrile methylimide", "ok": ["2-ethylidyne-1-methylhydrazin-2-ium-1-ide (PIN)", "acetonitrile methylimide"], "shows": [["figure", "figure.asset.p_74.2.2.2.1.1:clause:0005"]], "why": "Method (1), the zwitterionic name, is preferred."},
    {"id": "p7422212_oxide_example", "c": [49], "input": "acetonitrile oxide", "ok": ["acetonitrile oxide (PIN)", "(ethylidyneazaniumyl)oxidanide"], "shows": [["figure", "figure.asset.p_74.2.2.2.1.2:clause:0005"]], "why": "The functional class name is preferred for this oxide."},
    {"id": "p7422212_sulfide_example", "c": [51], "input": "acetonitrile sulfide", "ok": ["acetonitrile sulfide (PIN)", "(ethylidyneazaniumyl)sulfanide"], "shows": [["figure", "figure.asset.p_74.2.2.2.1.2:clause:0007"]], "why": "The functional class name is preferred for this sulfide."},
    {"id": "p7422213_example", "c": [56], "input": "acetonitriliumyl propan-2-ide", "ok": ["2-(acetonitriliumyl)propan-2-ide (PIN)", "2-(ethylidyneammoniumyl)propan-2-ide"], "shows": [["figure", "figure.asset.p_74.2.2.2.1.3:clause:0005"]], "why": "The zwitterionic name is the preferred IUPAC name."},
    {"id": "p742222_azide_example", "c": [64], "input": "azidobenzene", "ok": ["azidobenzene (PIN)", "phenyl azide", "3-phenyltriazadien-2-ium-1-ide"], "shows": [["figure", "figure.asset.p_74.2.2.2.2:clause:0008"]], "why": "The compulsory prefix azido method yields the preferred IUPAC name."},
    {"id": "p742223_diazo_example", "c": [71], "input": "diazomethane", "ok": ["diazomethane (PIN)", "methylidenediazen-2-ium-1-ide"], "shows": [["figure", "figure.asset.p_74.2.2.2.3:clause:0007"]], "why": "The compulsory prefix diazo method yields the preferred IUPAC name."},
    {"id": "p742231_example", "c": [77], "input": "3-oxopentan-2-ylidene", "ok": ["3-oxopentan-2-ylidene (PIN)"], "shows": [["figure", "figure.asset.p_74.2.2.3.1:clause:0004"]], "why": "The example illustrates the preferred ylidene name."},
    {"id": "p742232_example", "c": [87], "input": "an imidoyl carbene", "ok": ["3-(methylimino)butan-2-ylidene (PIN)"], "shows": [["figure", "figure.asset.p_74.2.2.3.2:clause:0010"]], "why": "The longest-chain radical method gives the preferred IUPAC name."},
    {"id": "p742233_example", "c": [94], "input": "an azanylidene, nitrene or aminylene derivative", "ok": ["(N-methylethanimidoyl)azanylidene (PIN)", "(N-methylacetimidoyl)nitrene", "(N-methylacetimidoyl)aminylene"], "shows": [["figure", "figure.asset.p_74.2.2.3.3:clause:0007"]], "why": "Azanylidene is the preferred parent name; nitrene and aminylene are alternatives."},
    {"id": "p742234_example", "c": [99], "input": "prop-2-en-1-ylidene", "ok": ["prop-2-en-1-ylidene (PIN)"], "shows": [["figure", "figure.asset.p_74.2.2.3.4:clause:0005"]], "why": "The suffix ylidene receives the low locant in the preferred name."},
    {"id": "p7423_phosphoniumyl_example", "c": [104], "input": "a dipolar substituent group containing oxidodi(phenyl)phosphaniumyl", "ok": ["2-{4-[oxidodi(phenyl)phosphaniumyl]phenyl}propane-1,3-diyl (PIN)", "2-{4-[oxidodi(phenyl)phosphoniumyl]phenyl}propane-1,3-diyl"], "shows": [["figure", "figure.asset.p_74.2.3:clause:0005"]], "why": "The ionic prefix and the free-valence suffix ylyl are used for the dipolar substituent group."},
    {"id": "p7423_ylidyne_example", "c": [106], "input": "a dipolar substituent group containing oxidoazaniumylidyne", "ok": ["2-{4-[2-(oxidoazaniumylidyne)ethyl]phenyl}propane-1,3-diyl (PIN)", "2-{4-[2-(oxidoammoniumylidyne)ethyl]phenyl}propane-1,3-diyl"], "shows": [["figure", "figure.asset.p_74.2.3:clause:0007"]], "why": "The free valence is designated by the suffix ylydyne in the preferred ionic-prefix name."}
