    {
      "id": "traditional_salt_naming_methods",
      "k": "definition",
      "f": "definition",
      "c": [16, 17, 18, 19, 20],
      "term": "traditional methods for naming salts of organic bases",
      "entity": "SaltNamingMethodSet",
      "value": ["lit", {
        "condition": "P-77.1.2 cannot be applied",
        "methods": [
          {"ordinal": 1, "method": "adduct", "preferred_name_condition": "the acid components of the adducts are organic compounds"},
          {"ordinal": 2, "method": "unaltered base followed by the name of the anion"},
          {"ordinal": 3, "method": "unaltered base followed by a hydrohalide name", "only_for": "salts of hydrohalogen acids", "hydrohalide_names": ["hydrofluoride", "hydrobromide", "hydrochloride", "hydroiodide"]}
        ],
        "source_text": [
          "(1) as adducts.",
          "The names of these adducts are preferred IUPAC names only when the acid components of the adducts are organic compounds;",
          "(2) the unaltered name of the base followed by the name of the anion;",
          "(3) for salts of hydrohalogen acids only, the unaltered name of the base is followed by hydrofluoride, hydrobromide, hydrochloride, or hydroiodide, as the case may be."
        ]
      }]
    }
