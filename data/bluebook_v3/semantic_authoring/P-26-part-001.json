  "symbols": [
    {"id": "amplificant.has_locants", "k": "predicate", "d": "Whether a heterocyclic amplificant requires locants in its rendered prefix.", "a": [["amplificant", "HeterocyclicAmplificant"]], "ret": "boolean"},
    {"id": "phane.preserved_amplificant_attachment_bonds_remain", "k": "predicate", "d": "Whether bonds joining an amplificant to the surrounding skeleton are preserved through simplification and amplification.", "a": [["parent", "PhaneParentSkeleton"], ["simplified", "SimplifiedPhaneParentGraph"]], "ret": "boolean"},
    {"id": "phane.amplificants_have_expressible_amplification_prefixes", "k": "predicate", "d": "Whether every selected amplificant can be represented by an allowed amplification prefix.", "a": [["skeleton", "SimplifiedPhaneParentGraph"]], "ret": "boolean"},
    {"id": "parent.is_mancude_monocycle_or_polycycle", "k": "predicate", "d": "Whether a parent is an allowed mancude monocyclic ring or polycyclic ring system.", "a": [["parent", "ParentHydride"]], "ret": "boolean"},
    {"id": "parent.is_bridged_fused_ring_system", "k": "predicate", "d": "Whether a parent is an allowed bridged fused ring system.", "a": [["parent", "ParentHydride"]], "ret": "boolean"},
    {"id": "parent.is_saturated_monocycle", "k": "predicate", "d": "Whether a parent is an allowed saturated monocyclic ring.", "a": [["parent", "ParentHydride"]], "ret": "boolean"},
    {"id": "parent.is_saturated_von_baeyer_hydrocarbon", "k": "predicate", "d": "Whether a parent is an allowed saturated bicycloalkane or polycycloalkane named by von Baeyer nomenclature.", "a": [["parent", "ParentHydride"]], "ret": "boolean"},
    {"id": "parent.is_spiro_alkane", "k": "predicate", "d": "Whether a parent is an allowed spiro alkane.", "a": [["parent", "ParentHydride"]], "ret": "boolean"},
    {"id": "parent.is_stereoparent", "k": "predicate", "d": "Whether a parent is an allowed stereoparent such as gonane or morphinan.", "a": [["parent", "ParentHydride"]], "ret": "boolean"},
    {"id": "name.is_spirobi_name", "k": "predicate", "d": "Whether a candidate is a spirobi parent hydride name.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.is_spiro_with_fused_or_polycycloalkane_component", "k": "predicate", "d": "Whether a spiro candidate contains a fused-ring or polycycloalkane component.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.is_ring_assembly_name", "k": "predicate", "d": "Whether a candidate is a ring-assembly name.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.has_hydro_prefix_modification", "k": "predicate", "d": "Whether a candidate parent name is modified by hydro prefixes.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.has_ene_or_yne_ending_modification", "k": "predicate", "d": "Whether a candidate parent name is modified by ene or yne endings.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.has_skeletal_replacement_terms", "k": "predicate", "d": "Whether a candidate parent name contains skeletal-replacement a terms.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.has_characteristic_group_suffix", "k": "predicate", "d": "Whether a candidate parent name is modified by a characteristic-group suffix.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.has_substitutive_prefix", "k": "predicate", "d": "Whether a candidate parent name is modified by a substitutive prefix.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.is_retained_functional_parent_name", "k": "predicate", "d": "Whether a candidate is a retained functional-parent name.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.is_functional_class_name", "k": "predicate", "d": "Whether a candidate cyclic compound name was formed by functional-class nomenclature.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "name.is_retained_partially_hydrogenated_parent_name", "k": "predicate", "d": "Whether a candidate is a retained partially hydrogenated parent hydride name.", "a": [["name", "ParentStructureName"]], "ret": "boolean"},
    {"id": "prefix.is_simple_amplification_prefix", "k": "predicate", "d": "Whether an amplification prefix is simple and accepts di, tri, tetra, and higher simple multiplicative terms.", "a": [["prefix", "AmplificationPrefix"]], "ret": "boolean"},
    {"id": "prefix.begins_with_multiplying_prefix", "k": "predicate", "d": "Whether an amplification prefix already begins with a multiplying prefix.", "a": [["prefix", "AmplificationPrefix"]], "ret": "boolean"},
    {"id": "prefix.begins_with_multipliable_name_component", "k": "predicate", "d": "Whether the first name component could itself take a multiplying prefix and therefore requires bis, tris, or tetrakis.", "a": [["prefix", "AmplificationPrefix"]], "ret": "boolean"},
    {"id": "simplified_skeleton.is_linear", "k": "predicate", "d": "Whether a simplified phane skeleton is unbranched and acyclic.", "a": [["skeleton", "SimplifiedPhaneParentGraph"]], "ret": "boolean"},
    {"id": "amplificant.enclose_in_brackets", "k": "transformation", "d": "Enclose a locanted heterocyclic amplificant in brackets.", "a": [["amplificant", "HeterocyclicAmplificant"]], "ret": "AmplificantRendering"},
    {"id": "phane.simplify_significant_cyclic_segments_to_superatoms", "k": "transformation", "d": "Replace nomenclaturally significant cyclic segments by superatoms to form the simplified phane parent graph.", "a": [["parent", "PhaneParentSkeleton"]], "ret": "SimplifiedPhaneParentGraph"},
    {"id": "phane.combine_skeletal_name_and_amplification_prefixes", "k": "transformation", "d": "Combine a simplified skeletal name with amplification prefixes and their superatom and attachment locants.", "a": [["skeleton", "SimplifiedPhaneParentGraph"]], "ret": "PhaneParentName"},
    {"id": "phane.compose_simplified_skeletal_name", "k": "transformation", "d": "Compose a simplified skeletal name from topology, node count, and the term phane.", "a": [["skeleton", "SimplifiedPhaneParentGraph"], ["options", "SimplifiedSkeletalNameOptions"]], "ret": "SimplifiedSkeletalName"},
    {"id": "phane.apply_structure_class_numbering", "k": "transformation", "d": "Apply the Chapter P-2 numbering system for the simplified skeleton's structure class.", "a": [["skeleton", "SimplifiedPhaneParentGraph"], ["authority", "string"]], "ret": "SkeletalNumbering"},
    {"id": "phane.assign_lowest_superatom_locant_set", "k": "transformation", "d": "Choose the lowest superatom locant set by first point of difference.", "a": [["numbering", "SkeletalNumbering"], ["criterion", "string"]], "ret": "SkeletalNumbering"},
    {"id": "prefix.apply_simple_multiplicative_term", "k": "transformation", "d": "Apply the appropriate simple multiplicative term to a simple amplification prefix.", "a": [["prefix", "AmplificationPrefix"], ["multiplicity", "integer"], ["terms", "MultiplicativeTermSet"]], "ret": "AmplificationPrefix"},
    {"id": "prefix.apply_complex_multiplicative_term", "k": "transformation", "d": "Apply bis, tris, tetrakis, or the corresponding higher term to a complex amplification prefix.", "a": [["prefix", "AmplificationPrefix"], ["multiplicity", "integer"], ["terms", "MultiplicativeTermSet"]], "ret": "AmplificationPrefix"}
  ],
