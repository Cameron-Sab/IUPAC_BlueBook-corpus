        ["pred", "parent.is_bridged_fused_ring_system", ["var", "parent_hydride"]],
        ["pred", "parent.is_saturated_monocycle", ["var", "parent_hydride"]],
        ["pred", "parent.is_saturated_von_baeyer_hydrocarbon", ["var", "parent_hydride"]],
        ["pred", "parent.is_spiro_alkane", ["var", "parent_hydride"]],
        ["pred", "parent.is_stereoparent", ["var", "parent_hydride"]]
      ],
      "then": [
        ["set", "allowed", true],
        ["set", "prefix_numbering", ["get", ["var", "parent_hydride"], "retained_numbering"]]
      ],
      "else": [["set", "allowed", false]]
    },
