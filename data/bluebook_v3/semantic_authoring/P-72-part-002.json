  "examples": [
    {"id": "methanidyl", "c": [6], "input": {"free_valences": 1, "parent_anion": "methanide"}, "ok": ["methanidyl"], "bad": [], "shows": [["semantic_unit", "systematically_formed_anionic_prefixes"]], "why": "A single free valence gives the preferred prefix methanidyl."},
    {"id": "azanidyl", "c": [7], "input": {"free_valences": 1, "parent_anion": "azanide"}, "ok": ["azanidyl"], "bad": ["amidyl"], "shows": [["semantic_unit", "systematically_formed_anionic_prefixes"]], "why": "The systematic prefix is preselected and the alternative amidyl is shown for comparison."},
    {"id": "azanediidyl", "c": [8], "input": {"free_valences": 2, "parent_anion": "azanide"}, "ok": ["azanediidyl"], "bad": [], "shows": [["semantic_unit", "systematically_formed_anionic_prefixes"]], "why": "The multiplying prefix denotes two free valences."},
    {"id": "boranuidyl", "c": [9], "input": {"free_valences": 1, "parent_anion": "boranuide"}, "ok": ["boranuidyl"], "bad": [], "shows": [["semantic_unit", "systematically_formed_anionic_prefixes"]], "why": "The prefix is formed from the parent anion by the cumulative suffix rule."},
    {"id": "azanidylidene", "c": [10], "input": {"free_valence_type": "double", "parent_anion": "azanide"}, "ok": ["azanidylidene"], "bad": ["amidylidene"], "shows": [["semantic_unit", "systematically_formed_anionic_prefixes"]], "why": "The ylidene suffix denotes the double-bonded free valence."},
    {"id": "disulfanidyl", "c": [11], "input": {"free_valences": 2, "parent_anion": "disulfane"}, "ok": ["disulfanidyl"], "bad": [], "shows": [["semantic_unit", "systematically_formed_anionic_prefixes"]], "why": "The example illustrates a multiplying prefix for a disulfanyl group."},
    {"id": "cyclopentadienide_diyl", "c": [12], "input": {"structure": "cyclopenta-1,4-dien-3-ide"}, "ok": ["cyclopenta-1,4-dien-3-ide-1,2-diyl"], "bad": [], "shows": [["semantic_unit", "systematically_formed_anionic_prefixes"]], "why": "The caption identifies the preferred prefix for two free valences."},
    {"id": "benzoborol_ylidene", "c": [14], "input": {"structure": "2H-2-benzoborol-2-uid"}, "ok": ["2H-2-benzoborol-2-uid-2-ylidene"], "bad": [], "shows": [["semantic_unit", "systematically_formed_anionic_prefixes"]], "why": "The caption illustrates a preferred ylidene prefix."},
    {"id": "maximum_anionic_centers", "c": [20, 21], "input": {"candidates": ["1-(borinan-1-uid-4-yl)ethane-1,2-bis(olate)", "4-(1,2-dioxidoethyl)borinan-1-uide"]}, "ok": ["1-(borinan-1-uid-4-yl)ethane-1,2-bis(olate)"], "bad": ["4-(1,2-dioxidoethyl)borinan-1-uide"], "shows": [["semantic_unit", "anion_parent_choice"]], "why": "Two anionic centres are senior to one under the first criterion."},
    {"id": "maximum_ide_uide_centers", "c": [25, 26], "input": {"candidates": ["2-(2-carboxylatoethyl)-1,1,5,5-tetracyanopentane-1,5-diide", "1,1-dicyano-4-(dicyanomethanidyl)heptan-1-id-7-oate"]}, "ok": ["2-(2-carboxylatoethyl)-1,1,5,5-tetracyanopentane-1,5-diide"], "bad": ["1,1-dicyano-4-(dicyanomethanidyl)heptan-1-id-7-oate"], "shows": [["semantic_unit", "anion_parent_choice"]], "why": "Diide is senior to idoate under the second criterion."},
    {"id": "maximum_uide_centers", "c": [30], "input": {"candidates": ["(2-phosphanidylethyl)arsanuide", "(2-arsanuidylethyl)phosphanide"]}, "ok": ["(2-phosphanidylethyl)arsanuide"], "bad": ["(2-arsanuidylethyl)phosphanide"], "shows": [["semantic_unit", "anion_parent_choice"]], "why": "The parent with the maximum number of uide centers is selected."},
    {"id": "senior_anionic_class", "c": [35, 36], "input": {"candidates": ["(2-silanidylethyl)phosphanide", "(2-phosphanidylethyl)silanide"]}, "ok": ["(2-silanidylethyl)phosphanide"], "bad": ["(2-phosphanidylethyl)silanide"], "shows": [["semantic_unit", "anion_parent_choice"], ["semantic_unit", "anionic_class_seniority_order"]], "why": "P is senior to Si in the stated class order."},
    {"id": "ring_over_chain", "c": [40], "input": {"candidates": ["2-(carboxylatomethyl)benzoate", "chain_parent"], "seniority": "ring over chain"}, "ok": ["2-(carboxylatomethyl)benzoate"], "bad": [], "shows": [["semantic_unit", "anion_parent_choice"]], "why": "The ring parent is senior to a chain in the further-choice criterion."},
    {"id": "carboxylate_over_olate", "c": [42], "input": {"candidates": ["3-oxidonaphthalene-2-carboxylate", "olate_parent"], "seniority": "carboxylate over olate"}, "ok": ["3-oxidonaphthalene-2-carboxylate"], "bad": [], "shows": [["semantic_unit", "anion_parent_choice"]], "why": "Carboxylate is senior to olate in the example."},
    {"id": "methylsilanuide", "c": [47], "input": {"parent": "methylsilane", "lambda_convention": true}, "ok": ["methylsilanuide"], "bad": ["methyl-lambda6-silanide"], "shows": [["semantic_unit", "uide_suffix_lambda_preference"]], "why": "Uide is preferred with a parent hydride named by the lambda convention."},
    {"id": "iodanuide", "c": [49], "input": {"structure": "F6I", "lambda_convention": true}, "ok": ["hexafluoro-lambda5-iodanuide"], "bad": ["hexafluoro-lambda7-iodanide"], "shows": [["semantic_unit", "uide_suffix_lambda_preference"]], "why": "The preselected uide name illustrates the same preference."},
    {"id": "methanide", "c": [53], "input": {"structure": "H3C", "lambda_convention": true}, "ok": ["methanide"], "bad": ["lambda2-methanuide"], "shows": [["semantic_unit", "ide_suffix_lambda_exception"]], "why": "Ide is preferred in the stated lambda-convention exception."},
    {"id": "dithiocane_ide_consistency", "c": [54, 55], "input": {"structure": "dithiocane", "lambda_convention": true}, "ok": ["1lambda6,3lambda6-dithiocane-1,3-diide"], "bad": ["1lambda4,3lambda4-dithiocane-1,3-diuide", "1lambda4,3lambda6-dithiocan-3-id-1-uide"], "shows": [["semantic_unit", "ide_suffix_lambda_exception"]], "why": "Identical groups are kept consistent and the ide form is preferred when both anionic centers use the lambda convention."}
