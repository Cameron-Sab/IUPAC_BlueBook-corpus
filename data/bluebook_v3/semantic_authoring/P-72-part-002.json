  "symbols": [
    {
      "id": "prefix.append_cumulative_suffix",
      "k": "transformation",
      "d": "Forms a prefix by adding a cumulative yl or ylidene suffix to a parent-anion name and eliding its final e.",
      "a": [["parent_anion_name", "string"], ["suffix", "string"]],
      "ret": "prefix",
      "g": ["primitive", [], "append_cumulative_suffix_eliding_final_e"]
    },
    {
      "id": "prefix.apply_multiplying_prefix",
      "k": "transformation",
      "d": "Adds a multiplying prefix to denote the multiplicity of free valences.",
      "a": [["free_valence_count", "integer"]],
      "ret": "prefix",
      "g": ["primitive", [], "denote_free_valence_multiplicity"]
    },
    {
      "id": "prefix.assign_low_free_valence_locants",
      "k": "transformation",
      "d": "Assigns low locants to free valences when a choice exists.",
      "a": [["free_valence_locants", "LocantSet"]],
      "ret": "prefix",
      "g": ["primitive", [], "assign_low_free_valence_locants"]
    }
  ],
  "units": [
    {
      "id": "systematically_formed_anionic_prefixes",
      "k": "procedure",
      "f": "required",
      "c": [2, 3, 4],
      "in": [["parent_anion_name", "string"], ["suffix", "string"], ["free_valence_count", "integer"], ["free_valence_locants", "LocantSet"]],
      "out": [["prefix", "Prefix"]],
      "steps": [
        ["xform", "prefix", "prefix.append_cumulative_suffix", ["var", "parent_anion_name"], ["var", "suffix"]],
        ["xform", "prefix", "prefix.apply_multiplying_prefix", ["var", "free_valence_count"]],
        ["xform", "prefix", "prefix.assign_low_free_valence_locants", ["var", "free_valence_locants"]]
      ]
    },
    {
      "id": "anion_parent_choice",
      "k": "decision",
      "f": "preference",
      "c": [17, 18, 23, 28, 32, 33, 38],
      "in": [["parent_candidates", "AnionicParentSet"]],
      "out": [["selected_parent", "AnionicParent"]],
      "candidates": ["var", "parent_candidates"],
      "stages": [
        {
          "id": "maximum_anionic_centers",
          "c": [17, 18],
          "key": ["get", ["var", "parent_candidates"], "anionic_center_count_including_suffixes"],
          "cmp": ["numeric", "maximum", null, null]
        },
        {
          "id": "maximum_ide_and_uide_centers",
          "c": [23],
          "key": ["get", ["var", "parent_candidates"], "ide_and_uide_center_count"],
          "cmp": ["numeric", "maximum", null, null]
        },
        {
          "id": "maximum_uide_centers",
          "c": [28],
          "key": ["get", ["var", "parent_candidates"], "uide_center_count"],
          "cmp": ["numeric", "maximum", null, null]
        },
        {
          "id": "senior_anionic_class",
          "c": [32, 33],
          "key": ["get", ["var", "parent_candidates"], "senior_anionic_center_class_rank"],
          "cmp": ["numeric", "maximum", null, null]
        },
        {
          "id": "suffix_and_parent_seniority",
          "c": [38],
          "key": ["get", ["var", "parent_candidates"], "corresponding_suffix_and_parent_seniority_key"],
          "cmp": ["lexicographic", "maximum", null, null]
        }
      ],
      "tie": ["reject_ambiguous", null]
    },
    {
      "id": "anionic_class_seniority_order",
      "k": "definition",
      "f": "definition",
      "c": [32, 33],
      "out": [["seniority_order", "AnionicClassSeniorityOrder"]],
      "term": "seniority order of anionic classes",
      "entity": "AnionicClassSeniorityOrder",
      "value": ["lit", {
        "order": ["N", "P", "As", "Sb", "Bi", "Si", "Ge", "Sn", "Pb", "B", "Al", "Ga", "In", "Tl", "O", "S", "Se", "Te", "C"],
        "basis": "seniority order of classes",
        "replaced_basis": "skeletal replacement a prefixes"
      }]
    },
    {
      "id": "anionic_class_seniority_callout_mapping",
      "k": "mapping",
      "c": [32, 33],
      "table": "anionic_class_seniority_callout"
    },
    {
      "id": "uide_suffix_lambda_preference",
      "k": "definition",
      "f": "preference",
      "c": [45, 47, 49],
      "out": [["suffix_policy", "AnionicSuffixPolicy"]],
      "term": "uide preference with the lambda convention",
      "entity": "AnionicSuffixPolicy",
      "value": ["lit", {
        "preferred_suffix": "uide",
        "scope": "parent hydride named by the lambda convention",
        "examples": ["methylsilanuide", "hexafluoro-lambda5-iodanuide"]
      }]
    },
    {
      "id": "ide_suffix_lambda_exception",
      "k": "definition",
      "f": "preference",
      "c": [50, 51, 53, 54, 55],
      "out": [["suffix_policy", "AnionicSuffixPolicy"]],
      "term": "ide preference for lambda-convention anionic centers",
      "entity": "AnionicSuffixPolicy",
      "value": ["lit", {
        "preferred_suffix": "ide",
        "scope": "the lambda convention is involved in both anionic centers",
        "consistency": "Identical groups, if possible, must not be named differently within one name.",
        "examples": ["methanide", "1lambda6,3lambda6-dithiocane-1,3-diide"]
      }]
    }
