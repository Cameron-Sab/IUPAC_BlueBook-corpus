  "units": [
    {
      "id": "omit_locants_for_uniform_complete_isotopic_modification",
      "k": "definition",
      "f": "required",
      "c": [1],
      "scope": {"r": ["all"], "if": ["lit", {"all_positions": "completely_isotopically_substituted_or_modified", "modification_uniform": true}]},
      "term": "isotopic locant omission",
      "entity": "IsotopicLocantRule",
      "value": ["lit", {"locants": "omitted"}]
    },
    {
      "id": "retain_locants_when_isomers_are_possible",
      "k": "constraint",
      "f": "required",
      "c": [5],
      "in": [["isotopic_structure", "IsotopicallyModifiedStructure"]],
      "out": [["locant_requirement", "LocantRequirement"]],
      "scope": {"r": ["all"], "if": ["lit", {"isomerism_possible": true}]},
      "assert": ["lit", {"locants": "not_omitted"}],
      "violation": [["reject", "locant_omission", "isotopic_locants_required_when_isomers_are_possible"]]
    },
    {
      "id": "isotope_locant_placement_rules",
      "k": "definition",
      "f": "required",
      "c": [10, 11, 12],
      "scope": {"r": ["all"], "if": ["lit", true]},
      "term": "nuclide_locant_placement",
      "entity": "NuclideLocantRule",
      "value": ["lit", {
        "parent_structure": "When locants are needed for defining the structure of the parent structure or of a unit of structure as defined by its appropriate enclosing marks, then all locants must be cited for the parent structure or that structural unit.",
        "specific_nuclide_positions": "Specific positions of nuclides must be indicated in the isotopic descriptor by appropriate locants, letters, and/or numerals, preceding the nuclide symbol(s).",
        "preferred_names": "In preferred names, all locants are placed before the nuclide that is multiplied."
      }]
    },
    {
      "id": "unlocanted_nuclide_position_designator_permission",
      "k": "definition",
      "f": "permitted",
      "c": [21],
      "scope": {"r": ["general_nomenclature"], "if": ["lit", {"nuclide_position_numbered": false}]},
      "term": "designator for an unnumbered nuclide position",
      "entity": "NuclidePositionDesignator",
      "value": ["lit", {"permitted_forms": ["italicized prefix", "Greek letter"], "purpose": "denote position"}]
    },
    {
      "id": "deleted_deuterated_glyceraldehyde_correction_event",
      "k": "definition",
      "f": "definition",
      "c": [19],
      "scope": {"r": ["all"], "if": ["lit", true]},
      "term": "P-82.6.2_correction_event",
      "entity": "CorrectionEvent",
      "value": ["lit", {
        "event_kind": "correction",
        "action": "deleted",
        "description": "deleted D-(O-2H)glycer(2H)aldehyde",
        "source_url": "https://iupac.qmul.ac.uk/BlueBook/changes.html",
        "source_icon_url": "https://iupac.qmul.ac.uk/greek/ALTER.GIF"
      }]
    },
    {
      "id": "retained_name_unlocanted_nuclide_rule",
      "k": "definition",
      "f": "required",
      "c": [31, 32],
      "scope": {"r": ["preferred_iupac_name", "general_nomenclature"], "if": ["lit", true]},
      "term": "nuclide_in_unlocanted_retained_name",
      "entity": "NuclideLocationRule",
      "value": ["lit", {
        "preferred_iupac_name": "When the nuclide is located at a position in a retained name that is not numbered a systematic name that identifies separately the relevant atom is used for the IUPAC preferred name.",
        "general_nomenclature": "For general nomenclature an italicized prefixes or Greek letters may be used to denote its position."
      }]
    },
    {
      "id": "added_isotope_section_correction_event",
      "k": "definition",
      "f": "definition",
      "c": [30],
      "scope": {"r": ["all"], "if": ["lit", true]},
      "term": "P-82.6.3.2_correction_event",
      "entity": "CorrectionEvent",
      "value": ["lit", {
        "event_kind": "correction",
        "action": "added",
        "description": "added new section",
        "source_url": "https://iupac.qmul.ac.uk/BlueBook/changes.html",
        "source_icon_url": "https://iupac.qmul.ac.uk/greek/ALTER.GIF"
      }]
    },
    {
      "id": "unlocanted_nuclide_group_symbol_rule",
      "k": "definition",
      "f": "required",
      "c": [43, 44],
      "scope": {"r": ["preferred_iupac_name", "general_nomenclature"], "if": ["lit", true]},
      "term": "nuclide_in_entire_linked_group_symbol",
      "entity": "NuclideLocationRule",
      "value": ["lit", {
        "condition": "a nuclide occupies a position that is not numbered or its position cannot be easily defined according to rule P-82.6.3.1",
        "action": "include the nuclide symbol in the entire symbol of the group through which it is linked to the main part of the structure",
        "use": "useful in general nomenclature in which many names are constructed without locants"
      }]
    },
    {
      "id": "changed_section_reference_correction_event",
      "k": "definition",
      "f": "definition",
      "c": [42],
      "scope": {"r": ["all"], "if": ["lit", true]},
      "term": "P-82.6.3.3_correction_event",
      "entity": "CorrectionEvent",
      "value": ["lit", {
        "event_kind": "correction",
        "action": "changed",
        "description": "changed from P-82.6.3.2",
        "source_url": "https://iupac.qmul.ac.uk/BlueBook/changes.html",
        "source_icon_url": "https://iupac.qmul.ac.uk/greek/ALTER.GIF"
      }]
    },
    {
      "id": "differentiate_same_element_nuclides_typographically",
      "k": "procedure",
      "f": "required",
      "c": [53],
      "in": [["nuclides", "NuclideSet"]],
      "out": [["distinguished_designators", "NuclideDesignatorSet"]],
      "scope": {"r": ["all"], "if": ["lit", {"same_element": true, "different_nuclides": true}]},
      "steps": [["set", "distinguished_designators", ["lit", {"use": ["italicized nuclide symbols", "italic capital letters"]}]]]
    }
