  "symbols": [],
  "units": [
    {
      "id": "identical_anhydride_linkage_naming_rule",
      "k": "rule",
      "f": "required",
      "c": [1, 3, 4],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "in": [
        ["compound", "AnhydrideCompound"],
        ["class_name", "AnhydrideClassName"],
        ["multiplicity", "integer"]
      ],
      "out": [["naming_pattern", "NamePattern"]],
      "if": [
        "cmp",
        "eq",
        ["get", ["var", "compound"], "all_anhydride_linkages_identical"],
        true
      ],
      "then": [
        [
          "set",
          "naming_pattern",
          [
            "lit",
            {
              "example_linkage": "–CO-S-CO–",
              "class_names": ["thioanhydride"],
              "multiplicative_prefixes": ["bis-", "tris-", "etc."],
              "construction": "precede the class name by the multiplicative prefix"
            }
          ]
        ]
      ],
      "else": []
    },
    {
      "id": "mixed_chalcogen_seniority_order",
      "k": "definition",
      "f": "definition",
      "c": [5],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "out": [["order", "ChalcogenSeniorityOrder"]],
      "term": "seniority order of chalcogen atoms in mixed anhydride linkages",
      "entity": "ChalcogenSeniorityOrder",
      "value": [
        "lit",
        {
          "order": ["O", "S", "Se", "Te"],
          "notation": "O > S > Se > Te",
          "use": "choose the senior anhydride"
        }
      ]
    },
    {
      "id": "senior_anhydride_selection",
      "k": "decision",
      "f": "required",
      "c": [5, 6],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "in": [["anhydride_candidates", "AnhydrideCandidateSet"]],
      "out": [["senior_anhydride", "Anhydride"]],
      "candidates": ["var", "anhydride_candidates"],
      "stages": [
        {
          "id": "chalcogen_seniority",
          "c": [5, 6],
          "key": [
            "get",
            ["var", "anhydride_candidates"],
            "chalcogen_seniority_key"
          ],
          "cmp": ["lexicographic", "maximum", null, null]
        }
      ],
      "tie": ["reject_ambiguous", null]
    },
    {
      "id": "mixed_anhydride_naming_basis",
      "k": "procedure",
      "f": "required",
      "c": [6, 7],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "in": [["compound", "MixedAnhydrideCompound"]],
      "out": [["naming_basis", "AnhydrideNamingBasis"]],
      "steps": [
        [
          "set",
          "naming_basis",
          [
            "lit",
            {
              "senior_basis_options": ["anhydride", "di- or polyanhydride"],
              "other_anhydride_linkages": "named substitutively"
            }
          ]
        ]
      ]
    },
    {
      "id": "carbonyl_chalcogen_analogue_naming_rule",
      "k": "rule",
      "f": "required",
      "c": [16, 18, 19, 20, 21],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "in": [["compound", "CarbonylChalcogenAnalogue"]],
      "out": [["naming_components", "AnhydrideAnalogueNamingComponents"]],
      "if": [
        "cmp",
        "eq",
        ["get", ["var", "compound"], "chalcogen_replaces_carbonyl_oxygen"],
        ">C=S"
      ],
      "then": [
        [
          "set",
          "naming_components",
          [
            "lit",
            {
              "groups": ["thiocarboxylic acids", "thioacyl groups"],
              "application": "use in the manner described for anhydrides and polyanhydrides"
            }
          ]
        ]
      ],
      "else": []
    },
    {
      "id": "cyclic_anhydride_naming_methods",
      "k": "rule",
      "f": "preference",
      "c": [23, 24, 25, 26],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "in": [["compound", "CyclicAnhydride"]],
      "out": [
        ["naming_methods", "CyclicAnhydrideNamingMethods"],
        ["preferred_method", "NamingMethod"]
      ],
      "if": ["lit", true],
      "then": [
        [
          "set",
          "naming_methods",
          [
            "lit",
            {
              "method_1": "heterocyclic pseudoketone",
              "method_2": "change the class term ‘acid’ to ‘anhydride’ in the systematic or retained name of the dibasic acid"
            }
          ]
        ],
        ["set", "preferred_method", "heterocyclic pseudoketone"]
      ],
      "else": []
    },
    {
      "id": "cyclic_dianhydride_naming_methods",
      "k": "rule",
      "f": "preference",
      "c": [46, 47, 48, 49, 50],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "in": [["compound", "CyclicDianhydride"]],
      "out": [
        ["naming_methods", "CyclicDianhydrideNamingMethods"],
        ["preferred_method", "NamingMethod"],
        ["locant_separator", "string"]
      ],
      "if": ["lit", true],
      "then": [
        [
          "set",
          "naming_methods",
          [
            "lit",
            {
              "method_1": "heterocyclic pseudoketone",
              "method_2": "change the class term ‘acid’ to ‘dianhydride’ in the systematic or retained name of the tetrabasic acid"
            }
          ]
        ],
        ["set", "preferred_method", "heterocyclic pseudoketone"],
        ["set", "locant_separator", ";"]
      ],
      "else": []
    },
    {
      "id": "cyclic_dianhydride_locant_separator_constraint",
      "k": "constraint",
      "f": "required",
      "c": [49],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "in": [["name", "CyclicDianhydrideName"]],
      "assert": [
        "cmp",
        "eq",
        ["get", ["var", "name"], "pair_acid_group_locant_separator"],
        ";"
      ],
      "violation": [
        [
          "reject",
          "name",
          "reason.cyclic_dianhydride_locants_not_separated_by_semicolon"
        ]
      ]
    },
    {
      "id": "chalcogen_cyclic_anhydride_naming_methods",
      "k": "rule",
      "f": "preference",
      "c": [63, 64, 65, 66],
      "scope": {
        "r": ["preferred_iupac_name", "general_nomenclature"],
        "if": ["lit", true]
      },
      "in": [["compound", "ChalcogenCyclicAnhydride"]],
      "out": [
        ["naming_methods", "ChalcogenCyclicAnhydrideNamingMethods"],
        ["preferred_method", "NamingMethod"]
      ],
      "if": ["lit", true],
      "then": [
        [
          "set",
          "naming_methods",
          [
            "lit",
            {
              "method_1": "heterocyclic pseudoketone",
              "method_2": "change the class term ‘acid’ to ‘dianhydride’, ‘thioanhydride’, ‘bis(thioanhydride)’, etc., in the systematic or retained name of the dibasic or tetrabasic acid"
            }
          ]
        ],
        ["set", "preferred_method", "heterocyclic pseudoketone"]
      ],
      "else": []
    }
  ],
