        "multiplicity": 2,
        "name_status": "PIN"
      },
      "ok": ["diacetic methanedisulfonic bis(thioanhydride) (PIN)"],
      "bad": [],
      "shows": [["semantic_unit", "identical_anhydride_linkage_naming_rule"]],
      "why": "The identical linkages use bis(thioanhydride) after the acetic and methanedisulfonic components."
