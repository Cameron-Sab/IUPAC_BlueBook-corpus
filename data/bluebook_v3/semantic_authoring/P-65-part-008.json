  "examples": [
    {
      "id": "identical_thioanhydride_bis_example",
      "c": [3],
      "input": {
        "structure": "CH3-CO-S-CO-CH2-CH2-CO-S-CO-CH3",
        "anhydride_linkages": "identical",
        "class_name": "thioanhydride",
        "multiplicity": 2,
        "name_status": "PIN"
      },
      "ok": ["diacetic butanedioic bis(thioanhydride) (PIN)"],
      "bad": [],
      "shows": [["semantic_unit", "identical_anhydride_linkage_naming_rule"]],
      "why": "Identical thioanhydride linkages are named with the multiplicative prefix bis-."
    },
    {
      "id": "identical_mixed_chalcogen_bis_thioanhydride_example",
      "c": [4],
      "input": {
        "structure": "CH3-CO-S-SO2-CH2-SO2-S-CO-CH3",
