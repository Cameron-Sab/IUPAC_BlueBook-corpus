  "symbols": [],
  "units": [
    {
      "id": "c_glycosyl_compound_naming",
      "k": "procedure",
      "f": "required",
      "c": [2],
      "in": [["compound", "C_GlycosylCompound"]],
      "out": [["naming_method", "NamingMethod"]],
      "steps": [
        ["emit", {"source_text": "Compounds arising formally from the elimination of water from the glycosidic hydroxy group and a hydrogen atom bound to a carbon atom (thus creating a C-C bond) are named using the appropriate glycosyl group.", "formation": "formal elimination of water from the glycosidic hydroxy group and a hydrogen atom bound to carbon", "bond_created": "C-C", "naming_basis": "appropriate glycosyl group"}]
      ]
    },
    {
      "id": "glycosyl_halide_pseudohalide_functional_class_naming",
      "k": "procedure",
      "f": "required",
      "c": [7],
      "in": [["compound", "GlycosylHalideOrPseudohalide"]],
      "out": [["naming_method", "NamingMethod"]],
      "steps": [
        ["emit", {"source_text": "Glycosyl halides and pseudohalides are named by using functional class nomenclature, by adding, as a separate word, the class name ‘chloride’, ‘isocyanate’, etc. to the name of the appropriate glycosyl group.", "nomenclature": "functional class nomenclature", "operation": "add the class name as a separate word", "class_name_examples": ["chloride", "isocyanate", "etc."], "base": "appropriate glycosyl group"}]
      ]
    },
    {
      "id": "position_1_oxoacid_ester_treatment",
      "k": "procedure",
      "f": "required",
      "c": [8],
      "in": [["compound", "GlycosylOxoacidEster"]],
      "out": [["treatment", "NamingTreatment"]],
      "steps": [
        ["emit", {"source_text": "Esters of oxoacids in position 1 are treated as described for esters at other positions (see P-102.5.6.1).", "scope": "esters of oxoacids in position 1", "treatment": "as described for esters at other positions", "basis_rule": "P-102.5.6.1"}]
      ]
    },
    {
      "id": "non_anomeric_monosaccharide_free_valence_permission",
      "k": "rule",
      "f": "permitted",
      "c": [15],
      "in": [["monosaccharide", "Monosaccharide"]],
      "out": [["free_valence_permission", "NamingPermission"]],
      "if": ["lit", true],
      "then": [
        ["set", "free_valence_permission", ["lit", {"removed_atom": "hydrogen", "allowed_positions": "any position other than C-1", "source_text": "A hydrogen atom may be removed from any position of a monosaccharide other than C-1."}]]
      ],
      "else": []
    },
    {
      "id": "non_anomeric_free_valence_yl_locant_rule",
      "k": "procedure",
      "f": "required",
      "c": [16],
      "in": [["substituent", "MonosaccharideSubstituent"]],
      "out": [["free_valence_notation", "SubstituentNotation"]],
      "steps": [
        ["emit", {"source_text": "This formation of a free valence is denoted by the suffix ‘yl’, but a locant is necessary to indicate the position of the free valence and to distinguish such a name from that of glycosyl substituents for which the locant ‘1’ is omitted.", "suffix": "yl", "locant": "required for the free-valence position", "glycosyl_locant_1": "omitted for glycosyl substituents", "purpose": "distinguish non-anomeric substituent names from glycosyl substituent names"}]
      ]
    },
    {
      "id": "substituent_prefix_n_C_O_yl_formation",
      "k": "procedure",
      "f": "required",
      "c": [17],
      "in": [["monosaccharide_name", "MonosaccharideName"]],
      "out": [["substituent_prefix", "SubstituentPrefix"]],
      "steps": [
        ["emit", {"source_text": "These prefixes can be formed by replacing the final letter ‘e’ of the systematic or trivial name of a monosaccharide by n-C-yl, n-O-yl.", "source_name_types": ["systematic", "trivial"], "operation": "replace the final letter e", "replacement_forms": ["n-C-yl", "n-O-yl"]}]
      ]
    },
    {
      "id": "free_valence_carbon_symbol_omission",
      "k": "procedure",
      "f": "required",
      "c": [18],
      "in": [["free_valence", "MonosaccharideFreeValence"]],
      "out": [["free_valence_notation", "SubstituentNotation"]],
      "steps": [
        ["emit", {"source_text": "The symbol ‘C’ is omitted when the free valence is derived from a position at which hydrogen atoms only are attached.", "symbol": "C", "omission_condition": "the source position has hydrogen atoms only attached"}]
      ]
    },
    {
      "id": "disaccharide_oligosaccharide_nomenclature_basis",
      "k": "procedure",
      "f": "required",
      "c": [33],
      "in": [["saccharide", "DisaccharideOrOligosaccharide"]],
      "out": [["naming_basis", "NamingBasis"]],
      "steps": [
        ["emit", {"source_text": "Names of disaccharides and oligosaccharides are formed by the principles, rules, and conventions described above for monosaccharides.", "applies_to": ["disaccharides", "oligosaccharides"], "basis": "principles, rules, and conventions described above for monosaccharides"}]
      ]
    },
    {
      "id": "disaccharide_without_hemiacetal_glycosyl_glycoside_naming",
      "k": "procedure",
      "f": "required",
      "c": [37],
      "in": [["disaccharide", "DisaccharideWithoutFreeHemiacetal"]],
      "out": [["naming_method", "NamingMethod"]],
      "steps": [
        ["emit", {"source_text": "Disaccharides which can be regarded as formed by elimination of one molecule of water from two glycosidic (anomeric) hydroxy groups, are named as glycosyl glycosides.", "formation": "elimination of one molecule of water from two glycosidic (anomeric) hydroxy groups", "name_pattern": "glycosyl glycoside", "free_hemiacetal_group": false}]
      ]
    },
    {
      "id": "disaccharide_parent_selection",
      "k": "procedure",
      "f": "required",
      "c": [38],
      "in": [["disaccharide", "DisaccharideWithoutFreeHemiacetal"]],
      "out": [["parent_selection", "ParentSelection"]],
      "steps": [
        ["emit", {"source_text": "The parent (cited as the ‘glycoside’) is chosen in accordance with criteria described in P-102.4.", "parent_role": "glycoside", "selection_basis": "criteria described in P-102.4"}]
      ]
    },
    {
      "id": "disaccharide_anomeric_descriptor_requirement",
      "k": "constraint",
      "f": "required",
      "c": [39],
      "in": [["name", "DisaccharideName"]],
      "assert": ["cmp", "eq", ["get", ["var", "name"], "both_anomeric_descriptors_cited"], true],
      "violation": [["reject", "name", "reason.both_anomeric_descriptors_required"]]
    },
    {
      "id": "disaccharide_with_hemiacetal_glycosylglycose_naming",
      "k": "procedure",
      "f": "required",
      "c": [44],
      "in": [["disaccharide", "DisaccharideWithFreeHemiacetal"]],
      "out": [["naming_method", "NamingMethod"]],
      "steps": [
        ["emit", {"source_text": "Disaccharides which can be regarded as formed by elimination of one molecule of water from one glycosidic (anomeric) hydroxy group and one alcoholic hydroxy group, are named as glycosylglycoses.", "formation": "elimination of one molecule of water from one glycosidic (anomeric) hydroxy group and one alcoholic hydroxy group", "name_pattern": "glycosylglycose", "free_hemiacetal_group": true}]
      ]
    },
    {
      "id": "glycosylglycose_locant_descriptor_requirement",
      "k": "constraint",
      "f": "required",
      "c": [45],
      "in": [["name", "GlycosylglycoseName"]],
      "assert": ["all", ["cmp", "eq", ["get", ["var", "name"], "locants_cited"], true], ["cmp", "eq", ["get", ["var", "name"], "anomeric_descriptors_cited"], true]],
      "violation": [["reject", "name", "reason.glycosylglycose_locants_and_anomeric_descriptors_required"]]
    },
    {
      "id": "glycosylglycose_locant_methods",
      "k": "procedure",
      "f": "required",
      "c": [46],
      "in": [["name", "GlycosylglycoseName"]],
      "out": [["locant_methods", "LocantMethods"]],
      "steps": [
        ["emit", {"source_text": "There are two established methods for citing locants:", "method_count": 2, "methods": ["parenthetical locants between components with an arrow from the glycosyl locant to the glycose locant", "locants at the front of the glycosyl component"]}]
      ]
    },
    {
      "id": "glycosylglycose_parenthetical_arrow_locants",
      "k": "rule",
      "f": "permitted",
      "c": [47],
      "in": [["name", "GlycosylglycoseName"]],
      "out": [["locant_method", "LocantMethod"]],
      "if": ["lit", true],
      "then": [
        ["set", "locant_method", ["lit", {"method": "parenthetical between components", "arrow_direction": "from glycosyl component locant to glycose component locant", "source_text": "(1) in parentheses between the components with an arrow going from the locant of the glycosyl component to that of the glycose component;"}]]
      ],
      "else": []
    },
    {
      "id": "glycosylglycose_front_glycosyl_locants",
      "k": "rule",
      "f": "permitted",
      "c": [48],
      "in": [["name", "GlycosylglycoseName"]],
      "out": [["locant_method", "LocantMethod"]],
      "if": ["lit", true],
      "then": [
        ["set", "locant_method", ["lit", {"method": "at the front of the glycosyl component", "source_text": "(2) at the front of the glycosyl component."}]]
      ],
      "else": []
    },
    {
      "id": "oligosaccharide_definition_and_unit_terms",
      "k": "definition",
      "f": "definition",
      "c": [54],
      "in": [["saccharide", "Saccharide"]],
      "out": [["classification", "OligosaccharideClassification"]],
      "term": "oligosaccharide",
      "entity": "saccharide",
      "value": ["lit", {"source_text": "Oligosaccharides are multicomponent saccharides generally with more than two monosaccharide units According to the number of units, they are called trisaccharides, tetrasaccharides, etc.", "definition": "multicomponent saccharide generally with more than two monosaccharide units", "unit_count_names": {"three": "trisaccharide", "four": "tetrasaccharide", "higher_counts": "etc."}}]
    },
    {
      "id": "oligosaccharide_polysaccharide_boundary",
      "k": "definition",
      "f": "definition",
      "c": [55],
      "in": [["oligosaccharide", "Oligosaccharide"]],
      "out": [["unit_boundary", "UnitBoundary"]],
      "term": "oligosaccharide-to-polysaccharide unit boundary",
      "entity": "oligosaccharide",
      "value": ["lit", {"source_text": "The number of units involved before they become polysaccharides is not defined.", "number_of_units_before_polysaccharide": "not defined"}]
    },
    {
      "id": "trisaccharide_glycosyl_glycosyl_naming",
      "k": "procedure",
      "f": "required",
      "c": [57],
      "in": [["trisaccharide", "Trisaccharide"]],
      "out": [["naming_method", "NamingMethod"]],
      "steps": [
        ["emit", {"source_text": "A trisaccharide, for example, is named as a glycosylglycosyl glycoside or glycosyl glycosylglycoside as required.", "name_patterns": ["glycosylglycosyl glycoside", "glycosyl glycosylglycoside"], "application": "as required"}]
      ]
    },
    {
      "id": "trisaccharide_glycoside_choice",
      "k": "procedure",
      "f": "permitted",
      "c": [58],
      "in": [["trisaccharide", "TrisaccharideWithoutFreeHemiacetal"]],
      "out": [["glycoside_choice", "ParentSelection"]],
      "steps": [
        ["emit", {"source_text": "A choice between the two residues linked through their anomeric positions for citation as the ‘glycoside’ portion can be made on the basis of P-102.4.", "choice": "between the two residues linked through their anomeric positions", "citation_role": "glycoside portion", "basis_rule": "P-102.4"}]
      ]
    },
    {
      "id": "trisaccharide_sequential_naming_permission",
      "k": "procedure",
      "f": "permitted",
      "c": [59],
      "in": [["trisaccharide", "TrisaccharideWithoutFreeHemiacetal"]],
      "out": [["naming_method", "NamingMethod"]],
      "steps": [
        ["emit", {"source_text": "Alternatively, a sequential (end-to-end) naming approach may be used, regardless of P-102.4.", "alternative": "sequential (end-to-end) naming approach", "basis_rule_independence": "regardless of P-102.4"}]
      ]
    },
    {
      "id": "trisaccharide_disaccharide_naming_method",
      "k": "procedure",
      "f": "required",
      "c": [60],
      "in": [["trisaccharide", "Trisaccharide"]],
      "out": [["naming_method", "NamingMethod"]],
      "steps": [
        ["emit", {"source_text": "The name is formed by the preferred method for naming disaccharides.", "method": "preferred method for naming disaccharides"}]
      ]
    },
    {
      "id": "free_hemiacetal_oligosaccharide_glycosylglycosen_glycose_naming",
      "k": "procedure",
      "f": "required",
      "c": [65],
      "in": [["oligosaccharide", "OligosaccharideWithFreeHemiacetal"]],
      "out": [["naming_method", "NamingMethod"]],
      "steps": [
        ["emit", {"source_text": "An oligosaccharide of this type is named as a glycosyl[glycosyl]nglycose, the ‘glycose’ portion being the parent.", "name_pattern": "glycosyl[glycosyl]nglycose", "parent": "glycose portion"}]
      ]
    },
    {
      "id": "free_hemiacetal_oligosaccharide_right_hand_glycose_convention",
      "k": "procedure",
      "f": "required",
      "c": [66],
      "in": [["name", "OligosaccharideName"]],
      "out": [["depiction_convention", "NameDepictionConvention"]],
      "steps": [
        ["emit", {"source_text": "The conventional depiction has the ‘glycose’ portion on the right.", "glycose_position": "right"}]
      ]
    },
    {
      "id": "free_hemiacetal_oligosaccharide_naming_basis",
      "k": "procedure",
      "f": "required",
      "c": [67],
      "in": [["oligosaccharide", "OligosaccharideWithFreeHemiacetal"]],
      "out": [["naming_basis", "NamingBasis"]],
      "steps": [
        ["emit", {"source_text": "Names are formed as described in P-102.7.2.1.", "basis_rule": "P-102.7.2.1"}]
      ]
    }
  ],
