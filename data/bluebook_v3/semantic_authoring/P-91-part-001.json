    {
      "id": "cip_reflection_and_collation_behavior",
      "k": "definition",
      "f": "required",
      "c": [41, 42, 43],
      "out": [["behavior", "CIPDescriptorBehavior"]],
      "term": "CIP descriptor reflection and collation behavior",
      "entity": "CIPDescriptorBehavior",
      "value": ["lit", {
        "capitalized": {"mirror_behavior": "variant", "example": "R becomes S and S becomes R"},
        "lower_case": {"mirror_behavior": "invariant", "example": "r remains r and s remains s"},
        "typography": "italic",
        "collation": "excluded from the primary stage of alphanumerical order",
        "collation_rule": "P-16.6"
      }]
    },
    {
      "id": "ez_descriptor_assignment",
      "k": "procedure",
      "f": "required",
      "c": [52, 53, 54, 55, 56, 57],
      "in": [["stereogenic_bond_system", "DiastereomorphicBondSystem"]],
      "out": [["descriptor", "EZDescriptor"]],
      "steps": [
        ["set", "eligible_systems", ["lit", ["alkene", "cumulene", "oxime-like system", "fractional bond order between one and two", "multiple bonds involving elements other than carbon"]]],
        ["set", "terminal_groups", ["lit", "highest-CIP-priority group at each terminal doubly bonded atom"]],
        ["set", "reference_plane", ["lit", "plane through the double bond and perpendicular to the plane of the bonds from terminal atoms to compared groups"]],
        ["set", "descriptor.same_side", ["lit", "Z"]],
        ["set", "descriptor.opposite_side", ["lit", "E"]],
        ["emit", ["var", "descriptor"]]
      ]
    },
