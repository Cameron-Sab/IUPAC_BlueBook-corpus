    {
      "id": "stereodescriptor_base_name_invariance",
      "k": "procedure",
      "f": "required",
      "c": [83, 84, 85, 86],
      "in": [["compound", "ChemicalCompound"]],
      "out": [["base_name", "ConfigurationNeutralName"]],
      "steps": [
        ["invoke", "P-59.1", {"compound": ["var", "compound"]}],
        ["set", "base_name.invariant_under_stereodescriptors", true],
        ["set", "base_name.numbering_invariant_under_stereodescriptors", true],
        ["set", "base_name.nesting_exception", ["lit", "nesting symbols may alter the pre-affix nesting pattern; see P-16.5.4.1 and P-93.6"]],
        ["emit", ["var", "base_name"]]
      ]
    },
    {
      "id": "stereodescriptor_placement",
      "k": "procedure",
      "f": "required",
      "c": [87, 88, 89, 90, 91, 92],
      "in": [["descriptor", "Stereodescriptor"], ["name_part", "NamePart"]],
      "out": [["rendered_descriptor", "RenderedStereodescriptor"]],
      "steps": [
        ["set", "rendered_descriptor.position", ["lit", {"general": "immediately before the name part to which it relates", "parent_structure": "front of complete name", "substituent": "front of corresponding prefix"}]],
        ["set", "rendered_descriptor.enclosure", ["lit", "parentheses followed by a hyphen"]],
        ["set", "rendered_descriptor.locant", ["lit", "numerical or letter locant when present"]],
        ["invoke", "P-14.4", {"name_part": ["var", "name_part"]}],
        ["emit", ["var", "rendered_descriptor"]]
      ]
    },
    {
      "id": "corrected_but_2_ene_name_event",
      "k": "definition",
      "f": "definition",
      "c": [96],
      "out": [["event", "CorrectionEvent"]],
      "term": "P-91.3 corrected-name source event",
      "entity": "CorrectionEvent",
      "value": ["lit", {"event_kind": "correction", "description": "corrected name", "target_url": "https://iupac.qmul.ac.uk/BlueBook/changes.html", "icon_url": "https://iupac.qmul.ac.uk/greek/ALTER.GIF"}]
    },
    {
      "id": "multiple_stereodescriptor_placement",
      "k": "procedure",
      "f": "required",
      "c": [105, 106, 107],
      "in": [["stereogenic_units", "StereogenicUnitSet"]],
      "out": [["descriptor_set", "RenderedStereodescriptorSet"]],
      "steps": [
        ["each", "unit", ["var", "stereogenic_units"], [["emit", ["lit", "apply descriptor assignment to unit"]]], false],
