      "in": [["configuration_kind", "ConfigurationKind"]],
      "out": [["descriptor", "PreferredStereodescriptor"]],
      "steps": [
        ["emit", ["lit", {
          "relative_configuration": {"preferred": "rel associated with R or S", "over": ["R*", "S*"]},
          "racemate": {"preferred": "rac", "over": ["RS", "SR"]}
        }]]
