    {
      "id": "locanted_and_unspecified_descriptor_procedure",
      "k": "procedure",
      "f": "required",
      "c": [62, 63, 64, 65],
      "in": [["stereogenic_unit", "StereogenicUnit"], ["configuration_status", "ConfigurationStatus"]],
      "out": [["descriptor", "LocantedStereodescriptor"]],
      "steps": [
        ["set", "descriptor.locant", ["lit", "required locant for each stereogenic unit in a PIN"]],
        ["set", "descriptor.unknown_or_inhomogeneous", ["lit", {"lower_case_descriptor_class": "small xi", "capitalized_descriptor_class": "capital Xi", "typography": "italic"}]],
        ["set", "descriptor.small_xi_replaces", ["lit", ["r", "s", "m", "p"]]],
        ["set", "descriptor.capital_xi_replaces", ["lit", ["R", "S", "M", "P", "E", "Z", "seqCis", "seqTrans"]]],
        ["emit", ["var", "descriptor"]]
      ]
    },
    {
      "id": "natural_product_descriptor_assignment",
