  "units": [
    {
      "id": "retained_glycosamine_names",
      "k": "mapping",
      "f": "required",
      "c": [3],
      "in": [["structure", "AminoSugarStructure"]],
      "out": [["name", "RetainedGlycosamineName"]],
      "table": "retained_glycosamine_names"
    },
    {
      "id": "systematic_amino_sugar_naming",
      "k": "procedure",
      "f": "required",
      "c": [17, 18],
      "in": [["sugar", "AminoSugar"]],
      "out": [["name", "SystematicAminoSugarName"]],
      "steps": [
        ["set", "name.step_1", ["lit", "form the deoxy sugar by deoxygenation at the carbon where nitrogen substitution is introduced"]],
        ["set", "name.step_2", ["lit", "cite the amino group, including any N-substitution, as a prefix"]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "chalcogen_analogue_naming",
      "k": "procedure",
      "f": "required",
      "c": [23, 24, 25, 26, 27],
      "in": [["sugar", "ChalcogenAnalogueOfSugar"]],
      "out": [["name", "ChalcogenSugarName"]],
      "steps": [
        ["set", "name.replacement_prefixes", ["lit", {"sulfur": "thio", "selenium": "seleno", "tellurium": "telluro"}]],
        ["set", "name.prefix_properties", ["lit", {"position": "front of systematic or trivial sugar name", "detachable": true, "alphabetized": true, "requires_locant": true}]],
        ["set", "name.ring_oxygen_locant", ["lit", "number of the non-anomeric adjacent ring carbon"]],
        ["set", "name.ring_skeletal_a_prefix", ["lit", "not recommended"]],
        ["set", "name.oxidized_chalcogen_treatment", ["lit", {"classes": ["sulfoxides", "selenoxides", "telluroxides", "sulfones", "selenones", "tellurones"], "method": "functional class nomenclature", "basis_rule": "P-63.6"}]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "o_substitution_notation",
      "k": "procedure",
      "f": "permitted",
      "c": [38, 39, 40, 41, 42, 43],
      "in": [["derivative", "OMonosaccharideDerivative"]],
      "out": [["notation", "OSubstitutionNotation"]],
      "steps": [
        ["set", "notation.permission_basis", ["lit", "preserve structure integrity and retained-name absolute configuration"]],
        ["set", "notation.scope", ["lit", "replacement of an alcoholic hydroxy hydrogen"]],
        ["set", "notation.anomeric_hydroxy_basis", ["lit", "P-102.5.6.3.2"]],
        ["set", "notation.multiple_identical_substitution", ["lit", {"repeat_O_locant": false, "number_locants": "use as necessary; omit when every position is substituted identically"}]],
        ["emit", ["var", "notation"]]
      ]
    },
    {
      "id": "o_acyl_and_o_alkyl_naming",
      "k": "procedure",
      "f": "required",
      "c": [45, 46, 47],
      "in": [["derivative", "OAcylOrOAlkylSugar"]],
      "out": [["name", "SugarDerivativeName"]],
      "steps": [
        ["if", ["get", ["var", "derivative"], "is_o_acyl"], [["set", "name.preferred_form", ["lit", "monosaccharide name followed by a separate acid-component word ending in ate"]]], []],
        ["if", ["get", ["var", "derivative"], "ose_ending_is_changed"], [["set", "name.o_acyl_prefix_required", true]], []],
        ["if", ["get", ["var", "derivative"], "is_o_alkyl"], [["set", "name.prefix_form_required", true]], []],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "phosphoric_acid_ester_naming",
      "k": "procedure",
      "f": "required",
      "c": [60, 61, 62, 63, 64, 65, 66],
      "in": [["ester", "SugarPhosphoricAcidEster"]],
      "out": [["name", "SugarPhosphateName"]],
      "steps": [
        ["set", "name.general_class", ["lit", "phosphate"]],
        ["set", "name.biochemical_usage", ["lit", "phosphate residue regardless of ionization state or counterions"]],
        ["set", "name.systematic_distinction", ["lit", {"true_phosphate": "-O-PO(O-)2", "acid_phosphate": "-O-PO(OH)2, named dihydrogen phosphate"}]],
        ["set", "name.prefixes", ["lit", {"phosphono": "-PO(OH)2", "phosphonato": "-PO(O-)2", "phospho": "biochemical replacement for phosphono or phosphonato"}]],
        ["set", "name.multiple_groups", ["lit", "use bis(phosphate), tris(phosphate), and corresponding multiplicative terms"]],
        ["set", "name.phosphonate_treatment", ["lit", "same as phosphates"]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "sulfuric_acid_ester_naming",
      "k": "procedure",
      "f": "required",
      "c": [79, 80],
      "in": [["ester", "SugarSulfuricAcidEster"]],
      "out": [["name", "SugarSulfateName"]],
      "steps": [
        ["set", "name.functional_class_form", ["lit", "sugar name followed by sulfate with the appropriate locant"]],
        ["set", "name.prefix_forms", ["lit", {"sulfo": "-SO3H", "sulfonato": "-SO3-"}]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "glycose_term",
      "k": "definition",
      "f": "definition",
      "c": [86],
      "in": [["term", "CarbohydrateTerm"]],
      "out": [["meaning", "CarbohydrateClass"]],
      "term": "glycose",
      "entity": "CarbohydrateTerm",
      "value": ["lit", {"meaning": "monosaccharide", "usage": "less frequent"}]
    },
    {
      "id": "glycoside_definition",
      "k": "definition",
      "f": "definition",
      "c": [87, 88],
      "in": [["compound", "CarbohydrateCompound"]],
      "out": [["classification", "GlycosideClassification"]],
      "term": "glycoside",
      "entity": "CarbohydrateCompound",
      "value": ["lit", {"class": "mixed acetal or ketal derived from a cyclic monosaccharide", "structural_feature": "O-substituted anomeric hydroxy group, such as -OR", "discussion_reference": 27}]
    },
    {
      "id": "glycoside_functional_class_naming",
      "k": "procedure",
      "f": "required",
      "c": [90, 91, 92],
      "in": [["glycoside", "Glycoside"]],
      "out": [["name", "GlycosideName"]],
      "steps": [
        ["set", "name.method", ["lit", "functional class nomenclature"]],
        ["set", "name.class_component", ["lit", {"operation": "replace final e with ide", "source": "cyclic monosaccharide name", "examples": {"glucopyranose": "glucopyranoside", "fructofuranose": "fructofuranoside"}}]],
        ["set", "name.leading_word", ["lit", "name of the substituent group in the acetal or ketal function"]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "nonterminal_carbon_substitution",
      "k": "procedure",
      "f": "required",
      "c": [101, 102, 103],
      "in": [["compound", "NonterminalCSubstitutedMonosaccharide"]],
      "out": [["name", "CSubstitutedMonosaccharideName"]],
      "steps": [
        ["set", "name.form", ["lit", "C-substituted monosaccharide"]],
        ["set", "name.configuration_reference_group", ["lit", "the group of higher CIP priority is treated as equivalent to OH"]],
        ["if", ["get", ["var", "compound"], "configuration_is_ambiguous"], [["set", "name.configuration_system", ["lit", "R,S"]]], []],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "nonterminal_hydroxy_replacement",
      "k": "procedure",
      "f": "required",
      "c": [110, 111, 112, 113, 114],
      "in": [["compound", "NonterminalHydroxyReplacementSugar"]],
      "out": [["name", "DeoxySugarDerivativeName"]],
      "steps": [
        ["set", "name.parent_form", ["lit", "substituted derivative of a deoxy sugar"]],
        ["set", "name.configuration_reference", ["lit", "group replacing OH"]],
        ["if", ["get", ["var", "compound"], "configuration_is_ambiguous"], [["set", "name.configuration_system", ["lit", "R,S"]]], []],
        ["if", ["get", ["var", "compound"], "chirality_center_is_twice_substituted"], [["set", "name.configuration_system", ["lit", "R,S required and preferred over high-CIP-equivalent-to-OH treatment"]]], []],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "terminal_carbon_substitution",
      "k": "procedure",
      "f": "preference",
      "c": [125, 126, 127],
      "in": [["compound", "TerminalCSubstitutedCarbohydrate"]],
      "out": [["name", "SubstitutiveCarbohydrateName"]],
      "steps": [
        ["set", "name.new_chirality_center", true],
        ["set", "name.configuration_system", ["lit", "R/S"]],
        ["set", "name.method", ["lit", "substitutive nomenclature"]],
        ["emit", ["var", "name"]]
      ]
    },
    {
      "id": "amino_sugar_n_substitution_methods",
      "k": "procedure",
      "f": "required",
      "c": [136, 137, 138],
      "in": [["sugar", "NSubstitutedAminoSugar"]],
      "out": [["method", "NSubstitutionMethod"]],
      "steps": [
        ["set", "method.general", ["lit", "cite the whole substituted amino group as a prefix"]],
        ["if", ["get", ["var", "sugar"], "has_retained_trivial_name"], [["set", "method.retained_name_alternative", ["lit", "cite substitution with a prefix preceded by italic capital N"]]], []],
        ["emit", ["var", "method"]]
      ]
    },
    {
      "id": "alditol_name_formation",
      "k": "procedure",
      "f": "required",
      "c": [145],
      "in": [["aldose_name", "AldoseName"]],
      "out": [["alditol_name", "AlditolName"]],
      "steps": [
        ["set", "alditol_name.operation", ["lit", {"source": "corresponding aldose name", "replace_ending": "ose", "with": "itol"}]],
        ["emit", ["var", "alditol_name"]]
      ]
    },
    {
      "id": "alditol_parent_selection",
      "k": "procedure",
      "f": "preference",
      "c": [147],
      "in": [["candidate_parents", "AldoseOrKetoseParentSet"]],
      "out": [["parent", "AlditolParent"]],
      "steps": [
        ["set", "parent.selection_basis", ["lit", "P-102.4"]],
        ["set", "parent.applies_when", ["lit", "the alditol can derive from two aldoses or from an aldose and a ketose"]],
        ["emit", ["var", "parent"]]
      ]
    },
    {
      "id": "retained_fucitol_rhamnitol_exception",
      "k": "mapping",
      "f": "required",
      "c": [147],
      "in": [["structure", "AlditolStructure"]],
      "out": [["name", "RetainedAlditolName"]],
      "table": "retained_fucitol_rhamnitol_names"
    },
    {
      "id": "meso_alditol_descriptors",
      "k": "procedure",
      "f": "required",
      "c": [158, 159, 160, 161, 162],
      "in": [["alditol", "AlditolOrDerivative"]],
      "out": [["descriptors", "AlditolStereodescriptors"]],
      "steps": [
        ["if", ["get", ["var", "alditol"], "name_is_erythritol_ribitol_or_galactitol"], [["set", "descriptors.meso", ["lit", "may be included in the preferred name"]]], []],
        ["if", ["get", ["var", "alditol"], "meso_derivative_is_asymmetric_by_substitution"], [["set", "descriptors.D_or_L", ["lit", "required"]]], []],
        ["if", ["get", ["var", "alditol"], "has_more_than_four_contiguous_chirality_centers"], [["set", "descriptors.D_or_L", ["lit", "required"]]], []],
        ["emit", ["var", "descriptors"]]
      ]
    },
    {
      "id": "substituted_alditol_parent_selection",
      "k": "decision",
      "f": "required",
      "c": [170, 171, 175],
      "in": [["candidate_parents", "SubstitutedAlditolParentSet"]],
      "out": [["parent", "SubstitutedAlditolParent"]],
      "candidates": ["var", "candidate_parents"],
      "stages": [
        {"id": "lowest_substituent_locants", "c": [171], "key": ["get", ["var", "candidate"], "substituent_prefix_locant_sequence"], "cmp": ["lexicographic", "minimum", null, null]},
        {"id": "lowest_first_alphabetical_substituent_locant", "c": [175], "key": ["get", ["var", "candidate"], "first_alphanumerically_cited_substituent_locant"], "cmp": ["numeric", "minimum", null, null]}
      ],
      "tie": ["retain_coequal", null]
    },
    {
      "id": "aminoalditol_retained_names",
      "k": "mapping",
      "f": "required",
      "c": [180, 181],
      "in": [["source_amino_sugar", "AminoSugar"]],
      "out": [["name", "AminoalditolName"]],
      "table": "aminoalditol_retained_names"
    },
    {
      "id": "monosaccharide_carboxylic_acid_classes",
      "k": "mapping",
      "f": "definition",
      "c": [192, 194, 196, 198],
      "in": [["oxidation_pattern", "MonosaccharideOxidationPattern"]],
      "out": [["acid_class", "MonosaccharideCarboxylicAcidClass"]],
      "table": "monosaccharide_carboxylic_acid_classes"
    }
  ],
  "exceptions": [
    {
      "id": "fucitol_rhamnitol_retained_name_exception",
      "c": [147],
      "if": ["get", ["var", "candidate_parents"], "correspond_to_fucitol_or_rhamnitol"],
      "target": ["semantic_unit", "alditol_parent_selection"],
      "mode": "replace",
      "replacement": ["semantic_unit", "retained_fucitol_rhamnitol_exception"],
      "order": 147,
      "specificity": 1
    }
  ],
  "tables": [
    {
      "id": "retained_glycosamine_names",
      "c": [3],
      "title": "Retained glycosamine names",
      "cols": [["retained_name", "Retained name", "string"], ["systematic_structure_name", "Systematic structure name", "string"]],
      "rows": [
        {"id": "galactosamine", "v": ["D-galactosamine", "2-amino-2-deoxy-D-galactose"]},
        {"id": "glucosamine", "v": ["D-glucosamine", "2-amino-2-deoxy-D-glucose"]},
        {"id": "mannosamine", "v": ["D-mannosamine", "2-amino-2-deoxy-D-mannose"]},
        {"id": "fucosamine", "v": ["D-fucosamine", "2-amino-2,6-dideoxy-D-galactose"]},
        {"id": "quinovosamine", "v": ["D-quinovosamine", "2-amino-2,6-dideoxy-D-glucose"]},
        {"id": "n_acetyl_galactosamine", "v": ["N-acetyl-D-galactosamine", "2-acetamido-2-deoxy-D-galactopyranose"]}
      ],
      "contract": {"key": ["retained_name"], "result": ["systematic_structure_name"], "cardinality": "one_to_one", "ordering": "source_order"}
    },
    {
      "id": "retained_fucitol_rhamnitol_names",
      "c": [147],
      "title": "Retained alditol-name exceptions",
      "cols": [["systematic_name", "Systematic name", "string"], ["retained_name", "Retained name", "string"]],
      "rows": [
        {"id": "fucitol", "v": ["1-deoxy-D-galactitol", "L-fucitol"]},
        {"id": "rhamnitol", "v": ["1-deoxy-L-mannitol", "L-rhamnitol"]}
      ],
      "contract": {"key": ["systematic_name"], "result": ["retained_name"], "cardinality": "one_to_one", "ordering": "source_order"}
    },
    {
      "id": "aminoalditol_retained_names",
      "c": [180, 181],
      "title": "Retained aminoalditol names",
      "cols": [["source_amino_sugar", "Source amino sugar", "string"], ["retained_aminoalditol", "Retained aminoalditol", "string"]],
      "rows": [
        {"id": "galactosamine", "v": ["galactosamine", "galactosaminitol"]},
        {"id": "glucosamine", "v": ["glucosamine", "glucosaminitol"]}
      ],
      "contract": {"key": ["source_amino_sugar"], "result": ["retained_aminoalditol"], "cardinality": "one_to_one", "ordering": "source_order"}
    },
    {
      "id": "monosaccharide_carboxylic_acid_classes",
      "c": [192, 194, 196, 198],
      "title": "Monosaccharide carboxylic acid classes",
      "cols": [["oxidation_pattern", "Formal oxidation pattern", "string"], ["acid_class", "Acid class", "string"]],
      "rows": [
        {"id": "aldonic", "c": [192], "v": ["aldose aldehydic group oxidized to carboxylic acid", "aldonic acid"]},
        {"id": "ketoaldonic", "c": [194], "v": ["aldonic-acid secondary CHOH oxidized to carbonyl", "ketoaldonic acid"]},
        {"id": "uronic", "c": [196], "v": ["aldose terminal CH2OH oxidized to carboxy", "uronic acid"]},
        {"id": "aldaric", "c": [198], "v": ["both terminal CHO and CH2OH groups oxidized to carboxy", "aldaric acid"]}
      ],
      "contract": {"key": ["oxidation_pattern"], "result": ["acid_class"], "cardinality": "one_to_one", "ordering": "source_order"}
    }
  ],
