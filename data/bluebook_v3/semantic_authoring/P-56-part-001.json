  "units": [
    {
      "id": "historical_suffix_revision_context",
      "k": "definition",
      "f": "definition",
      "c": [2, 3, 4],
      "term": "history of suffix revisions",
      "entity": "SuffixRevisionContext",
      "value": ["lit", {
        "source_text": [
          "Suffixes have always been considered as the most unique elements of the formation of names.",
          "In the past, some suffixes have been discarded and replaced by new ones.",
          "The following suffixes have been introduced or modified in these recommendations."
        ],
        "scope": "suffixes introduced or modified by these recommendations"
      }]
    },
    {
      "id": "peroxol_hydroperoxide_nomenclature",
      "k": "definition",
      "f": "preference",
      "c": [6, 7],
      "term": "peroxol suffix for hydroperoxides",
      "entity": "SuffixRecommendation",
      "value": ["lit", {
        "group": "hydroperoxide",
        "structure": "-OOH",
        "substitutive_suffix": "peroxol",
        "preferred_over": "names generated by functional class nomenclature",
        "recommendation": "use peroxol to provide substitutive names"
      }]
    },
    {
      "id": "chalcogen_peroxol_replacement",
      "k": "definition",
      "f": "required",
      "c": [12, 13],
      "term": "replacement of sulfenic acid suffixes",
      "entity": "ChalcogenPeroxolReplacement",
      "value": ["lit", {
        "discarded_in": "1993 recommendations",
        "discarded_suffixes": ["sulfenic acid", "its chalcogen analogues"],
        "replacement_suffixes": [
          "SO-thioperoxol",
          "SeO-selenoperoxol",
          "dithioperoxol",
          "TeS-tellurothioperoxol",
          "diselenoperoxol",
          "SeTe-selenotelluroperoxol",
          "TeSe-telluroselenoperoxol"
        ],
        "source_text": "These suffixes are replaced by the new suffixes; see P-63.4.2.1."
      }]
    },
    {
      "id": "imidamide_replacement",
      "k": "definition",
      "f": "preference",
      "c": [19, 20],
      "term": "imidamide and carboximidamide replacement suffixes",
      "entity": "FunctionalReplacementSuffix",
      "value": ["lit", {
        "former_suffixes": ["amidine", "carboxamidine"],
        "former_structures": ["-C(=NH)-NH2", "-(C)(=NH)-NH2"],
        "status": "no longer recommended",
        "preferred_replacement_suffixes": ["imidamide", "carboximidamide"],
        "scope": "preferred IUPAC names"
      }]
    },
    {
      "id": "diyl_ylidene_vs_ylene",
      "k": "definition",
      "f": "preference",
      "c": [25, 26, 27, 28, 29, 30],
      "term": "diyl and ylidene endings for divalent substituent groups",
      "entity": "DivalentSubstituentNaming",
      "value": ["lit", {
        "former_ending": "ylene",
        "former_scope": "divalent substituent groups whose free valences do not form a double bond",
        "historical_status": "discarded in 1993 except for methylene, ethylene, and phenylene",
        "single_bond_pattern": "-E- or E<",
        "double_bond_pattern": "E=",
        "replacement_endings": {
          "single_bond": "diyl",
          "double_bond": "ylidene"
        },
        "preferred_examples": {
          "-CH2-CH2-": "ethane-1,2-diyl",
          "H3C-CH=": "ethylidene"
        },
        "retained_exception": {
          "name": "methylene",
          "structure": "-CH2-",
          "preferred_over": "methanediyl"
        },
        "external_usage": "CAS still uses ylene for diyl and ylidene bond types, especially methylene for -CH2- and CH2=."
      }]
    },
    {
      "id": "carbonylbis_azanediyl_prefix",
      "k": "definition",
      "f": "preference",
      "c": [66, 67],
      "term": "carbonylbis(azanediyl) prefix",
      "entity": "MultiplicativePrefixRecommendation",
      "value": ["lit", {
        "structure": "-NH-CO-NH-",
        "preferred_prefix": "carbonylbis(azanediyl)",
        "use": "multiplicative nomenclature",
        "former_or_external_names": ["carbonyldiimino", "ureylene"],
        "external_usage": "carbonyldiimino remains used by CAS",
        "source_reference": "P-66.1.6.1.1.3"
      }]
    }
  ],
