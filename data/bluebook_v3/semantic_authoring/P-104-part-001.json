  "units": [
    {
      "id": "cyclitol_nomenclature_source",
      "k": "definition",
      "f": "definition",
      "c": [4],
      "in": [["subject", "CyclitolNomenclature"]],
      "out": [["source", "SourceDocument"]],
      "term": "cyclitol nomenclature source",
      "entity": "CyclitolNomenclature",
      "value": ["lit", {"source_text": "The nomenclature of cyclitols is described in the document entitled â€˜Nomenclature of Cyclitols, Recommendations 1973â€™ (ref. 39).", "document": "Nomenclature of Cyclitols, Recommendations 1973", "reference": 39}]
    },
    {
      "id": "cyclitol_definition",
      "k": "definition",
      "f": "definition",
      "c": [6],
      "in": [["structure", "Cyclitol"]],
      "out": [["class", "CyclitolClass"]],
      "term": "cyclitol",
      "entity": "Cyclitol",
      "value": ["lit", {"source_text": "Cyclitols are cycloalkanes in which three or more ring atoms are each substituted with one hydroxy group.", "parent": "cycloalkane", "minimum_substituted_ring_atoms": 3, "substituent": "one hydroxy group per substituted ring atom"}]
    },
    {
      "id": "inositol_definition",
      "k": "definition",
      "f": "definition",
      "c": [7],
      "in": [["structure", "Cyclitol"]],
      "out": [["class", "InositolClass"]],
      "term": "inositol",
      "entity": "Inositol",
      "value": ["lit", {"source_text": "Inositols, cyclohexane-1,2,3,4,5,6-hexols, are a specific group of cyclitols.", "systematic_description": "cyclohexane-1,2,3,4,5,6-hexol", "superclass": "cyclitol"}]
    },
    {
      "id": "inositol_retained_names_and_dl_descriptors",
      "k": "definition",
      "f": "definition",
      "c": [8],
      "in": [["compound", "InositolDerivative"]],
      "out": [["configuration_descriptors", "DAndLDescriptors"]],
      "term": "inositol retained-name configuration convention",
      "entity": "InositolDerivative",
      "value": ["lit", {"source_text": "Inositols have retained names and, together with their O-alkyl, O-aryl, alkanoate/carboxylate esters, and amino derivatives (where NH2 replaces OH) employ the stereodescriptors â€˜Dâ€™ and â€˜Lâ€™ to describe configurations.", "retained_names": true, "derivative_classes": ["O-alkyl", "O-aryl", "alkanoate/carboxylate esters", "amino derivatives"], "amino_derivative_operation": "NH2 replaces OH", "configuration_descriptors": ["D", "L"]}]
    },
    {
      "id": "systematic_cyclitol_configuration",
      "k": "definition",
      "f": "definition",
      "c": [9],
      "in": [["compound", "NonInositolCyclitol"]],
      "out": [["naming_method", "SystematicSubstitutiveName"]],
      "term": "systematic cyclitol name",
      "entity": "NonInositolCyclitol",
      "value": ["lit", {"source_text": "Other names of cyclitols are systematic substitutive names whose configurations are described by CIP stereodescriptors.", "name_type": "systematic substitutive", "configuration_descriptors": "CIP stereodescriptors"}]
    },
    {
      "id": "cyclitol_naming_methods",
      "k": "procedure",
      "f": "preference",
      "c": [11],
      "in": [["cyclitol", "Cyclitol"]],
      "out": [["naming_methods", "CyclitolNamingMethods"]],
      "steps": [["emit", ["lit", {"source_text": "Various methods are recommended for naming cyclitols.", "status": "recommended", "subject": "cyclitol naming methods"}]]]
    },
    {
      "id": "absolute_configuration_definition",
      "k": "procedure",
      "f": "required",
      "c": [33],
      "in": [["cyclitol", "Cyclitol"]],
      "out": [["descriptor", "DOrLDescriptor"]],
      "steps": [["emit", ["lit", {"source_text": "The absolute configuration of cyclitols is denoted by â€˜Dâ€™ and â€˜Lâ€™ and is determined in the following way.", "descriptors": ["D", "L"], "determination": "following way"}]]]
    },
    {
      "id": "planar_ring_dl_assignment",
      "k": "procedure",
      "f": "required",
      "c": [34],
      "in": [["ring_representation", "PlanarRingRepresentation"]],
      "out": [["descriptor", "DOrLDescriptor"]],
      "steps": [["emit", ["lit", {"source_text": "For the planar ring representation where the hydroxy group numbered â€˜1â€™ is above the plane of the ring, the configuration â€˜Lâ€™ corresponds to a clockwise numbering, and the configuration â€˜Dâ€™ corresponds to an anticlockwise numbering, as illustrated by the two enantiomeric chiro-inositols above.", "hydroxy_locant": 1, "hydroxy_position": "above the plane of the ring", "clockwise": "L", "anticlockwise": "D", "illustration": "the two enantiomeric chiro-inositols above"}]]]
    },
    {
      "id": "dl_descriptor_placement",
      "k": "procedure",
      "f": "preference",
      "c": [35],
      "in": [["compound", "InositolCompound"]],
      "out": [["rendered_prefix", "StereodescriptorPrefix"]],
      "steps": [["emit", ["lit", {"source_text": "The stereodescriptors â€˜Dâ€™ and â€˜Lâ€™ followed by a hyphen are placed before the name of the compound and are preceded by the locant of the defining center, i.e. â€˜1â€™ as shown above.", "descriptor_forms": ["1D-", "1L-"], "position": "before the compound name", "defining_center_locant": 1}]]]
    },
    {
      "id": "positional_numbering_criteria",
      "k": "procedure",
      "f": "required",
      "c": [46, 47, 48, 49, 50, 51],
      "in": [["stereoisomer", "CyclitolStereoisomer"]],
      "out": [["positional_designation", "FractionalPositionalDesignation"]],
      "steps": [
        ["emit", ["lit", {"order": 1, "criterion": "(a)", "source_text": "(a) to the substituents considered as a numerical series, without regard to configuration;", "basis": "substituents as a numerical series", "ignore": "configuration"}]],
        ["emit", ["lit", {"order": 2, "criterion": "(b)", "source_text": "(b) if one set of the substituents is more numerous than the other, to the more numerous;", "basis": "more numerous set of substituents"}]],
        ["emit", ["lit", {"order": 3, "criterion": "(c)", "source_text": "(c) if the sets are equally numerous and one of them can be denoted by lower numbers, to that set;", "basis": "the set denoted by lower numbers"}]],
        ["emit", ["lit", {"order": 4, "criterion": "(d)", "source_text": "(d) to substituents other than unmodified hydroxy groups;", "basis": "substituents other than unmodified hydroxy groups"}]],
        ["emit", ["lit", {"order": 5, "criterion": "(e)", "source_text": "(e) to the substituent first cited in alphanumerical order;", "basis": "first substituent in alphanumerical order"}]],
        ["emit", ["lit", {"order": 6, "criterion": "(f)", "source_text": "(f) to those designations that lead to an â€˜Lâ€™ rather than a â€˜Dâ€™ configuration, as determined by the method of P-104.2.1 above (applies to meso compounds only).", "basis": "designation leading to L rather than D", "scope": "meso compounds only", "method": "P-104.2.1"}]]
      ]
    },
    {
      "id": "fractional_positional_expression",
      "k": "procedure",
      "f": "required",
      "c": [52],
      "in": [["substituent_sets", "SubstituentSets"]],
      "out": [["positional_expression", "FractionalPositionalExpression"]],
      "steps": [["emit", ["lit", {"source_text": "The positional numbers are described by a fractional expression in which the numerator is the set of substituents with the lowest locants, arranged in ascending order, and the denominator is the other set.", "numerator": "set of substituents with the lowest locants", "numerator_order": "ascending", "denominator": "the other set"}]]]
    },
    {
      "id": "inositol_derivative_general_method",
      "k": "procedure",
      "f": "required",
      "c": [66],
      "in": [["inositol", "Inositol"]],
      "out": [["derivative_naming_method", "CarbohydrateDerivativeMethod"]],
      "steps": [["emit", ["lit", {"source_text": "Inositols are modified in the same way as carbohydrates to generate names for derivatives.", "analogy": "carbohydrates", "application": "generate names for derivatives"}]]]
    },
    {
      "id": "inositol_o_substitution_unlimited",
      "k": "constraint",
      "f": "required",
      "c": [67],
      "in": [["inositol", "InositolDerivative"]],
      "out": [["substitution_scope", "OSubstitutionScope"]],
      "assert": ["lit", true],
      "violation": [["reject", "inositol", "reason.o_substitution_limit"]]
    },
    {
      "id": "inositol_o_substitution_rule",
      "k": "procedure",
      "f": "required",
      "c": [67],
      "in": [["inositol", "InositolDerivative"]],
      "out": [["allowed_operations", "OSubstitutionOperations"]],
      "steps": [["emit", ["lit", {"source_text": "There is no limit to O-substitution by alkyl (aryl) groups (see P-102.5.6.1).", "operation": "O-substitution", "groups": "alkyl (aryl)", "limit": "none", "basis_rule": "P-102.5.6.1"}]]]
    },
    {
      "id": "inositol_deoxy_amino_exchange",
      "k": "procedure",
      "f": "permitted",
      "c": [68],
      "in": [["inositol", "InositolDerivative"]],
      "out": [["amino_derivative", "AminoInositolDerivative"]],
      "steps": [["emit", ["lit", {"source_text": "Hydroxy groups can be exchanged for amino groups using the â€˜deoxyâ€™ operation (see P-102.5.4).", "from": "hydroxy group", "to": "amino group", "operation": "deoxy", "basis_rule": "P-102.5.4"}]]]
    },
    {
      "id": "senior_characteristic_group_substitutive_naming",
      "k": "procedure",
      "f": "required",
      "c": [69],
      "in": [["derivative", "InositolDerivativeWithSeniorGroup"]],
      "out": [["name_method", "FullySubstitutiveName"]],
      "steps": [["emit", ["lit", {"source_text": "When characteristic groups that are senior to hydroxy groups are put in the place of a hydroxy group, fully substitutive names must be constructed.", "condition": "characteristic group senior to hydroxy", "replacement_site": "hydroxy group", "required_method": "fully substitutive name"}]]]
    },
    {
      "id": "inositol_ester_naming",
      "k": "procedure",
      "f": "required",
      "c": [70],
      "in": [["derivative", "InositolEster"]],
      "out": [["name_method", "AlkanoateOrCarboxylateName"]],
      "steps": [["emit", ["lit", {"source_text": "However, esters are named as alkanoates/carboxylates.", "exception": true, "ester_name_type": ["alkanoate", "carboxylate"]}]]]
    },
    {
      "id": "inositol_numbering_and_configuration",
      "k": "procedure",
      "f": "required",
      "c": [71],
      "in": [["derivative", "InositolDerivative"]],
      "out": [["numbering_and_configuration", "InositolNumberingConfiguration"]],
      "steps": [["emit", ["lit", {"source_text": "The numbering of the inositol remains unchanged and the configuration is expressed by an â€˜Lâ€™ or â€˜Dâ€™ stereodescriptor.", "numbering": "unchanged from the inositol", "configuration": ["L", "D"]}]]]
    },
    {
      "id": "systematic_derivative_numbering",
      "k": "procedure",
      "f": "permitted",
      "c": [72],
      "in": [["derivative", "InositolDerivative"]],
      "out": [["systematic_numbering", "SystematicDerivativeNumbering"]],
      "steps": [["emit", ["lit", {"source_text": "Systematic names may have different numbering from the corresponding inositol name (see examples 2 and 5).", "numbering_relation": "may differ from corresponding inositol name", "examples": [2, 5]}]]]
    },
    {
      "id": "non_inositol_derivative_substitutive_method",
      "k": "procedure",
      "f": "required",
      "c": [88],
      "in": [["derivative", "NonInositolCyclitolDerivative"]],
      "out": [["name_method", "SubstitutiveNomenclature"]],
      "steps": [["emit", ["lit", {"source_text": "Names for derivatives of cyclitols other than inositols are all constructed by applying the principles, rules, and conventions of substitutive nomenclature described in Chapters P-1 through P-9.", "scope": "derivatives of cyclitols other than inositols", "method": "substitutive nomenclature", "chapters": ["P-1", "P-2", "P-3", "P-4", "P-5", "P-6", "P-7", "P-8", "P-9"]}]]]
    }
  ],
