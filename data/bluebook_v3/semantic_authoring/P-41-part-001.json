      "term": "functional compound class seniority and naming constraints",
      "entity": "FunctionalCompoundClassRules",
      "value": ["lit", {
        "anhydrides": {"cyclic": "use substitutive nomenclature when named as heterocycles", "acyclic": "use functional class names", "retained_acid_cyclic_cases": "some cyclic anhydrides may use functional class names", "functional_name_preference": "prefer cyclic over noncyclic anhydrides"},
        "esters": {"noncyclic": "use functional class names", "cyclic": "name lactones and other cyclic esters as heterocycles"},
        "acid_halides_and_pseudohalides": {"primary_order": "corresponding acid", "halogen_order": ["-F", "-Cl", "-Br", "-I"], "pseudohalogen_order": ["-N3", "-CN", "-NC", "-NCO", "-NCS", "-NCSe", "-NCTe", "-CNO"]},
        "amides": {"order": "corresponding acids", "cyclic": "name as heterocycles"},
        "hydrazides": {"order": "corresponding acids"},
        "imides": {"scope": "only cyclic imides derived from organic dibasic or polybasic acids having retained names"},
        "nitriles": {"class": "nitriles"},
        "aldehydes": {"class": "aldehydes and chalcogen analogues"},
        "ketones": {"structure": "-C-CO-C-", "pseudoketones": ["-C-CO-X", "X-CO-X", "-CO-X-CO-"], "pseudoketone_X": "X is not C, a halogen, a pseudohalogen, or NH2", "heterones": "included", "references": ["P-64.1.2", "P-64.4"], "related_classes": ["8 lactones and anhydrides", "9 esters", "11 lactams and amides", "13 imides"]},
        "hydroxy_compounds": {"includes": ["alcohols", "phenols", "chalcogen analogues"], "separate_alcohol_or_phenol_ranking": false},
        "hydroperoxides": {"synonym": "peroxols", "structure": "-OOH"},
