    {
      "id": "acid_seniority_rules",
      "k": "definition",
      "f": "required",
      "c": [11, 12, 13, 14, 15, 16, 17, 18, 19],
      "scope": {"r": ["general_nomenclature"], "if": ["lit", true]},
      "in": [["acid", "AcidOrAcidDerivative"]],
      "out": [["acid_class", "AcidClass"]],
      "term": "seniority order of acid classes",
      "entity": "AcidClassSeniority",
      "value": ["lit", {
        "class": "7",
        "subclasses": [
          {
            "rank": "7a",
            "scope": "suffix acids",
            "suffix_order": ["carboxylic", "sulfonic", "sulfinic", "selenonic", "seleninic", "telluronic", "tellurinic"],
            "exclusion": "carbonic and polycarbonic acids belong to subclass 7b",
            "after_each_suffix": ["corresponding peroxy acids", "corresponding imidic acids", "corresponding hydrazonic acids"],
            "chalcogen_analogue_order": {"follows": "each corresponding oxygen acid", "preferred_chalcogen_order": ["O", "S", "Se", "Te"], "comparison": "use the analogue with the greater number of the preferred chalcogen atom; consider -OOH groups first, then -OH groups as necessary"}
          },
          {"rank": "7b", "scope": "carbon acids with no substitutable hydrogen atoms", "order": ["polynuclear carbonic acids: tricarbonic acid", "polynuclear carbonic acids: dicarbonic acid", "carbonic acid", "cyanic acid"]},
          {"rank": "7c", "scope": "oxoacids with substitutable hydrogen atoms attached to their central atoms and their acidic derivatives", "order": ["azonic", "azinic", "phosphonic", "phosphinic", "phosphonous", "phosphinous", "etc."]},
          {"rank": "7d", "scope": "mononuclear and polynuclear oxoacids other than carbon acids without substitutable hydrogen atoms attached to the central atom, when they may be functionalized or form derivatives by functional replacement with substitutable hydrogen atoms", "reference": "subclass 7b is excluded"},
          {"rank": "7e", "scope": "other monobasic oxoacids used as functional parent compounds"}
        ],
        "complete_list_references": ["P-42", "P-43", "Table 4.4"]
      }]
    },
    {
      "id": "functional_class_naming_rules",
      "k": "definition",
