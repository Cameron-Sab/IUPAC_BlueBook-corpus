      "if": ["lit", true],
      "then": [["set", "recommendation", ["lit", {"not_recommended_in_place_of": [{"retained": "methanediyl", "preferred": "methylene"}, {"retained": "benzene-1,2-diyl", "preferred": "1,2-phenylene"}, {"retained": "trimethylene", "preferred": null}, {"retained": "tetramethylene", "preferred": null}], "scope": "these recommendations"}]]],
      "else": []
