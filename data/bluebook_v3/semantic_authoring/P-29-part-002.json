      "term": "scope of retained-prefix recommendations",
      "entity": "RetainedPrefixSectionScope",
      "value": ["lit", {"subject": "simple substituent groups derived from parent hydrides with retained names", "aspects": ["preferred retained prefixes", "retained prefixes not used as preferred prefixes", "retained prefixes no longer recommended as approved prefixes"]}]
    },
