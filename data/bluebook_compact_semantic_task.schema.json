{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cameron-Sab/IUPAC_BlueBook-corpus/data/bluebook_compact_semantic_task.schema.json",
  "title": "IUPAC Blue Book compact semantic conversion task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "task_id",
    "source_hashes",
    "assigned_rule_ids",
    "rules",
    "corrections",
    "metrics",
    "task_sha256"
  ],
  "properties": {
    "format": { "const": "iupac-bluebook-compact-semantic-task" },
    "format_version": { "const": "1.0.0" },
    "task_id": { "type": "string", "pattern": "^P-[0-9]+-part-[0-9]{3}$" },
    "source_hashes": { "$ref": "#/$defs/source_hashes" },
    "assigned_rule_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rule_id" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/rule" }
    },
    "corrections": {
      "type": "array",
      "items": { "$ref": "#/$defs/correction" }
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "task_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "rule_id": {
      "type": "string",
      "pattern": "^P-[0-9]+(?:\\.[0-9]+)*(?:\\([a-z0-9]+\\))?$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^(?:P-[0-9]+(?:\\.[0-9]+)*(?:\\([a-z0-9]+\\))?|chapter:P-(?:10|[1-9]))$"
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_corpus_sha256",
        "document_nodes_sha256",
        "correction_overlays_sha256",
        "clause_inventory_sha256",
        "reference_occurrences_sha256",
        "reference_resolutions_sha256"
      ],
      "properties": {
        "source_corpus_sha256": { "$ref": "#/$defs/sha256" },
        "document_nodes_sha256": { "$ref": "#/$defs/sha256" },
        "correction_overlays_sha256": { "$ref": "#/$defs/sha256" },
        "clause_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "reference_occurrences_sha256": { "$ref": "#/$defs/sha256" },
        "reference_resolutions_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "record_id",
        "record_sha256",
        "chapter",
        "immediate_parent",
        "preceding_rule_ids",
        "following_rule_ids",
        "source_units",
        "references",
        "correction_overlay_ids"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/rule_id" },
        "record_id": { "type": "string", "minLength": 1 },
        "record_sha256": { "$ref": "#/$defs/sha256" },
        "chapter": { "type": "string", "pattern": "^P-(?:10|[1-9])$" },
        "immediate_parent": { "$ref": "#/$defs/target_id" },
        "preceding_rule_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rule_id" }
        },
        "following_rule_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rule_id" }
        },
        "source_units": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_unit" }
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "correction_overlay_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^BBV3-CORR-[A-F0-9]{16}$" }
        }
      }
    },
    "source_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clause_id",
        "ordinal",
        "unit_kind",
        "node_kind",
        "ancestor_node_kinds",
        "semantic_cue",
        "text",
        "text_sha256",
        "payload",
        "payload_sha256",
        "source_node_id"
      ],
      "properties": {
        "clause_id": { "type": "string", "pattern": "^P-[^:]+:clause:[0-9]{4,}$" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "unit_kind": { "type": "string", "minLength": 1 },
        "node_kind": { "type": "string", "minLength": 1 },
        "ancestor_node_kinds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "semantic_cue": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "text_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "payload": { "type": ["object", "null"] },
        "payload_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "source_node_id": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_id",
        "reference_kind",
        "reference_text",
        "cited_rule_id",
        "raw_target_rule_id",
        "effective_target_rule_id",
        "effective_target_kind",
        "resolution_id",
        "resolution_kind",
        "correction_overlay_id",
        "context_text",
        "context_sha256"
      ],
      "properties": {
        "occurrence_id": {
          "type": "string",
          "pattern": "^P-[^:]+:xref:[0-9]{4,}$"
        },
        "reference_kind": { "type": "string", "enum": ["href", "text"] },
        "reference_text": { "type": "string", "minLength": 1 },
        "cited_rule_id": {
          "oneOf": [{ "$ref": "#/$defs/rule_id" }, { "type": "null" }]
        },
        "raw_target_rule_id": { "$ref": "#/$defs/rule_id" },
        "effective_target_rule_id": { "$ref": "#/$defs/rule_id" },
        "effective_target_kind": {
          "type": "string",
          "enum": ["rule", "historical_rule", "external_or_historical"]
        },
        "resolution_id": {
          "type": ["string", "null"],
          "pattern": "^BBV3-XREF-RES-[0-9]{4}$"
        },
        "resolution_kind": {
          "type": ["string", "null"],
          "enum": ["source_alias", "historical_deleted_rule", null]
        },
        "correction_overlay_id": {
          "type": ["string", "null"],
          "pattern": "^BBV3-CORR-[A-F0-9]{16}$"
        },
        "context_text": { "type": "string", "minLength": 1 },
        "context_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_id", "effective_date", "status", "operations"],
      "properties": {
        "overlay_id": { "type": "string", "pattern": "^BBV3-CORR-[A-F0-9]{16}$" },
        "effective_date": { "type": "string", "format": "date" },
        "status": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation_id", "kind", "before_text", "after_text", "source_text", "assets"],
            "properties": {
              "operation_id": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "before_text": { "type": ["string", "null"] },
              "after_text": { "type": ["string", "null"] },
              "source_text": { "type": "string", "minLength": 1 },
              "assets": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_count", "clause_count", "reference_count", "correction_count"],
      "properties": {
        "rule_count": { "type": "integer", "minimum": 1 },
        "clause_count": { "type": "integer", "minimum": 1 },
        "reference_count": { "type": "integer", "minimum": 0 },
        "correction_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
